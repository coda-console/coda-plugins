{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/plugin/v1/events.json",
  "title": "contributes.events：插件发布的事件",
  "description": "流程订阅的事件名；starts（默认开）是否开始订阅它的流程，否则只送到在跑的运行；ends 是否结束它的主体（如 PR 关闭）。",
  "type": "array",
  "maxItems": 50,
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "description": "事件名是「<域>.<名>」：小写字母、数字和「_」，以字母开头，不超过 100 个字符；域不能是 Coda 自己的 workflow、session、user",
        "type": "string",
        "pattern": "^(?!(workflow|session|user)\\.)(?=.{3,100}$)[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      },
      "starts": {"type": "boolean"},
      "ends": {"type": "boolean"}
    },
    "required": ["name"],
    "additionalProperties": false
  },
  "x-unique-by": ["name"]
}
