{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/plugin/v1/extension-points.json",
  "title": "contributes.extensionPoints：插件声明的扩展点",
  "description": "扩展点名 → 声明。只写 description 的，别的插件用 contributes.extensions 接一条命令；写了 contributes 的，任何插件在它的 contributes 里用这个键写的东西归它，原样交给声明它的插件读。",
  "type": "object",
  "propertyNames": {"$ref": "common.json#/$defs/id"},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "description": {"$ref": "common.json#/$defs/line200"},
      "contributes": {
        "description": "别的插件在 contributes 里用的键：字母和数字，以小写字母开头，不能是 Coda 自己的类型",
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]{0,39}$",
        "not": {
          "enum": [
            "configuration",
            "capabilities",
            "instructions",
            "agents",
            "extensionPoints",
            "extensions",
            "groups",
            "events",
            "commands",
            "gitCredentials",
            "repositories",
            "services",
            "setup",
            "skills",
            "environment",
            "path",
            "endpoints",
            "mcpServers",
            "views",
            "modelProviders",
            "executors",
            "composerModes"
          ]
        }
      },
      "title": {"$ref": "common.json#/$defs/line20"},
      "commands": {
        "description": "每样东西里哪里是命令（以「.」连接的键名或「*」）→ 安装确认里怎么叫它（不超过 40 字）",
        "type": "object",
        "propertyNames": {"pattern": "^(\\*|[A-Za-z][A-Za-z0-9]{0,39})(\\.(\\*|[A-Za-z][A-Za-z0-9]{0,39})){0,7}$"},
        "additionalProperties": {"$ref": "common.json#/$defs/line40"}
      }
    },
    "required": ["description"],
    "additionalProperties": false,
    "if": {"required": ["contributes"]},
    "then": {"description": "写了 contributes 的扩展点也写 title", "required": ["title"]},
    "else": {"description": "只有写了 contributes 的扩展点才写 title 与 commands", "not": {"anyOf": [{"required": ["title"]}, {"required": ["commands"]}]}}
  }
}
