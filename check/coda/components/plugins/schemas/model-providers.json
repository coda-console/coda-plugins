{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/plugin/v1/model-providers.json",
  "title": "contributes.modelProviders：插件提供的模型服务",
  "description": "别的插件用 coda-model-provider 的设置按「插件/id」选它：叫什么、讲哪种接口、在哪（地址里可以写本插件的单值设置 ${config:…}）、Key 是本插件的哪个密文。",
  "type": "array",
  "maxItems": 10,
  "items": {
    "type": "object",
    "properties": {
      "id": {"$ref": "common.json#/$defs/id"},
      "title": {"$ref": "common.json#/$defs/line40"},
      "api": {
        "description": "接口：openai-completions、openai-responses、anthropic-messages",
        "enum": ["openai-completions", "openai-responses", "anthropic-messages"]
      },
      "url": {
        "description": "一行地址，只能引用本插件的单值设置（${config:<设置名>}，不能是密文）",
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\u0000\\r\\n]+$",
        "x-placeholders": {"config": {"properties": {"type": {"enum": ["string", "number", "integer"]}, "writeOnly": {"const": false}}, "required": ["type"]}}
      },
      "key": {
        "description": "key 是 ${config:<本插件的密文设置>}",
        "type": "string",
        "pattern": "^\\$\\{config:[^}]+\\}$",
        "x-ref": {
          "pointer": "/contributes/configuration/properties",
          "part": "^\\$\\{config:([^}]+)\\}$",
          "match": {"properties": {"writeOnly": {"const": true}}, "required": ["writeOnly"]}
        }
      }
    },
    "required": ["id", "title", "api", "url"],
    "additionalProperties": false
  },
  "x-unique-by": ["id"]
}
