{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/plugin/v1/git-credentials.json",
  "title": "contributes.gitCredentials：为一个 https 主机回答 Git 凭据",
  "description": "url 是 https:// 加小写主机名（可带端口，不带路径）；command 作为 Git 的凭据助手运行。只有 Coda 自带的插件装得上（安装时的规则）。",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "url": {"description": "https:// 加小写主机名（可带端口，不带路径）", "type": "string", "pattern": "^https://[a-z0-9.-]+(:\\d+)?$"},
      "command": {"$ref": "common.json#/$defs/command"}
    },
    "required": ["url", "command"],
    "additionalProperties": false
  },
  "x-unique-by": ["url"]
}
