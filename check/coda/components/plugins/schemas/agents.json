{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/plugin/v1/agents.json",
  "title": "contributes.agents：插件带来的 Agent",
  "description": "每个是一个讲 ACP（加 Coda 的等待项）的程序：它是谁、客户端怎么画它、Coda 怎么启动它。",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {"$ref": "common.json#/$defs/id"},
      "displayName": {"$ref": "common.json#/$defs/line40"},
      "icon": {
        "description": "图标：light（必填）与 dark 是插件目录里的 PDF，各不超过 32 KiB；template 是开或关",
        "type": "object",
        "properties": {"light": {"$ref": "#/$defs/icon"}, "dark": {"$ref": "#/$defs/icon"}, "template": {"type": "boolean"}},
        "required": ["light"],
        "additionalProperties": false
      },
      "command": {"$ref": "common.json#/$defs/command"},
      "modes": {
        "description": "审批档位的说法：title 不超过 10 字，unset 不超过 20 字，note 不超过 100 字，auto、full 各不超过 200 字",
        "type": "object",
        "properties": {
          "title": {"$ref": "common.json#/$defs/line10"},
          "unset": {"$ref": "common.json#/$defs/line20"},
          "note": {"$ref": "common.json#/$defs/line100"},
          "auto": {"$ref": "common.json#/$defs/line200"},
          "full": {"$ref": "common.json#/$defs/line200"}
        },
        "additionalProperties": false
      },
      "skillsDir": {
        "description": "Agent 读 Skill 的目录：工作区里不离开它的相对路径，至多 3 段",
        "allOf": [{"$ref": "common.json#/$defs/line1000"}, {"pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))"}, {"pattern": "^[^/]+(/+[^/]+){0,2}/*$"}]
      },
      "configFiles": {"description": "Agent 读模型的配置文件，至多 16 个", "type": "array", "maxItems": 16, "items": {"$ref": "common.json#/$defs/line1000"}},
      "setupHint": {"$ref": "common.json#/$defs/line200"}
    },
    "required": ["id", "displayName", "icon", "command"],
    "additionalProperties": false
  },
  "x-unique-by": ["id"],
  "$defs": {
    "icon": {
      "description": "插件目录里的 PDF，不超过 32 KiB",
      "allOf": [{"$ref": "common.json#/$defs/line1000"}],
      "x-file": {"type": "file", "maxBytes": 32768, "magic": "%PDF-"}
    }
  }
}
