{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/plugin/v1/skills.json",
  "title": "contributes.skills：插件带来的 Agent Skill",
  "description": "插件目录里的目录，每个有自己的 SKILL.md；Agent 按目录名找到它，所以目录名不重复。",
  "type": "array",
  "maxItems": 100,
  "items": {
    "description": "插件目录里的相对路径，目录名只用字母、数字、「.」「_」「-」，里面有 SKILL.md",
    "type": "string",
    "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))(?!\\.?/*$)(.*/)?[A-Za-z0-9][A-Za-z0-9._-]{0,63}/*$",
    "x-file": {"type": "directory", "contains": "SKILL.md"}
  },
  "x-unique-by": [{"part": "([^/]+)/*$"}]
}
