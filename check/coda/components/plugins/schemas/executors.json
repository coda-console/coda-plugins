{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/plugin/v1/executors.json",
  "title": "contributes.executors：给这台机器脚本步骤的执行环境",
  "description": "照 GitHub 的 container hooks：叫什么、有哪些标签（coda:runsOn 那样写），以及 hook——步骤的执行器为作业的每一部分调用的一行命令。",
  "type": "array",
  "maxItems": 10,
  "items": {
    "type": "object",
    "properties": {
      "id": {"$ref": "common.json#/$defs/id"},
      "title": {"$ref": "common.json#/$defs/line40"},
      "labels": {
        "description": "1–10 个标签（小写字母、数字与 . _ -），数组或逗号分隔，如 linux,x64",
        "oneOf": [
          {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "pattern": "^\\s*[a-z0-9][a-z0-9._-]{0,39}\\s*$"}},
          {"type": "string", "pattern": "^\\s*[a-z0-9][a-z0-9._-]{0,39}\\s*(,\\s*[a-z0-9][a-z0-9._-]{0,39}\\s*){0,9}$"}
        ]
      },
      "command": {"$ref": "common.json#/$defs/command"}
    },
    "required": ["id", "title", "labels", "command"],
    "additionalProperties": false
  },
  "x-unique-by": ["id"]
}
