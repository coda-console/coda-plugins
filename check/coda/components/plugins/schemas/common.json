{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/plugin/v1/common.json",
  "title": "插件清单里共用的写法",
  "$defs": {
    "id": {"description": "小写字母、数字和「-」，以字母开头，至多 40 个字符", "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"},
    "name": {"description": "小写字母、数字和「-」，以字母开头，至多 64 个字符", "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "line10": {"description": "不超过 10 字的一行", "type": "string", "maxLength": 10, "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]*$"},
    "line20": {"description": "不超过 20 字的一行", "type": "string", "maxLength": 20, "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]*$"},
    "line40": {"description": "不超过 40 字的一行", "type": "string", "maxLength": 40, "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]*$"},
    "line100": {"description": "不超过 100 字的一行", "type": "string", "maxLength": 100, "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]*$"},
    "line200": {"description": "不超过 200 字的一行", "type": "string", "maxLength": 200, "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]*$"},
    "line1000": {"description": "不超过 1000 字的一行", "type": "string", "maxLength": 1000, "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]*$"},
    "line4096": {"description": "不超过 4096 字的一行", "type": "string", "maxLength": 4096, "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]*$"},
    "command": {"description": "一行命令，由 sh 运行，不超过 4000 字", "type": "string", "maxLength": 4000, "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]*$"},
    "symbol": {"description": "SF Symbol 的名字", "type": "string", "maxLength": 100, "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$"},
    "commandHolder": {
      "description": "{ command }：command 是一行命令",
      "type": "object",
      "properties": {"command": {"$ref": "#/$defs/command"}},
      "required": ["command"],
      "additionalProperties": false
    }
  }
}
