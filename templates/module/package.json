{
  "name": "notes",
  "displayName": "便条（模板）",
  "description": "带模块的插件模板：自己的协议 notes/note@1（一个查询、一个做事的操作、一个事件），模块登记操作、写记录、发布并订阅事件，附测试。",
  "version": "1.0.0",
  "categories": ["工作流程"],
  "main": "main.mjs",
  "engines": { "coda": 3 },
  "uses": { "notes/note@1": ["watch"] },
  "scripts": { "test": "node --test" },
  "devDependencies": { "@coda-console/plugin-check": "0.8.25" },
  "contributes": {
    "protocols": [
      {
        "name": "notes/note@1",
        "title": "便条",
        "description": "一条便条：标题与正文。",
        "spec": {
          "type": "object",
          "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 100 }, "body": { "type": "string", "maxLength": 10000 } },
          "required": ["title", "body"],
          "additionalProperties": false
        },
        "status": { "type": "object", "properties": {}, "additionalProperties": false },
        "operations": {
          "find": {
            "safe": true,
            "description": "按标题里含的字查便条，不写就是全部；seen 是模块这次启动以来收到的 note_notes.added 事件数。",
            "input": { "type": "object", "properties": { "query": { "type": "string" } }, "additionalProperties": false },
            "result": {
              "type": "object",
              "properties": {
                "seen": { "type": "integer", "minimum": 0 },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": { "key": { "type": "string" }, "title": { "type": "string" } },
                    "required": ["key", "title"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["notes", "seen"],
              "additionalProperties": false
            }
          },
          "add": {
            "description": "记一条便条（同标题是同一条），先写入，写入成功后才发布 note_notes.added；每次调用都发一条事件，同标题再记也发。发布失败时调用不失败（便条已存下）：结果里 notified 为 false，reason 写原因。标题与正文的长度在输入里限住，超了在写入前就拒绝；project 是事件发布在哪个项目。",
            "input": {
              "type": "object",
              "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 100 }, "body": { "type": "string", "maxLength": 10000 }, "project": { "type": "string", "minLength": 1 } },
              "required": ["title", "body", "project"],
              "additionalProperties": false
            },
            "result": {
              "type": "object",
              "properties": { "key": { "type": "string" }, "notified": { "type": "boolean" }, "reason": { "type": "string" } },
              "required": ["key", "notified"],
              "additionalProperties": false
            }
          }
        },
        "events": {
          "note_notes.added": {
            "description": "记了一条便条。",
            "payload": {
              "type": "object",
              "properties": { "key": { "type": "string" }, "title": { "type": "string" }, "body": { "type": "string" } },
              "required": ["key", "title", "body"],
              "additionalProperties": false
            }
          }
        },
        "permissions": { "watch": { "title": "订阅便条事件", "events": ["note_notes.added"] } }
      }
    ],
    "protocolImplementations": ["notes/note@1"]
  }
}
