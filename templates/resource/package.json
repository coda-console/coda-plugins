{
  "name": "uptime",
  "displayName": "运行时间（模板）",
  "description": "最小的资源插件模板",
  "version": "1.0.0",
  "engines": {
    "coda": 6
  },
  "contributes": {
    "protocolImplementations": [
      {
        "kind": "coda/resource@1",
        "commands": {
          "act": "scripts/act.mjs"
        }
      }
    ],
    "records": [
      {
        "kind": "coda/resource@1",
        "command": "scripts/resource.mjs"
      }
    ]
  }
}
