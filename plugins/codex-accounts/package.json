{
  "name": "codex-accounts",
  "displayName": "Codex 多账号",
  "description": "在 Coda 内管理 Codex 账号：自动纳入已有登录，添加与移除账号、自动续期、查看额度和使用完全重置；接管 Codex 额度面板，所选账号在会话开始和两轮之间生效。",
  "version": "2.1.0",
  "extensionDependencies": [
    "codex"
  ],
  "contributes": {
    "extensions": {
      "codex/account-source": {
        "command": "exec node \"$CODA_PLUGIN_PATH/scripts/source.mjs\""
      }
    },
    "panels": [
      {
        "id": "accounts",
        "title": "Codex 多账号",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/panel.mjs\"",
        "maxAge": "PT5M",
        "actions": {
          "select": {
            "command": "node \"$CODA_PLUGIN_PATH/scripts/select.mjs\""
          },
          "reset": {
            "command": "node \"$CODA_PLUGIN_PATH/scripts/reset.mjs\"",
            "confirm": "使用一次完全重置？\n用最早到期的那一次。成功后消耗 1 次，无法撤销。"
          },
          "remove": {
            "command": "node \"$CODA_PLUGIN_PATH/scripts/remove.mjs\"",
            "confirm": "移除此账号在插件中保存的登录？之后需要重新登录才能再次使用。"
          }
        },
        "signIn": {
          "command": "NO_COLOR=1 exec node \"$CODA_PLUGIN_PATH/scripts/login.mjs\"",
          "note": "登录其他账号即可添加；登录已有账号会更新其凭据。首个账号会自动选用，之后可在面板切换。"
        }
      }
    ]
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
