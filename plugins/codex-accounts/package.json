{
  "name": "@coda-console/codex-accounts",
  "id": "codex-accounts",
  "displayName": "Codex 多账号",
  "description": "管理多个 Codex 账号与额度",
  "icon": { "symbol": "person.2.fill", "color": "teal" },
  "version": "2.4.1",
  "engines": {
    "coda": 6
  },
  "categories": ["模型与账号"],
  "extensionDependencies": [
    "codex"
  ],
  "contributes": {
    "extensions": {
      "codex/account-source": {
        "command": "exec node \"$CODA_PLUGIN_PATH/scripts/source.mjs\""
      }
    },
    "protocolImplementations": [
      {
        "kind": "coda/resource@1",
        "commands": {
          "act": "scripts/act.mjs",
          "sign-in": "scripts/sign-in.mjs"
        }
      }
    ],
    "records": [
      {
        "kind": "coda/resource@1",
        "command": "scripts/resource.mjs"
      }
    ]
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/codex-accounts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "scripts"
  ]
}
