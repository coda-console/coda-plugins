{
  "name": "@coda-console/grok-bot",
  "id": "grok-bot",
  "displayName": "Grok Bot",
  "description": "把 Grok Bot 主会话接进 Coda",
  "version": "0.9.1",
  "coda": {
    "channels": [
      "preview"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24",
    "coda": 6
  },
  "categories": [
    "Agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/grok-bot"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "main.mjs",
    "lib",
    "scripts",
    "icons"
  ],
  "contributes": {
    "protocolImplementations": [
      "coda/session@1",
      {
        "kind": "coda/resource@1",
        "commands": {
          "sign-in": "scripts/sign-in.mjs"
        }
      }
    ],
    "records": [
      {
        "kind": "coda/resource@1",
        "command": "scripts/resource.mjs"
      }
    ]
  },
  "main": "main.mjs",
  "activationEvents": [
    "onStartupFinished"
  ]
}
