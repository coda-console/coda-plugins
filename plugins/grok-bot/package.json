{
  "name": "@coda-console/grok-bot",
  "id": "grok-bot",
  "displayName": "Grok Bot",
  "description": "通过 Grok Bot 原生主会话接入 Coda，镜像回复与 Routine 运行记录。",
  "version": "0.2.1",
  "coda": {
    "channels": ["preview"]
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "categories": [
    "Agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/grok-bot"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "remote",
    "icons"
  ],
  "contributes": {
    "agents": [
      {
        "id": "grok-bot",
        "displayName": "Grok Bot",
        "icon": {
          "light": "icons/grok.pdf",
          "template": true
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "setupHint": "发送 /login 完成官方登录，选择 Bot；发送 /bind 安装可选 Coda 数据工具。手机登录可能需要点 Continue。"
      }
    ],
    "configuration": {
      "title": "Grok Bot",
      "properties": {
        "grok-bot.telemetry": {
          "title": "遥测看板地址",
          "description": "可选的遥测看板 HTTP(S) 基地址。未配置时遥测工具明确报错。",
          "type": "string"
        },
        "grok-bot.turnTimeout": {
          "title": "本轮等待上限",
          "description": "等待 Bot 完成本轮的最长时间（ISO 8601 周、日、时、分、秒，须大于零且不超过 24 天）。超时结束 Coda 轮次，云端未必停下。",
          "type": "string",
          "format": "duration",
          "default": "PT30M"
        }
      }
    }
  }
}
