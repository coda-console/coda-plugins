{
  "name": "@coda-console/grok-bot",
  "id": "grok-bot",
  "displayName": "Grok Bot",
  "description": "把 Grok Bot 主会话接进 Coda",
  "version": "0.5.0",
  "coda": {
    "channels": [
      "preview"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "categories": [
    "Agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/grok-bot"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "main.mjs",
    "lib",
    "scripts",
    "remote",
    "icons",
    "view"
  ],
  "contributes": {
    "protocolImplementations": [
      "coda/session@1",
      "coda/run@1"
    ],
    "resources": [
      {
        "id": "account",
        "title": "Grok Bot",
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/resources.mjs\"",
        "maxAge": "PT1M",
        "signIn": {
          "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/login.mjs\"",
          "note": "打开官方登录链接确认；手机可能需要点 Continue。"
        }
      }
    ],
    "views": [
      {
        "id": "bind",
        "title": "绑定 Grok Bot",
        "entry": "view/bind.html",
        "in": [
          "page"
        ],
        "frame": "document"
      }
    ]
  },
  "main": "main.mjs",
  "activationEvents": [
    "onStartupFinished"
  ]
}
