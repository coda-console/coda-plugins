{
  "name": "@coda-console/codex",
  "id": "codex",
  "displayName": "Codex",
  "description": "用 OpenAI Codex 跑会话",
  "version": "2.3.0",
  "engines": {
    "coda": 6
  },
  "categories": [
    "Agent"
  ],
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.12.0",
    "@openai/codex": "0.169.0",
    "proper-lockfile": "4.1.2"
  },
  "overrides": {
    "@agentclientprotocol/codex-acp": {
      "@openai/codex": "$@openai/codex"
    }
  },
  "contributes": {
    "agents": [
      {
        "id": "codex",
        "displayName": "Codex",
        "icon": {
          "light": "icons/openai.pdf",
          "template": true
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "审批模式",
          "unset": "Agent 默认",
          "note": "未选择时为完全访问。",
          "auto": "agent",
          "full": "agent-full-access"
        },
        "skillsDir": ".agents/skills",
        "configFiles": [
          "${CODEX_HOME:-~/.codex}/config.toml",
          ".codex/config.toml"
        ],
        "setupHint": "请在运行机为后端所属账号完成 Codex 认证。"
      }
    ],
    "configuration": {
      "title": "Codex",
      "properties": {
        "codex.modelProviders": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "coda-model-provider",
            "modelApis": [
              "openai-responses"
            ]
          },
          "title": "模型服务",
          "order": 1,
          "description": "勾选插件提供的模型服务（如 Magpie），每个服务各成一组，它列出的模型和 Codex 自己的模型一起出现在会话的模型里；选中哪个服务的模型，那个会话就走那个服务，Codex 自己的模型照旧。只列 OpenAI Responses 接口（openai-responses）的服务：Codex 不再支持 Chat Completions。"
        },
        "codex.multipleAccounts": {
          "type": "boolean",
          "title": "多账号",
          "order": 2,
          "default": false,
          "description": "在 Coda 里管理多个 Codex 账号：资源页的「Codex」改为每个账号一行（首次打开时导入这台机器已有的 Codex 登录），可添加、切换、移除账号和使用完全重置；会话在开始和两轮之间换到所选的账号，令牌由插件续期。关着时用这台机器上 Codex 自己的登录。"
        }
      }
    },
    "protocolImplementations": [
      {
        "kind": "coda/resource@1",
        "commands": {
          "act": "scripts/act.mjs",
          "sign-in": "scripts/sign-in.mjs"
        }
      }
    ],
    "records": [
      {
        "kind": "coda/resource@1",
        "command": "scripts/resource.mjs"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/codex"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "scripts",
    "icons"
  ]
}
