{
  "name": "@coda-console/codex",
  "id": "codex",
  "displayName": "Codex",
  "description": "Codex Agent：Coda 自带的入口运行 codex-acp，报告子 Agent、后台命令与命令的自动审核。额度与登录由账号来源插件接管；未接入账号来源时使用 Codex 自己的登录面板。",
  "version": "1.9.0",
  "categories": [
    "Agent"
  ],
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.12.0",
    "@openai/codex": "0.165.0"
  },
  "overrides": {
    "@agentclientprotocol/codex-acp": {
      "@openai/codex": "$@openai/codex"
    }
  },
  "contributes": {
    "agents": [
      {
        "id": "codex",
        "displayName": "Codex",
        "icon": {
          "light": "icons/openai.pdf",
          "template": true
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "审批模式",
          "unset": "完全访问",
          "auto": "agent",
          "full": "agent-full-access"
        },
        "skillsDir": ".agents/skills",
        "configFiles": [
          "${CODEX_HOME:-~/.codex}/config.toml",
          ".codex/config.toml"
        ],
        "setupHint": "请在运行机为后端所属账号完成 Codex 认证。"
      }
    ],
    "configuration": {
      "title": "Codex",
      "properties": {
        "codex.modelProviders": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "coda-model-provider",
            "modelApis": [
              "openai-responses"
            ]
          },
          "title": "模型服务",
          "order": 1,
          "description": "勾选插件提供的模型服务（如 Magpie），每个服务各成一组，它列出的模型和 Codex 自己的模型一起出现在会话的模型里；选中哪个服务的模型，那个会话就走那个服务，Codex 自己的模型照旧。只列 OpenAI Responses 接口（openai-responses）的服务：Codex 不再支持 Chat Completions。"
        }
      }
    },
    "panels": [
      {
        "id": "login",
        "title": "Codex",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/panel.mjs\"",
        "maxAge": "PT0S",
        "actions": {
          "reset": {
            "command": "node \"$CODA_PLUGIN_PATH/scripts/reset.mjs\"",
            "confirm": "使用一次完全重置？\n用最早到期的那一次。成功后消耗 1 次，无法撤销。"
          }
        },
        "signIn": {
          "command": "NO_COLOR=1 exec node \"$CODA_PLUGIN_PATH/scripts/cli.mjs\" login --device-auth",
          "note": "接入账号插件后，登录会添加或更新插件管理的账号。"
        }
      }
    ],
    "extensionPoints": {
      "account-source": {
        "description": "Codex 的账号与登录入口：来源给出当前账号和令牌，响应 --login，并提供账号与额度面板；接入后 Codex 自带的额度面板隐藏。"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/codex"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "scripts",
    "icons"
  ]
}
