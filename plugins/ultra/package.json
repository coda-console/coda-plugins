{
  "name": "@coda-console/ultra",
  "id": "ultra",
  "displayName": "Ultra",
  "description": "输入框的 Ultra 模式：主 Agent 主动把能并行的活拆出去，按名单派给 Coda 子会话，自己做卡住的那一步，结果回来后汇总、验证。名单在模式的参数里改，常用的存成设置里的模板。",
  "version": "1.1.2",
  "categories": ["工作流程"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/ultra"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["main.mjs", "ultra.mjs"],
  "main": "main.mjs",
  "contributes": {
    "configuration": {
      "title": "Ultra",
      "properties": {
        "ultra.templates": {
          "title": "模板",
          "description": "进入 Ultra 时可选的名单，一行一个子 Agent：同一个模板名的几行是一个模板，排第一的模板是进入时的默认。默认没有模板，子 Agent 名单为空时沿用当前会话的 Agent 和模型。",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "template": { "title": "模板", "type": "string", "order": 0 },
              "who": { "title": "Agent", "type": "object", "format": "coda-agent", "order": 1 },
              "when": { "title": "什么时候派给它", "type": "string", "order": 2 }
            },
            "required": ["template", "who"]
          },
          "default": []
        }
      }
    },
    "composerModes": [
      {
        "id": "ultra",
        "title": "Ultra",
        "icon": "square.stack.3d.up",
        "hint": "主 Agent 拆出能并行的活，按名单派给子会话，汇总后验证",
        "placeholder": "要完成什么？",
        "agent": "session",
        "in": ["session", "new"],
        "parameters": {
          "type": "object",
          "properties": {
            "template": { "title": "模板", "type": "string" },
            "subagents": {
              "title": "子 Agent",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "who": { "title": "Agent", "type": "object", "format": "coda-agent" },
                  "when": { "title": "什么时候派给它", "type": "string" }
                },
                "required": ["who"]
              }
            }
          }
        }
      }
    ]
  }
}
