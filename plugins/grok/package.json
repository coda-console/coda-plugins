{
  "name": "@coda-console/grok",
  "id": "grok",
  "displayName": "Grok",
  "description": "用 Grok CLI 跑会话",
  "version": "1.9.0",
  "engines": {
    "coda": 6
  },
  "categories": [
    "Agent"
  ],
  "contributes": {
    "agents": [
      {
        "id": "grok",
        "displayName": "Grok",
        "icon": {
          "light": "icons/grok.pdf",
          "template": true
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "审批模式",
          "unset": "按运行机配置",
          "auto": "auto",
          "full": "always-approve",
          "note": "切换对后续消息生效；新会话未选择时沿用运行机的 Grok 配置。"
        },
        "skillsDir": ".agents/skills",
        "configFiles": [
          "${GROK_HOME:-~/.grok}/config.toml"
        ],
        "setupHint": "请在「资源」里为运行机添加 Grok。"
      }
    ],
    "protocolImplementations": [
      {
        "kind": "coda/resource@1",
        "commands": {
          "sign-in": "scripts/sign-in.mjs",
          "install": "scripts/install.mjs"
        }
      }
    ],
    "records": [
      {
        "kind": "coda/resource@1",
        "command": "scripts/resource.mjs"
      }
    ],
    "setup": {
      "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/setup.mjs\""
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/grok"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "scripts",
    "icons"
  ]
}
