{
  "name": "@coda-console/opencode",
  "id": "opencode",
  "displayName": "OpenCode",
  "description": "OpenCode Agent：接入原生子会话的状态、过程与停止，跟踪后台命令，并送入会话指令。",
  "version": "2.2.1",
  "categories": ["Agent"],
  "contributes": {
    "agents": [
      {
        "id": "opencode",
        "displayName": "OpenCode",
        "icon": {
          "light": "icons/opencode-light.pdf",
          "dark": "icons/opencode-dark.pdf"
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "工作模式",
          "unset": "Agent 默认",
          "note": "工具权限沿用运行机的 OpenCode 配置。"
        },
        "skillsDir": ".agents/skills",
        "configFiles": [
          "${OPENCODE_CONFIG}",
          "${XDG_CONFIG_HOME:-~/.config}/opencode/opencode.json",
          "${XDG_CONFIG_HOME:-~/.config}/opencode/opencode.jsonc",
          "${XDG_CONFIG_HOME:-~/.config}/opencode/config.json",
          "opencode.json",
          "opencode.jsonc"
        ],
        "setupHint": "请在运行机安装并登录 OpenCode 2（2.1.4 及以上），确认后端能执行 opencode acp。"
      }
    ],
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode.modelProviders": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "coda-model-provider",
            "modelApis": ["openai-completions", "openai-responses", "anthropic-messages"]
          },
          "title": "模型服务",
          "order": 1,
          "description": "勾选插件提供的模型服务（如 Magpie），每个服务各成一组，它列出的模型和 OpenCode 自己的模型一起出现在会话的模型里；选中哪个服务的模型，那个会话就走那个服务。可选 OpenAI Chat、OpenAI Responses 和 Anthropic 接口的服务。"
        }
      }
    },
    "setup": {
      "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/setup.mjs\""
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/opencode"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "scripts",
    "icons",
    "runtime"
  ],
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
