<?xml version="1.0" encoding="UTF-8"?>
<!-- Claude 缓存过期前压缩（设置 claude.idleCompaction）：只跟随 Claude SDK 的会话，一个会话一条运行。
     会话停下后还要接着用（置顶了，或还在等你、等 Coda 跑的流程与子会话、等它自己的后台任务、子 Agent 与定时），就在一小时的提示词缓存
     过期前请 Agent 压缩一次上下文（compact-session），趁缓存还热时做摘要，回来时只需重新缓存摘要。
     判断全在这里，依据是 Agent 每轮报来的 facts.usage：lastRequestAt（主线程最后一次请求模型，缓存最后一次被用到）、contextTokens（那次请求带的上下文）、
     cacheTtl（缓存时长）、compactedAt（最近一次压缩，不管是谁压的）。照 Claude Code 2.1.296 自带的空闲压缩：只压一小时的缓存、上下文不少于 15 万 token，
     在缓存寿命的 9/10（最后一次请求后 54 分钟）请 Agent 压缩，到点已过 58 分钟（机器睡过、后端停过，缓存多半已失效）就不压。
     最后一次请求之后已经压缩过就不再压；同一次请求只请一次（compact.usage 是请求时的事实）。Agent 只执行，结果记在 compact 这一步里。
     流程只读会话事实、只请 Agent 压缩，不改会话自己的状态，不发布阶段。 -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:coda="https://coda.pub/schema/bpmn/1.0" id="claude-compaction-definitions" targetNamespace="https://coda.pub/plugins/claude">
  <message id="opened" name="session.opened" />
  <message id="facts" name="session.facts" />
  <process id="claude-compaction" name="Claude 缓存过期前压缩" isExecutable="true" coda:dispatch="false" coda:agents="claude-sdk">
    <startEvent id="start" name="会话打开"><messageEventDefinition messageRef="opened" /></startEvent>
    <sequenceFlow id="start-pick" sourceRef="start" targetRef="pick" />

    <!-- 第一个成立的条件生效，所以顺序就是优先级。 -->
    <exclusiveGateway id="pick" name="会话现在怎样" default="pick-idle" />
    <sequenceFlow id="pick-end" sourceRef="pick" targetRef="end">
      <conditionExpression xsi:type="tFormalExpression">=facts != null and facts.archived</conditionExpression>
    </sequenceFlow>
    <!-- 打开了设置；进程在、没在跑一轮；还要接着用；一小时的缓存、上下文够大；最后一次请求之后没压缩过，也还没为它请过。 -->
    <sequenceFlow id="pick-due" sourceRef="pick" targetRef="waiting">
      <conditionExpression xsi:type="tFormalExpression">=facts != null and vars.claude.idleCompaction and facts.live and not(facts.busy)
        and (facts.pinned or facts.input or facts.waitsForSystem or facts.background or facts.scheduled)
        and facts.usage != null and facts.usage.lastRequestAt != null and facts.usage.cacheTtl = "PT1H" and facts.usage.contextTokens >= 150000
        and (facts.usage.compactedAt = null or date and time(facts.usage.compactedAt) &lt; date and time(facts.usage.lastRequestAt))
        and not(compact != null and compact.usage != null and compact.usage.lastRequestAt = facts.usage.lastRequestAt)</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="pick-idle" sourceRef="pick" targetRef="idle" />

    <!-- 不计时：等事实变了再看。 -->
    <receiveTask id="idle" name="等会话的事实" messageRef="facts" />
    <sequenceFlow id="idle-pick" sourceRef="idle" targetRef="pick" />

    <!-- 最后一次请求 54 分钟后到点；期间事实变了就回去重看，最后一次请求没变时期限不变。 -->
    <receiveTask id="waiting" name="等缓存快过期" messageRef="facts" />
    <sequenceFlow id="waiting-pick" sourceRef="waiting" targetRef="pick" />
    <boundaryEvent id="due" name="缓存快过期了" attachedToRef="waiting">
      <timerEventDefinition><timeDuration xsi:type="tFormalExpression">{{facts.usage.lastRequestAt}}/PT54M</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="due-late" sourceRef="due" targetRef="late" />

    <!-- 到点晚了（过了 58 分钟）就不压，等下一次请求。 -->
    <exclusiveGateway id="late" name="还来得及吗" default="late-idle" />
    <sequenceFlow id="late-compact" sourceRef="late" targetRef="compact">
      <conditionExpression xsi:type="tFormalExpression">=now() &lt; date and time(facts.usage.lastRequestAt) + duration("PT58M")</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="late-idle" sourceRef="late" targetRef="idle" />

    <serviceTask id="compact" name="请 Agent 压缩" coda:action="compact-session" />
    <sequenceFlow id="compact-pick" sourceRef="compact" targetRef="pick" />

    <endEvent id="end" name="会话已归档" />
  </process>
</definitions>
