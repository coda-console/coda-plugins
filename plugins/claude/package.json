{
  "name": "@coda-console/claude",
  "id": "claude",
  "displayName": "Claude",
  "description": "Claude SDK Agent：Coda 基于 Claude Agent SDK 写的 ACP 入口，一个进程一个 SDK 会话；资源页的「Claude」面板显示会话报告的额度，可从 Coda 登录。",
  "version": "1.6.3",
  "categories": ["Agent"],
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.296"
  },
  "contributes": {
    "agents": [
      {
        "id": "claude-sdk",
        "displayName": "Claude SDK",
        "icon": {
          "light": "icons/claude.pdf"
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "审批模式",
          "unset": "人工审批",
          "auto": "auto",
          "full": "bypassPermissions"
        },
        "skillsDir": ".claude/skills",
        "configFiles": [
          "${CLAUDE_CONFIG_DIR:-~/.claude}/settings.json",
          ".claude/settings.json",
          ".claude/settings.local.json"
        ],
        "setupHint": "请在运行机配置 Claude SDK 认证；若指定了 token 文件，请检查路径和权限。"
      }
    ],
    "configuration": {
      "title": "Claude",
      "properties": {
        "claude.modelProviders": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "coda-model-provider",
            "modelApis": ["anthropic-messages"]
          },
          "title": "模型服务",
          "order": 1,
          "description": "勾选插件提供的模型服务（如 Magpie），每个服务各成一组，它列出的模型和 Claude 自己的模型一起出现在会话的模型里；选中哪个服务的模型，那个会话就走那个服务，Claude 自己的模型照旧。只列 Anthropic 接口（anthropic-messages）的服务。"
        }
      }
    },
    "panels": [
      {
        "id": "limits",
        "title": "Claude",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/panel.mjs\"",
        "signIn": {
          "command": "exec node \"$CODA_PLUGIN_PATH/scripts/login.mjs\"",
          "installed": "node \"$CODA_PLUGIN_PATH/scripts/login.mjs\" --installed",
          "input": "authorizationCode",
          "note": "登录保存在这台机器上，供 Claude SDK 使用；额度在会话运行后出现。这台机器若已配置 OAuth token、API key 或云服务商，会话仍优先用那些配置。"
        }
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/claude"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "scripts",
    "icons"
  ]
}
