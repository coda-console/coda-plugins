{
  "name": "@coda-console/composer",
  "id": "composer",
  "displayName": "输入框模式",
  "description": "交接、子会话、! 命令、Ultra 与循环",
  "icon": { "symbol": "character.cursor.ibeam", "color": "blue" },
  "version": "6.1.1",
  "categories": [
    "工作流程"
  ],
  "extensionDependencies": [
    "github"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/composer"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "main.mjs",
    "ultra.mjs",
    ".coda/workflows",
    "scripts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "main.mjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "输入框模式",
      "properties": {
        "composer.templates": {
          "title": "模板",
          "description": "进入 Ultra 时可选的名单，一行一个执行者：同一个模板名的几行是一个模板，排第一的模板是进入时的默认。默认没有模板，执行者名单为空时沿用当前会话的 Agent 和模型。",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "template": {
                "title": "模板",
                "type": "string",
                "order": 0
              },
              "who": {
                "title": "Agent",
                "type": "object",
                "format": "coda-agent",
                "order": 1
              },
              "when": {
                "title": "什么时候派给它",
                "type": "string",
                "order": 2
              }
            },
            "required": [
              "template",
              "who"
            ]
          },
          "default": []
        }
      }
    },
    "instructions": "要把改动合进默认分支时，一个需求开一次 kickoff（给 title、goal、建议的 way、要不要设备验收；开在别的目录或要指定分支时给 branch），用户在开工卡上选定后流程把下一步交给你，不要先改完再补开。需求是用户想一起验收、一起上线的一件事，只有必须先上线才能往下做时才拆成几个；小修走简易开发；需求里的每一块用 lane-pr 提。",
    "composerModes": [
      {
        "id": "handoff",
        "title": "交接到新会话",
        "icon": "arrow.right.square",
        "hint": "新会话承接这里的上下文，共享当前工作目录；可选择执行者，留空沿用输入框的执行者。可与其他模式同时开启，发送后退出交接模式。",
        "placeholder": "接下来要完成什么？",
        "sendLabel": "交接",
        "once": true,
        "parameters": {
          "type": "object",
          "properties": {
            "agent": {
              "title": "Agent",
              "description": "留空沿用输入框的执行者。",
              "type": "object",
              "format": "coda-agent"
            }
          }
        }
      },
      {
        "id": "subagent",
        "title": "子会话",
        "icon": "arrow.triangle.branch",
        "hint": "从当前会话创建子会话，承接近期上下文并沿用工作目录；子会话也可继续创建子会话。可选择执行者和回报对象，发送后退出本模式。",
        "placeholder": "描述交给子会话的任务…",
        "sendLabel": "启动子会话",
        "parameters": {
          "type": "object",
          "properties": {
            "agent": {
              "title": "Agent",
              "description": "留空沿用输入框的执行者。",
              "type": "object",
              "format": "coda-agent"
            },
            "replyTo": {
              "title": "回报对象",
              "type": "string",
              "enum": [
                "parent",
                "sender"
              ],
              "enumItemLabels": [
                "完成后回报父会话",
                "完成后回报你"
              ],
              "enumDescriptions": [
                "结果交给父 Agent，由它接着处理",
                "做完提醒你，不叫醒父 Agent"
              ],
              "default": "parent"
            }
          }
        },
        "once": true
      },
      {
        "id": "shell",
        "title": "执行命令",
        "icon": "terminal",
        "hint": "在会话工作目录执行，命令和结果作为这条消息发给 Agent。",
        "placeholder": "输入要执行的命令…",
        "sendLabel": "执行",
        "trigger": "!",
        "in": [
          "session",
          "new"
        ]
      },
      {
        "id": "ultra",
        "title": "Ultra",
        "icon": "square.stack.3d.up",
        "hint": "主 Agent 定任务、做决定、审查，调研与核实交给名单里的执行者；可与其他模式同时开启，点 × 退出。",
        "placeholder": "要完成什么？",
        "in": [
          "session",
          "new"
        ],
        "parameters": {
          "type": "object",
          "properties": {
            "subagents": {
              "title": "执行者",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "who": {
                    "title": "Agent",
                    "type": "object",
                    "format": "coda-agent"
                  },
                  "when": {
                    "title": "什么时候派给它",
                    "type": "string"
                  }
                },
                "required": [
                  "who"
                ]
              },
              "presets": {
                "from": "composer.templates",
                "by": "template"
              }
            }
          }
        }
      },
      {
        "id": "loop",
        "title": "循环",
        "icon": "clock.arrow.2.circlepath",
        "hint": "按周期把同一句话再发给 Agent，每轮做完才开始计时，7 天后自动结束；可与其他模式同时开启，发送后退出循环模式。",
        "placeholder": "每轮要做什么？",
        "sendLabel": "开始循环",
        "in": [
          "session"
        ],
        "parameters": {
          "type": "object",
          "properties": {
            "every": {
              "title": "周期",
              "type": "string",
              "format": "duration",
              "enum": [
                "PT5M",
                "PT10M",
                "PT15M",
                "PT30M",
                "PT1H",
                "PT2H",
                "PT3H",
                "PT6H",
                "PT12H",
                "P1D"
              ],
              "enumItemLabels": [
                "5 分钟",
                "10 分钟",
                "15 分钟",
                "30 分钟",
                "1 小时",
                "2 小时",
                "3 小时",
                "6 小时",
                "12 小时",
                "1 天"
              ],
              "default": "PT30M"
            }
          }
        },
        "once": true
      }
    ]
  }
}
