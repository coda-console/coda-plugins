<?xml version="1.0" encoding="UTF-8"?>
<!-- 块（README.md「块」）：需求运行（develop）里的一项改动，一项一个。执行者从需求分支 head 开工，交付推到临时分支 piece/<运行 ID>（不开 PR），
     项目检查、一位评审者（review-commit 提交模式）评过后由主 Agent 看一页结论审查，squash 成一个提交快进进需求分支后删掉临时分支，输出这个提交和本运行 ID；
     放弃时走出错结束，调用方的出错边界接得到。评审结论不决定去向；主 Agent 退回修改后评审者只复评之后的变动（README.md「评审」）。
     同一块退回满三次后再退回交用户「这一块三轮没过」，此外不出用户卡；不装机、不部署、不跑合并前检查。BPMN 2.0，由 Coda 执行（docs/workflows.md）。 -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:coda="https://coda.pub/schema/bpmn/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="piece-definitions" targetNamespace="https://coda.pub/plugins/composer">
  <process id="piece" name="块" isExecutable="true" coda:title='="块：" + inputs.title'>
    <extensionElements>
      <coda:input name="branch" label="需求分支" type="string" required="true" description="这一块合进的需求分支名，执行者从它的 head 开工" />
      <coda:input name="base" label="目标分支" type="string" required="true" description="需求最后合进的分支；跟上目标分支的块把 origin/&lt;它&gt; 合并进来" />
      <coda:input name="title" label="标题" type="string" required="true" description="块的名字，用在运行标题和提交说明里；普通块合入时是那个 squash 提交的标题，跟上目标分支的块合入的是执行者自己的合并提交，不用它" />
      <coda:input name="task" label="任务" type="string" required="true" description="自足的任务书：背景、范围与验收要求" />
      <coda:input name="sync" label="跟上目标分支" type="boolean" default="false" description="把目标分支合进需求分支的块：以合并提交快进，不 squash" />
      <coda:input name="executor" label="执行者" type="agent" required="true" description="必填，做这一项的 Agent；通常是所属监督开发的开工执行者" />
      <coda:input name="executor2" label="备用执行者" type="agent" description="主 Agent 在审查卡上选「换备用执行者重做」时接手；不填不能换" />
      <coda:input name="reviewer" label="评审者" type="agent" description="项目检查通过后评每一次交付；主 Agent 退回修改后只复评之后的变动。不填不评" />
    </extensionElements>
    <startEvent id="start" />
    <sequenceFlow id="start-execute" sourceRef="start" targetRef="execute" />
    <scriptTask id="execute" name="执行这一项" scriptFormat="bash">
      <extensionElements>
        <coda:env name="BRANCH" value="=inputs.branch" />
        <coda:env name="BASE" value="=inputs.base" />
        <coda:env name="TITLE" value="=inputs.title" />
        <coda:env name="TASK" value="=inputs.task" />
        <coda:env name="SYNC" value="=inputs.sync" />
        <coda:env name="EXECUTOR" value="=inputs.executor" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" execute</script>
    </scriptTask>
    <sequenceFlow id="execute-report" sourceRef="execute" targetRef="gate" />
    <scriptTask id="gate" name="推送到临时分支" scriptFormat="bash" coda:timeout="5" coda:retry="3">
      <extensionElements><coda:output name="head" /><coda:output name="empty" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" gate</script>
    </scriptTask>
    <sequenceFlow id="gate-delivery" sourceRef="gate" targetRef="has-new" />
    <exclusiveGateway id="has-new" name="相对需求分支有没有新提交" default="gate-checks" />
    <sequenceFlow id="gate-checks" sourceRef="has-new" targetRef="checks" />
    <sequenceFlow id="gate-empty" sourceRef="has-new" targetRef="check-feedback"><conditionExpression xsi:type="tFormalExpression">=gate.empty = true</conditionExpression></sequenceFlow>
    <serviceTask id="checks" name="项目检查" coda:action="run-workflows">
      <extensionElements><coda:param name="hook" value="check" /><coda:param name="commit" value="=gate.head" /></extensionElements>
    </serviceTask>
    <boundaryEvent id="checks-failed" attachedToRef="checks"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="checks-feedback" sourceRef="checks-failed" targetRef="check-feedback" />
    <scriptTask id="check-feedback" name="自动退回检查失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="EMPTY" value="=gate.empty" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" gate-failed</script>
    </scriptTask>
    <sequenceFlow id="checks-review" sourceRef="check-feedback" targetRef="gate-route" />
    <exclusiveGateway id="gate-route" name="连续失败是否达到三次" default="gate-revise" />
    <sequenceFlow id="gate-escalate" sourceRef="gate-route" targetRef="report"><conditionExpression xsi:type="tFormalExpression">=check-feedback.route = "review"</conditionExpression></sequenceFlow>
    <sequenceFlow id="gate-revise" sourceRef="gate-route" targetRef="revise" />
    <sequenceFlow id="checks-passed" sourceRef="checks" targetRef="gate-passed" />
    <!-- 检查通过后定评审范围：主 Agent 退回修改之后是复评（base 是上次评过的 head，previous 带还没关的必须修），否则评需求分支 head 到这次交付；
         task 是任务书原文后附主 Agent 历次的退回意见。 -->
    <scriptTask id="gate-passed" name="记录检查并定评审范围" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="RUNS" value="=checks.runs" />
        <coda:output name="base" /><coda:output name="head" /><coda:output name="task" /><coda:output name="checks" /><coda:output name="previous" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" gate-passed</script>
    </scriptTask>
    <sequenceFlow id="gate-passed-review" sourceRef="gate-passed" targetRef="review-choice" />
    <exclusiveGateway id="review-choice" name="是否评审" default="review-skip" />
    <sequenceFlow id="review-needed" sourceRef="review-choice" targetRef="review-call"><conditionExpression xsi:type="tFormalExpression">=inputs.reviewer != null</conditionExpression></sequenceFlow>
    <sequenceFlow id="review-skip" sourceRef="review-choice" targetRef="report" />
    <!-- 评审只调一次 review-commit；评审没完成时它照常结束（decision 为 INCOMPLETE），出错边界只接调用本身没成。两种都照常出审查卡，结论不决定去向。 -->
    <callActivity id="review-call" name="评审这次交付" calledElement="review-commit">
      <extensionElements>
        <coda:param name="base" value="=gate-passed.base" />
        <coda:param name="head" value="=gate-passed.head" />
        <coda:param name="task" value="=gate-passed.task" />
        <coda:param name="reviewer" value="=inputs.reviewer" />
        <coda:param name="evidence" value="=gate-passed.checks" />
        <coda:param name="previous" value="=gate-passed.previous" />
      </extensionElements>
    </callActivity>
    <boundaryEvent id="review-failed" attachedToRef="review-call"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="review-failed-lost" sourceRef="review-failed" targetRef="review-lost" />
    <scriptTask id="review-lost" name="记下没评成" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" review-lost</script>
    </scriptTask>
    <sequenceFlow id="review-lost-report" sourceRef="review-lost" targetRef="report" />
    <sequenceFlow id="review-call-done" sourceRef="review-call" targetRef="reviewed" />
    <scriptTask id="reviewed" name="评审结果入账" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="DECISION" value="=review-call.decision" /><coda:env name="FINDINGS" value="=review-call.findings" /><coda:env name="LINE" value="=review-call.line" />
        <coda:env name="REPORT" value="=review-call.report" /><coda:env name="RESOLUTIONS" value="=review-call.resolutions" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" reviewed</script>
    </scriptTask>
    <sequenceFlow id="reviewed-report" sourceRef="reviewed" targetRef="report" />
    <scriptTask id="report" name="整理审查材料" scriptFormat="bash" coda:timeout="5">
      <extensionElements>
        <coda:env name="REVIEWER" value="=inputs.reviewer != null" />
        <coda:output name="session" /><coda:output name="head" /><coda:output name="branch" /><coda:output name="temp" /><coda:output name="tip" /><coda:output name="feedback" /><coda:output name="returns" />
        <coda:output name="answer" /><coda:output name="checks" /><coda:output name="review" /><coda:output name="changes" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" review</script>
    </scriptTask>
    <sequenceFlow id="report-review" sourceRef="report" targetRef="review" />
    <userTask id="review" name="主 Agent 审查" coda:noteLabel="修改意见或说明">
      <documentation>这一块：{{inputs.title}}
执行会话：{{report.session}}；head {{report.head}}（推在临时分支 {{report.temp}}），需求分支 {{report.branch}}
已退回 {{report.returns}} 次（只数你选的「退回修改」；满三次后再退回交用户决定）。
备用执行者：{{if inputs.executor2 = null then "未指定，不能换人" else string join([inputs.executor2.agent, inputs.executor2.model, inputs.executor2.effort][item != null], " · ")}}

执行者最后一条回复：
{{report.answer}}

项目检查结果：
{{report.checks}}

评审结论：
{{report.review}}

改动范围：
{{report.changes}}

看改动（备查）：git fetch origin {{report.branch}} {{report.temp}} &amp;&amp; git diff {{report.tip}}...{{report.head}}
{{if report.feedback = "" then "" else "\n待处理反馈：\n" + report.feedback + "\n"}}
不要求读 diff。只在三种情况下读有疑问的那部分：评审者说动了对外契约或超出任务书；执行者和评审者各执一词；改动范围明显超出任务书。不要自己改代码，修改都交给执行者。
取舍标准：只有必须修才退回；评审者说成立不等于现在要修。必须修是合并后用户会遇到错的结果、丢数据、安全问题，对外契约写错，测试是红的或会偶发失败，漏了任务书要求的事或做了任务书之外的事，以及会扩散、越晚越难改的结构问题（跨模块或会被照着写：绕过已有边界、依赖方向反过来、第二个事实来源或第二套做同一件事的机制、迁移只做一半）；其余是小问题。退回时只列要修的那几条，定了不改的单独一行写「#编号 不改」，后面可以接理由，如「#2 不改：只影响少见路径」；不顺手带小问题，不加设计改动，不把以后的需求提前做进来。
选择「退回修改」时备注必填，同一个执行会话按它修，照常过项目检查，再由评审者复评：只评上次评过的提交之后的变动，带上还没关的必须修和你历次的退回意见；单独一行写「#编号 不改」的由流程关掉，不再交评审者。
选择「让执行者合并需求分支」时备注可选，写了就附在固定说明后面；同一个执行会话把需求分支当前 head 合入当前分支并解冲突（别的块刚合进去、有相关改动或版本号会撞时选它），不算退回。
选择「换备用执行者重做」时备注必填，写为什么换、接手的人要注意什么；备用执行者从需求分支当前 head 新开执行会话重做这一项，之后的退回修改续它。没填备用执行者时选它会回到这张卡。
流程自己跑项目检查；执行者只需跑直接相关的快检查，不必用 run-held 跑整套编译。
选择「合进需求分支」时，流程先试合并需求分支当前 head：有冲突就不动需求分支，把冲突的文件交给同一个执行会话合并，之后照常检查、评审再回到这张卡，同样不算退回；干净时{{if inputs.sync then "以这次交付的合并提交快进需求分支（跟上目标分支的块不 squash），需求分支 head 不是它的祖先时同样先交执行者合并需求分支" else "把这一块 squash 成一个提交，接在需求分支 head 上快进推送"}}，删掉临时分支，结果交回你的会话。
选择「放弃」删掉临时分支，需求分支不动，这一块以失败结束。</documentation>
      <extensionElements>
        <coda:choice id="revise" name="退回修改" />
        <coda:choice id="sync" name="让执行者合并需求分支" />
        <coda:choice id="swap" name="换备用执行者重做" />
        <coda:choice id="land" name="合进需求分支" primary="true" />
        <coda:choice id="abandon" name="放弃" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="review-decide" sourceRef="review" targetRef="decide" />
    <scriptTask id="decide" name="读取审查意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="REVIEW" value="=review" /><coda:env name="BACKUP" value="=inputs.executor2 != null" /><coda:output name="route" /><coda:output name="stuck" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" decide</script>
    </scriptTask>
    <sequenceFlow id="decide-how" sourceRef="decide" targetRef="how" />
    <exclusiveGateway id="how" name="审查结论" default="how-land" />
    <sequenceFlow id="how-note" sourceRef="how" targetRef="report"><conditionExpression xsi:type="tFormalExpression">=decide.route = "review"</conditionExpression></sequenceFlow>
    <sequenceFlow id="how-revise" sourceRef="how" targetRef="revise"><conditionExpression xsi:type="tFormalExpression">=decide.route = "revise"</conditionExpression></sequenceFlow>
    <sequenceFlow id="how-stuck" sourceRef="how" targetRef="stuck"><conditionExpression xsi:type="tFormalExpression">=decide.route = "stuck"</conditionExpression></sequenceFlow>
    <sequenceFlow id="how-swap" sourceRef="how" targetRef="swap"><conditionExpression xsi:type="tFormalExpression">=decide.route = "swap"</conditionExpression></sequenceFlow>
    <sequenceFlow id="how-abandon" sourceRef="how" targetRef="abandon"><conditionExpression xsi:type="tFormalExpression">=decide.route = "abandon"</conditionExpression></sequenceFlow>
    <sequenceFlow id="how-land" sourceRef="how" targetRef="land" />
    <!-- 退回满三次后主 Agent 再选退回：不退回，交用户。继续修把退回次数清零、按主 Agent 这次的意见退回；放弃同主 Agent 选放弃。 -->
    <userTask id="stuck" name="这一块三轮没过" coda:assignee="user">
      <documentation>块「{{inputs.title}}」已经退回修改三次，主 Agent 这次又要退回。
{{decide.stuck}}

选「继续修」：退回次数清零，按主 Agent 这次的意见退回同一个执行会话。
选「放弃这一块」：同主 Agent 选放弃，删掉临时分支，需求分支不动，这一块以失败结束。</documentation>
      <extensionElements>
        <coda:choice id="continue" name="继续修" primary="true" />
        <coda:choice id="abandon" name="放弃这一块" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="stuck-decide" sourceRef="stuck" targetRef="stuck-result" />
    <scriptTask id="stuck-result" name="读取用户的决定" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="STUCK" value="=stuck" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" stuck</script>
    </scriptTask>
    <sequenceFlow id="stuck-how" sourceRef="stuck-result" targetRef="stuck-route" />
    <exclusiveGateway id="stuck-route" name="继续修还是放弃" default="stuck-revise" />
    <sequenceFlow id="stuck-abandon" sourceRef="stuck-route" targetRef="abandon"><conditionExpression xsi:type="tFormalExpression">=stuck-result.route = "abandon"</conditionExpression></sequenceFlow>
    <sequenceFlow id="stuck-revise" sourceRef="stuck-route" targetRef="revise" />
    <scriptTask id="revise" name="同一执行会话修改" scriptFormat="bash">
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" revise</script>
    </scriptTask>
    <sequenceFlow id="revise-report" sourceRef="revise" targetRef="gate" />
    <!-- 换备用执行者：新开会话从需求分支当前 head 重做同一项，之后的交付、检查、评审、审查照常。 -->
    <scriptTask id="swap" name="换备用执行者重做" scriptFormat="bash">
      <extensionElements><coda:env name="EXECUTOR" value="=inputs.executor2" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" swap</script>
    </scriptTask>
    <sequenceFlow id="swap-report" sourceRef="swap" targetRef="gate" />
    <scriptTask id="land" name="试合并并合进需求分支" scriptFormat="bash" coda:timeout="10" coda:retry="3">
      <extensionElements><coda:output name="route" /><coda:output name="commit" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" land</script>
    </scriptTask>
    <sequenceFlow id="land-route" sourceRef="land" targetRef="after-land" />
    <exclusiveGateway id="after-land" name="是否合进需求分支" default="land-done" />
    <sequenceFlow id="land-sync" sourceRef="after-land" targetRef="revise"><conditionExpression xsi:type="tFormalExpression">=land.route = "sync"</conditionExpression></sequenceFlow>
    <sequenceFlow id="land-done" sourceRef="after-land" targetRef="landed" />
    <endEvent id="landed" name="已合进需求分支" coda:notify="true">
      <extensionElements>
        <coda:output name="commit" value="=land.commit" /><coda:output name="run" value="=run.id" />
      </extensionElements>
    </endEvent>
    <scriptTask id="abandon" name="删除临时分支" scriptFormat="bash" coda:timeout="5" coda:retry="3">
      <script>node "${CODA_PLUGIN_PATH}/scripts/piece.mjs" abandon</script>
    </scriptTask>
    <sequenceFlow id="abandon-done" sourceRef="abandon" targetRef="abandoned" />
    <!-- 出错结束：运行以「流程走到出错结束「主 Agent 放弃了这一块，需求分支没动」」失败，callActivity 调它的流程收到 CALL_FAILED 与这个原因。 -->
    <endEvent id="abandoned" name="主 Agent 放弃了这一块，需求分支没动" coda:notify="true"><errorEventDefinition /></endEvent>
  </process>
</definitions>
