<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:coda="https://coda.pub/schema/bpmn/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="develop-definitions" targetNamespace="https://coda.pub/plugins/composer">
  <process id="develop" name="监督开发" isExecutable="true" coda:kind="develop" coda:title='{{if inputs.title = "" then "监督开发" else "开发：" + inputs.title}}'>
    <extensionElements>
      <coda:input name="title" label="功能名" default="" description="留空时由主 Agent 在第一张任务里写" />
      <coda:input name="task" label="第一项任务" default="" description="留空时由主 Agent 把和你聊定的需求写成第一项任务" />
      <coda:input name="devices" label="设备验收" type="boolean" default="false" description="改了客户端、要在 Mac 或 iPhone 上验收时打开" />
      <coda:input name="device" label="验收设备" type="string" default="" description="测试机设备名，如 duo-testbed；验收期间独占它；留空不占设备" />
      <coda:input name="delivery" label="所属需求" type="string" default="" description="需求运行的 ID；留空为独立交付" />
      <coda:input name="executor" label="执行者" type="agent" defaultFrom="session.agent" description="做每一项任务的 Agent；不填用发起会话的" />
      <coda:input name="reviewer" label="评审者" type="agent" description="项目检查通过后评每一次交付；不填不评" />
      <coda:input name="reviewer2" label="第二评审者" type="agent" description="与评审者同时评每一次交付；不填不评" />
      <coda:input name="reviewerOnce" label="首次评审者" type="agent" description="只评每项任务第一次通过项目检查的那次交付；不填不评" />
      <coda:input name="base" label="目标分支" default="" description="留空用仓库默认分支" />
    </extensionElements>
    <startEvent id="start" />
    <sequenceFlow id="start-brief" sourceRef="start" targetRef="brief-choice" />
    <!-- 用户在会话里开启时没有任务：第一张任务交给主 Agent，不叫醒它，随会话的下一条输入告诉它，由它把聊定的需求写成第一项任务。 -->
    <exclusiveGateway id="brief-choice" name="是否已有第一项任务" default="brief-given" />
    <sequenceFlow id="brief-needed" sourceRef="brief-choice" targetRef="brief"><conditionExpression xsi:type="tFormalExpression">=inputs.task = ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="brief-given" sourceRef="brief-choice" targetRef="lane" />
    <userTask id="brief" name="写第一项任务" coda:wake="false" coda:noteLabel="第一行功能名，空一行后是第一项任务">
      <documentation>用户在这个会话里开启了监督开发：你是主 Agent，把和用户聊定的需求交给执行者去做，亲自审查每一项；审查通过、验收后开 PR、跑检查，由用户批准合并。
现在把聊定的需求写成第一项任务交给执行者：备注第一行是功能名（也是 PR 标题），空一行后是自足的第一项任务，写清背景、范围和验收要求。之后每一项交回来，都会给你一张「主 Agent 审查」。
设备验收：{{if inputs.devices then "开启" else "未开启"}}{{if inputs.device = "" then "" else "，验收设备 " + inputs.device}}。
{{if brief-result.feedback = null then "" else brief-result.feedback}}</documentation>
      <extensionElements><coda:choice id="start" name="交给执行者" primary="true" note="required" /></extensionElements>
    </userTask>
    <sequenceFlow id="brief-result-flow" sourceRef="brief" targetRef="brief-result" />
    <scriptTask id="brief-result" name="读取第一项任务" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="BRIEF" value="=brief" /><coda:output name="route" /><coda:output name="feedback" /><coda:output name="title" /><coda:output name="task" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" brief</script>
    </scriptTask>
    <sequenceFlow id="brief-route" sourceRef="brief-result" targetRef="after-brief" />
    <exclusiveGateway id="after-brief" name="第一项任务是否写全" default="brief-lane" />
    <sequenceFlow id="brief-again" sourceRef="after-brief" targetRef="brief"><conditionExpression xsi:type="tFormalExpression">=brief-result.route = "brief"</conditionExpression></sequenceFlow>
    <sequenceFlow id="brief-lane" sourceRef="after-brief" targetRef="lane" />
    <scriptTask id="lane" name="建泳道" scriptFormat="bash" coda:timeout="5">
      <extensionElements>
        <coda:env name="TITLE" value='=if inputs.task = "" then brief-result.title else inputs.title' />
        <coda:env name="TASK" value='=if inputs.task = "" then brief-result.task else inputs.task' />
        <coda:env name="BASE" value="=inputs.base" />
        <coda:output name="title" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" lane</script>
    </scriptTask>
    <sequenceFlow id="lane-execute" sourceRef="lane" targetRef="execute" />
    <scriptTask id="execute" name="执行一项任务" scriptFormat="bash">
      <extensionElements>
        <coda:env name="EXECUTOR" value="=if inputs.executor = null then github.event.coda.session else inputs.executor" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" execute</script>
    </scriptTask>
    <sequenceFlow id="execute-report" sourceRef="execute" targetRef="gate" />
    <scriptTask id="gate" name="推送执行者提交" scriptFormat="bash" coda:timeout="5">
      <extensionElements><coda:output name="head" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" gate</script>
    </scriptTask>
    <sequenceFlow id="gate-checks" sourceRef="gate" targetRef="gate-fork" />
    <!-- 推出的提交也是随后验收要装的：独立交付开了设备验收时，在审查的同时调用项目的预编流程（coda:kind="prebuild"），不等它，也不管它成败。 -->
    <parallelGateway id="gate-fork" />
    <sequenceFlow id="gate-fork-checks" sourceRef="gate-fork" targetRef="checks" />
    <sequenceFlow id="gate-fork-prebuild" sourceRef="gate-fork" targetRef="prebuild-choice" />
    <exclusiveGateway id="prebuild-choice" name="是否预编验收要装的" default="prebuild-skip" />
    <sequenceFlow id="prebuild-needed" sourceRef="prebuild-choice" targetRef="prebuild"><conditionExpression xsi:type="tFormalExpression">=inputs.devices and inputs.delivery = ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="prebuild-skip" sourceRef="prebuild-choice" targetRef="prebuilt" />
    <serviceTask id="prebuild" name="预编验收要装的" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="prebuild" /><coda:param name="commit" value="=gate.head" /><coda:param name="inputs" value='=if inputs.device = "" then {} else { device: inputs.device }' /></extensionElements>
    </serviceTask>
    <boundaryEvent id="prebuild-failed" attachedToRef="prebuild"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="prebuild-failed-done" sourceRef="prebuild-failed" targetRef="prebuilt" />
    <sequenceFlow id="prebuild-done" sourceRef="prebuild" targetRef="prebuilt" />
    <endEvent id="prebuilt" />
    <scriptTask id="gate-passed" name="记录通过的检查" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RUNS" value="=checks.runs" /><coda:output name="base" /><coda:output name="task" /><coda:output name="first" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" gate-passed</script>
    </scriptTask>
    <sequenceFlow id="gate-passed-review" sourceRef="gate-passed" targetRef="reviews-choice" />
    <!-- 检查通过后、整理审查材料前，填了的评审者各评一次这次交付（首次评审者只评每项任务的第一次）；一个都不评时直接整理。
         三个位置各一份、同时进行，每份都走到自己的结束事件：没轮到的跳过；评审没完成时 review-commit 照常结束（decision 为 INCOMPLETE），
         不算这一步失败，免得几位同时评不成让运行「叫不动」；出错边界只接调用本身没成（没有插件提供 review-commit、参数不合法），记下来照常结束。
         各份都结束才往下走；结果按位置顺序是一个列表，由「整理审查材料」带进审查卡，评审不挡流程。 -->
    <exclusiveGateway id="reviews-choice" name="是否有人评审" default="reviews-skip" />
    <sequenceFlow id="reviews-needed" sourceRef="reviews-choice" targetRef="reviews"><conditionExpression xsi:type="tFormalExpression">=inputs.reviewer != null or inputs.reviewer2 != null or (inputs.reviewerOnce != null and gate-passed.first)</conditionExpression></sequenceFlow>
    <sequenceFlow id="reviews-skip" sourceRef="reviews-choice" targetRef="report" />
    <subProcess id="reviews" name="评审" coda:optional="true">
      <multiInstanceLoopCharacteristics coda:inputCollection='=[{slot: "reviewer", who: inputs.reviewer}, {slot: "reviewer2", who: inputs.reviewer2}, {slot: "reviewerOnce", who: if gate-passed.first then inputs.reviewerOnce else null}]' coda:inputElement="slot" />
      <startEvent id="reviews-start" />
      <sequenceFlow id="reviews-enter" sourceRef="reviews-start" targetRef="review-choice" />
      <exclusiveGateway id="review-choice" name="这一位评不评" default="review-skip" />
      <sequenceFlow id="review-needed" sourceRef="review-choice" targetRef="review-call"><conditionExpression xsi:type="tFormalExpression">=slot.who != null</conditionExpression></sequenceFlow>
      <sequenceFlow id="review-skip" sourceRef="review-choice" targetRef="review-skipped" />
      <callActivity id="review-call" name="评审这次交付" calledElement="review-commit">
        <extensionElements>
          <coda:param name="base" value="=gate-passed.base" />
          <coda:param name="head" value="=gate.head" />
          <coda:param name="task" value="=gate-passed.task" />
          <coda:param name="reviewer" value="=slot.who" />
        </extensionElements>
      </callActivity>
      <boundaryEvent id="review-failed" attachedToRef="review-call"><errorEventDefinition /></boundaryEvent>
      <sequenceFlow id="review-failed-lost" sourceRef="review-failed" targetRef="review-lost" />
      <sequenceFlow id="review-call-done" sourceRef="review-call" targetRef="review-done" />
      <endEvent id="review-skipped"><extensionElements><coda:output name="state" value="skipped" /></extensionElements></endEvent>
      <endEvent id="review-lost"><extensionElements>
        <coda:output name="state" value="lost" /><coda:output name="slot" value="=slot.slot" /><coda:output name="who" value="=slot.who" /><coda:output name="head" value="=gate.head" />
      </extensionElements></endEvent>
      <endEvent id="review-done"><extensionElements>
        <coda:output name="state" value="done" /><coda:output name="slot" value="=slot.slot" /><coda:output name="who" value="=slot.who" /><coda:output name="head" value="=gate.head" />
        <coda:output name="decision" value="=review-call.decision" /><coda:output name="line" value="=review-call.line" /><coda:output name="findings" value="=review-call.findings" /><coda:output name="report" value="=review-call.report" />
      </extensionElements></endEvent>
    </subProcess>
    <sequenceFlow id="reviews-report" sourceRef="reviews" targetRef="report" />
    <exclusiveGateway id="gate-route" name="连续失败是否达到三次" default="gate-revise" />
    <sequenceFlow id="gate-escalate" sourceRef="gate-route" targetRef="report"><conditionExpression xsi:type="tFormalExpression">=check-feedback.route = "review"</conditionExpression></sequenceFlow>
    <sequenceFlow id="gate-revise" sourceRef="gate-route" targetRef="revise" />
    <scriptTask id="report" name="整理审查材料" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="REVIEWS" value="=reviews" />
        <coda:output name="session" /><coda:output name="branch" /><coda:output name="head" />
        <coda:output name="checks" /><coda:output name="answer" /><coda:output name="lane" /><coda:output name="feedback" /><coda:output name="reviews" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" review</script>
    </scriptTask>
    <sequenceFlow id="report-review" sourceRef="report" targetRef="review" />
    <userTask id="review" name="主 Agent 审查" coda:noteLabel="修改意见或下一项任务">
      <documentation>请发起运行的主 Agent 亲自审查架构和实现方式，不以执行者的回答或检查通过代替读代码。
执行会话：{{report.session}}
分支：{{report.branch}}
head：{{report.head}}
泳道：{{report.lane}}
在仓库中看改动：git diff {{report.lane}}...{{report.head}}

项目检查结果：
{{report.checks}}

执行者回答：
{{report.answer}}
{{if report.reviews = "" then "" else "\n评审者的发现：\n" + report.reviews}}

待处理反馈：
{{report.feedback}}

审查要点：架构是否得当、改动是否最小、有没有防御性或冗余代码、有没有无关改动，实际验证是否足够。检查通过和执行者的回答不能代替你读 diff；不要自己改代码，修改都交给执行者。
评审者的发现是否成立由你判断，不成立的不必转给执行者。
选择「退回修改」时备注必填，给具体意见；同一个执行会话继续修改。
选择「通过，再派一项」时备注必填，写自足的下一项任务；先合进泳道，再开新的执行会话。
流程自己跑项目检查；执行者只需跑直接相关的快检查，不必用 run-held 跑整套编译。
选择「通过，可以验收」时，归属需求则直接开 PR；独立交付开启设备验收则进入安装与验收，否则直接开 PR。同一 head 复用本次已通过的项目检查，PR 阶段另等 GitHub 检查。
选择「通过，可以验收」时备注必填，写给用户的改动汇报，会原样放在批准卡和 PR 描述最上面。约 8 行以内，只写用户能感知的变化和动到的端，不放实现细节、测试数量、文件清单，不贴代码：
做了什么
- …（3～5 条）
需要你知道：…（风险、没做的、顺带改的；没有写「无」）
执行者已通过的 head 已在泳道上时 diff 为空；请结合反馈和本运行先前的通过记录审查。</documentation>
      <extensionElements>
        <coda:choice id="revise" name="退回修改" />
        <coda:choice id="next" name="通过，再派一项" />
        <coda:choice id="accept" name="通过，可以验收" primary="true" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="review-decide" sourceRef="review" targetRef="decide" />
    <scriptTask id="decide" name="读取审查意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="REVIEW" value="=review" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" decide</script>
    </scriptTask>
    <sequenceFlow id="decide-how" sourceRef="decide" targetRef="how" />
    <exclusiveGateway id="how" name="审查结论" default="how-accept" />
    <sequenceFlow id="how-note" sourceRef="how" targetRef="report"><conditionExpression xsi:type="tFormalExpression">=decide.route = "review"</conditionExpression></sequenceFlow>
    <sequenceFlow id="how-revise" sourceRef="how" targetRef="revise"><conditionExpression xsi:type="tFormalExpression">=decide.route = "revise"</conditionExpression></sequenceFlow>
    <sequenceFlow id="how-accept" sourceRef="how" targetRef="accept" />
    <scriptTask id="revise" name="同一执行会话修改" scriptFormat="bash">
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" revise</script>
    </scriptTask>
    <sequenceFlow id="revise-report" sourceRef="revise" targetRef="gate" />
    <scriptTask id="accept" name="快进泳道并推送" scriptFormat="bash" coda:timeout="5">
      <extensionElements><coda:env name="DEVICES" value="=inputs.devices" /><coda:env name="DELIVERY" value="=inputs.delivery" /><coda:output name="head" /><coda:output name="lane" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" accept</script>
    </scriptTask>
    <sequenceFlow id="accept-after" sourceRef="accept" targetRef="after-accept" />
    <exclusiveGateway id="after-accept" name="继续执行还是验收" default="accept-preview" />
    <sequenceFlow id="accept-next" sourceRef="after-accept" targetRef="execute"><conditionExpression xsi:type="tFormalExpression">=accept.route = "execute"</conditionExpression></sequenceFlow>
    <sequenceFlow id="accept-check" sourceRef="after-accept" targetRef="pr"><conditionExpression xsi:type="tFormalExpression">=accept.route = "pr"</conditionExpression></sequenceFlow>
    <sequenceFlow id="accept-preview" sourceRef="after-accept" targetRef="acceptance" />
    <subProcess id="acceptance" name="安装与设备验收" coda:optional="true">
      <startEvent id="acceptance-start" />
      <sequenceFlow id="acceptance-enter" sourceRef="acceptance-start" targetRef="device-lock-choice" />
      <exclusiveGateway id="device-lock-choice" name="是否占用验收设备" default="device-lock-skip" />
      <sequenceFlow id="device-lock-needed" sourceRef="device-lock-choice" targetRef="device-resolve"><conditionExpression xsi:type="tFormalExpression">=inputs.devices and inputs.device != ""</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-lock-skip" sourceRef="device-lock-choice" targetRef="preview" />
      <callActivity id="device-resolve" name="解析验收设备" calledElement="resolve-testbed">
        <extensionElements><coda:param name="device" value="=inputs.device" /></extensionElements>
      </callActivity>
      <sequenceFlow id="device-resolved" sourceRef="device-resolve" targetRef="device-lock" />
      <serviceTask id="device-lock" name="等验收设备" coda:action="hold-group" coda:status="等验收设备 {{inputs.device}}">
        <extensionElements>
          <coda:param name="group" value="=device-resolve.group" />
          <coda:param name="capacity" value="1" />
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="device-lock-acquired" sourceRef="device-lock" targetRef="preview" />
      <userTask id="preview" name="安装预览版" coda:noteLabel="安装结果或回审查的原因">
        <documentation>主 Agent：泳道 {{accept.lane}} 的最新提交是 {{accept.head}}。
{{if preview-result.feedback = null then "" else preview-result.feedback}}
只装改到的那一端：改了 Mac 用 workflow_run 发起 mac-preview-install，改了 iPhone 发起 ios-preview-install，都传 commit="{{accept.head}}"。等发起的安装都成功后答复；有失败先处理，不能把发起当作装好。

{{if inputs.device = "" then "" else "发起 ios-preview-install 时还要传 device=\"" + inputs.device + "\"。安装运行会借本段占着的设备，不另排队。"}}
需要先修改时选「回到审查」，备注必填，说明待处理问题；主 Agent 再用「退回修改」让最近的执行会话继续。预览只装客户端，不从泳道部署后端。</documentation>
        <extensionElements>
          <coda:choice id="installed" name="已装好" primary="true" />
          <coda:choice id="review" name="回到审查" />
        </extensionElements>
      </userTask>
      <sequenceFlow id="preview-result-flow" sourceRef="preview" targetRef="preview-result" />
      <scriptTask id="preview-result" name="读取安装意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
        <extensionElements><coda:env name="PREVIEW" value="=preview" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
        <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" preview</script>
      </scriptTask>
      <sequenceFlow id="preview-route" sourceRef="preview-result" targetRef="after-preview" />
      <exclusiveGateway id="after-preview" name="安装结论" default="preview-device" />
      <sequenceFlow id="preview-note" sourceRef="after-preview" targetRef="preview"><conditionExpression xsi:type="tFormalExpression">=preview-result.route = "preview"</conditionExpression></sequenceFlow>
      <sequenceFlow id="preview-review" sourceRef="after-preview" targetRef="acceptance-return"><conditionExpression xsi:type="tFormalExpression">=preview-result.route = "review"</conditionExpression></sequenceFlow>
      <sequenceFlow id="preview-device" sourceRef="after-preview" targetRef="device" />
      <userTask id="device" name="设备验收" coda:assignee="user" coda:noteLabel="验收意见">
        <documentation>功能：{{lane.title}}
泳道：{{accept.lane}}，提交：{{accept.head}}
主 Agent 的安装结果：{{preview.note}}
{{if device-result.feedback = null then "" else device-result.feedback}}
{{if inputs.device = "" then "" else "验收期间设备 " + inputs.device + " 一直被本段占着。"}}
请在设备上验收。选「不行」必须写具体意见或附上截图，交回主 Agent 审查。</documentation>
        <extensionElements><coda:choice id="yes" name="通过" primary="true" /><coda:choice id="no" name="不行" note="required" /></extensionElements>
      </userTask>
      <sequenceFlow id="device-result-flow" sourceRef="device" targetRef="device-result" />
      <scriptTask id="device-result" name="读取验收意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
        <extensionElements><coda:env name="DEVICE" value="=device" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
        <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" device</script>
      </scriptTask>
      <sequenceFlow id="device-route" sourceRef="device-result" targetRef="after-device" />
      <exclusiveGateway id="after-device" name="验收结论" default="device-pr" />
      <sequenceFlow id="device-note" sourceRef="after-device" targetRef="device"><conditionExpression xsi:type="tFormalExpression">=device-result.route = "device"</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-review" sourceRef="after-device" targetRef="acceptance-return"><conditionExpression xsi:type="tFormalExpression">=device-result.route = "review"</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-pr" sourceRef="after-device" targetRef="acceptance-passed" />
      <endEvent id="acceptance-return"><extensionElements><coda:output name="route" value="return" /></extensionElements></endEvent>
      <endEvent id="acceptance-passed"><extensionElements><coda:output name="route" value="passed" /></extensionElements></endEvent>
    </subProcess>
    <sequenceFlow id="acceptance-finished" sourceRef="acceptance" targetRef="acceptance-route" />
    <exclusiveGateway id="acceptance-route" name="验收段结论" default="acceptance-continue" />
    <sequenceFlow id="acceptance-back" sourceRef="acceptance-route" targetRef="report"><conditionExpression xsi:type="tFormalExpression">=acceptance.route = "return"</conditionExpression></sequenceFlow>
    <sequenceFlow id="acceptance-continue" sourceRef="acceptance-route" targetRef="tell-device" />
    <serviceTask id="tell-device" name="告诉主 Agent 验收通过" coda:action="tell-session">
      <extensionElements>
        <coda:param name="key" value='=run.id + ":device:" + accept.head' />
        <coda:param name="text" value='="功能「" + lane.title + "」：用户设备验收通过，接下来开 PR、跑检查。"' />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="told-device-pr" sourceRef="tell-device" targetRef="pr" />
    <scriptTask id="pr" name="开 PR 或更新汇总" scriptFormat="bash" coda:timeout="5">
      <extensionElements><coda:output name="checked" /><coda:output name="url" /><coda:output name="head" /><coda:output name="summary" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" pr</script>
    </scriptTask>
    <sequenceFlow id="pr-check" sourceRef="pr" targetRef="reuse-checks" />
    <exclusiveGateway id="reuse-checks" name="复用本次开发已通过的提交" default="reuse-missing" />
    <sequenceFlow id="reuse-passed" sourceRef="reuse-checks" targetRef="premerge"><conditionExpression xsi:type="tFormalExpression">=pr.checked = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="reuse-missing" sourceRef="reuse-checks" targetRef="gate" />
    <serviceTask id="checks" name="项目检查" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="check" /><coda:param name="commit" value="=gate.head" /></extensionElements>
    </serviceTask>
    <boundaryEvent id="checks-failed" attachedToRef="checks"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="checks-feedback" sourceRef="checks-failed" targetRef="check-feedback" />
    <scriptTask id="check-feedback" name="自动退回检查失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" gate-failed</script>
    </scriptTask>
    <sequenceFlow id="checks-review" sourceRef="check-feedback" targetRef="gate-route" />
    <sequenceFlow id="checks-github" sourceRef="checks" targetRef="gate-passed" />
    <serviceTask id="premerge" name="合并前检查" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="premerge" /><coda:param name="commit" value="=pr.head" /></extensionElements>
    </serviceTask>
    <boundaryEvent id="premerge-failed" attachedToRef="premerge"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="premerge-feedback-flow" sourceRef="premerge-failed" targetRef="premerge-feedback" />
    <scriptTask id="premerge-feedback" name="交回合并前检查失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="STEP" value="合并前检查" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" check-failed</script>
    </scriptTask>
    <sequenceFlow id="premerge-review" sourceRef="premerge-feedback" targetRef="report" />
    <sequenceFlow id="premerge-github" sourceRef="premerge" targetRef="github-checks" />
    <scriptTask id="github-checks" name="GitHub 检查" scriptFormat="bash" coda:timeout="60">
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" github-checks</script>
    </scriptTask>
    <boundaryEvent id="github-checks-failed" attachedToRef="github-checks"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="github-checks-feedback" sourceRef="github-checks-failed" targetRef="github-feedback" />
    <scriptTask id="github-feedback" name="交回 GitHub 检查失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="STEP" value="GitHub 检查" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" check-failed</script>
    </scriptTask>
    <sequenceFlow id="github-review" sourceRef="github-feedback" targetRef="report" />
    <sequenceFlow id="github-delivery-choice" sourceRef="github-checks" targetRef="delivery-choice" />
    <exclusiveGateway id="delivery-choice" name="是否归属需求" default="checks-kinds" />
    <sequenceFlow id="checks-delivery" sourceRef="delivery-choice" targetRef="delivery"><conditionExpression xsi:type="tFormalExpression">=inputs.delivery != ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="checks-kinds" sourceRef="delivery-choice" targetRef="kinds" />
    <userTask id="delivery" name="待交付" coda:noteLabel="需求验收的修改意见">
      <documentation>所属需求：{{inputs.delivery}}
PR：{{pr.url}}
head：{{pr.head}}
泳道：{{accept.lane}}
项目检查、合并前检查和 GitHub 检查已通过。
{{if delivery-result.feedback = null then "" else delivery-result.feedback}}
主 Agent：请按所属需求运行的安排处理。需求验收不过时选「退回修改」，备注必填，意见交回主 Agent 审查，再退给执行者；修好后重新审查、更新 PR、跑检查并回到待交付。
按需求运行的顺序选择「放行合并」，随后 squash 合并，输出合并提交并结束，不部署。

{{pr.summary}}</documentation>
      <extensionElements>
        <coda:choice id="revise" name="退回修改" />
        <coda:choice id="merge" name="放行合并" primary="true" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="delivery-result-flow" sourceRef="delivery" targetRef="delivery-result" />
    <scriptTask id="delivery-result" name="读取交付意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="DELIVERY_RESULT" value="=delivery" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" delivery</script>
    </scriptTask>
    <sequenceFlow id="delivery-route" sourceRef="delivery-result" targetRef="after-delivery" />
    <exclusiveGateway id="after-delivery" name="交付结论" default="delivery-merge" />
    <sequenceFlow id="delivery-note" sourceRef="after-delivery" targetRef="delivery"><conditionExpression xsi:type="tFormalExpression">=delivery-result.route = "delivery"</conditionExpression></sequenceFlow>
    <sequenceFlow id="delivery-review" sourceRef="after-delivery" targetRef="report"><conditionExpression xsi:type="tFormalExpression">=delivery-result.route = "review"</conditionExpression></sequenceFlow>
    <sequenceFlow id="delivery-merge" sourceRef="after-delivery" targetRef="merge" />
    <serviceTask id="kinds" name="项目部署与发布选项" coda:action="workflow-kinds">
      <extensionElements><coda:param name="commit" value="=pr.head" /></extensionElements>
    </serviceTask>
    <sequenceFlow id="kinds-approve" sourceRef="kinds" targetRef="approve" />
    <userTask id="approve" name="批准合并" coda:noteLabel="备注（可选）" coda:assignee="user">
      <documentation>{{pr.summary}}

{{if inputs.devices then "设备验收、" else ""}}项目检查、合并前检查、GitHub 检查已通过。
PR：{{pr.url}}
批准后 squash 合并，随后按勾选依次部署、发布预览版、发布正式版，每类一次；选项只在项目有对应流程时出现，默认不勾。
勾选发布时备注即发布说明，不填由主 Agent 写。「暂不合并」须写明原因，交给主 Agent 跟进。</documentation>
      <extensionElements>
        <coda:choice id="merge" name="合并" primary="true"><coda:option id="deploy" name="部署" detail="调用项目里的部署流程" coda:shown="=kinds.deploy" />
          <coda:option id="preview" name="发布预览版" detail="调用项目里的预览发布流程" coda:shown="=kinds.preview" />
          <coda:option id="release" name="发布正式版" detail="调用项目里的正式发布流程" coda:shown="=kinds.release" />
          <coda:option id="notify" name="全部完成后通知 Agent" default="true" />
        </coda:choice>
        <coda:choice id="stop" name="暂不合并" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="approve-route" sourceRef="approve" targetRef="approval-result" />
    <scriptTask id="approval-result" name="检查发布说明" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="APPROVAL" value="=approve" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" approval</script>
    </scriptTask>
    <sequenceFlow id="approval-validated" sourceRef="approval-result" targetRef="after-approval" />
    <exclusiveGateway id="after-approval" name="是否合并" default="approval-merge" />
    <sequenceFlow id="approval-missing" sourceRef="after-approval" targetRef="write-notes"><conditionExpression xsi:type="tFormalExpression">=approval-result.route = "notes"</conditionExpression></sequenceFlow>
    <sequenceFlow id="approval-stop" sourceRef="after-approval" targetRef="stopped"><conditionExpression xsi:type="tFormalExpression">=approve.chose.stop</conditionExpression></sequenceFlow>
    <sequenceFlow id="approval-merge" sourceRef="after-approval" targetRef="merge" />
    <userTask id="write-notes" name="写发布说明" coda:noteLabel="发布说明（必填）">
      <documentation>已勾选发布类别：{{if approve.options.preview then "预览版" else ""}} {{if approve.options.release then "正式版" else ""}}
PR：{{pr.url}}
提交：{{pr.head}}
请主 Agent 按上次公开版本以来合并的改动，写面向用户的发布说明，备注必填。请结合本次批准的改动，不要使用审查意见作为发布说明。
{{if notes-result.feedback = null then "" else notes-result.feedback}}</documentation>
      <extensionElements><coda:choice id="ready" name="说明已写好" primary="true" /></extensionElements>
    </userTask>
    <sequenceFlow id="write-notes-result" sourceRef="write-notes" targetRef="notes-result" />
    <scriptTask id="notes-result" name="记录发布说明" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="NOTES" value="=write-notes" /><coda:output name="route" /><coda:output name="feedback" /><coda:output name="notes" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" notes</script>
    </scriptTask>
    <sequenceFlow id="notes-result-route" sourceRef="notes-result" targetRef="notes-route" />
    <exclusiveGateway id="notes-route" name="发布说明是否填写" default="notes-ready" />
    <sequenceFlow id="notes-missing" sourceRef="notes-route" targetRef="write-notes"><conditionExpression xsi:type="tFormalExpression">=notes-result.route = "notes"</conditionExpression></sequenceFlow>
    <sequenceFlow id="notes-ready" sourceRef="notes-route" targetRef="merge" />
    <endEvent id="stopped" name="暂不合并" />
    <scriptTask id="merge" name="Squash 合并" scriptFormat="bash" coda:timeout="10">
      <extensionElements><coda:output name="commit" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" merge</script>
    </scriptTask>
    <sequenceFlow id="merge-route" sourceRef="merge" targetRef="after-merge" />
    <exclusiveGateway id="after-merge" name="是否合并冲突" default="merge-deploy-choice" />
    <sequenceFlow id="merge-conflict" sourceRef="after-merge" targetRef="report"><conditionExpression xsi:type="tFormalExpression">=merge.route = "conflict"</conditionExpression></sequenceFlow>
    <sequenceFlow id="merge-deploy-choice" sourceRef="after-merge" targetRef="deploy-choice" />
    <exclusiveGateway id="deploy-choice" name="是否部署" default="merged-preview" />
    <sequenceFlow id="merged-only" sourceRef="deploy-choice" targetRef="done"><conditionExpression xsi:type="tFormalExpression">=inputs.delivery != ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="merged-deploy" sourceRef="deploy-choice" targetRef="deploy"><conditionExpression xsi:type="tFormalExpression">=approve.options.deploy</conditionExpression></sequenceFlow>
    <sequenceFlow id="merged-preview" sourceRef="deploy-choice" targetRef="publish-preview-choice" />
    <serviceTask id="deploy" name="部署" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="deploy" /><coda:param name="commit" value="=merge.commit" /></extensionElements>
    </serviceTask>
    <sequenceFlow id="deployed" sourceRef="deploy" targetRef="publish-preview-choice" />
    <exclusiveGateway id="publish-preview-choice" name="是否发布预览版" default="skip-publish-preview" />
    <sequenceFlow id="to-publish-preview" sourceRef="publish-preview-choice" targetRef="publish-preview"><conditionExpression xsi:type="tFormalExpression">=approve.options.preview</conditionExpression></sequenceFlow>
    <sequenceFlow id="skip-publish-preview" sourceRef="publish-preview-choice" targetRef="publish-release-choice" />
    <serviceTask id="publish-preview" name="发布预览版" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="preview" /><coda:param name="commit" value="=merge.commit" /><coda:param name="inputs" value='={ notes: if approval-result.route = "notes" then notes-result.notes else approve.note }' /></extensionElements>
    </serviceTask>
    <sequenceFlow id="published-preview" sourceRef="publish-preview" targetRef="publish-release-choice" />
    <exclusiveGateway id="publish-release-choice" name="是否发布正式版" default="skip-publish-release" />
    <sequenceFlow id="to-publish-release" sourceRef="publish-release-choice" targetRef="publish-release"><conditionExpression xsi:type="tFormalExpression">=approve.options.release</conditionExpression></sequenceFlow>
    <sequenceFlow id="skip-publish-release" sourceRef="publish-release-choice" targetRef="done" />
    <serviceTask id="publish-release" name="发布正式版" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="release" /><coda:param name="commit" value="=merge.commit" /><coda:param name="inputs" value='={ publish: "true", notes: if approval-result.route = "notes" then notes-result.notes else approve.note }' /></extensionElements>
    </serviceTask>
    <sequenceFlow id="published-release" sourceRef="publish-release" targetRef="done" />
    <endEvent id="done" name="已完成" coda:notify='=if inputs.delivery != "" then true else approve.options.notify'><extensionElements><coda:output name="pr" value="=pr.url" /><coda:output name="commit" value="=merge.commit" /><coda:output name="notify" value='=if inputs.delivery != "" then true else approve.options.notify' /></extensionElements></endEvent>
  </process>
</definitions>
