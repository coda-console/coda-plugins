<?xml version="1.0" encoding="UTF-8"?>
<!-- 监督开发（README.md「监督开发」）：一个需求一次运行、一条需求分支 req/<运行 ID>。主 Agent 在「需求进行中」派块（callActivity 调 piece，一次一块）往需求分支里提改动，
     不找用户；提交验收后需求分支先跟上目标分支，再开 PR 进目标分支，检查、整体评审（小问题先交开工执行者就地修）、设备验收后由用户批准一次，
     用合并提交合并，再运行勾选的合并后流程（挂点 merged）。
     收尾的任何失败和「暂不合并」都带着原因回到「需求进行中」。BPMN 2.0，由 Coda 执行（docs/workflows.md）。 -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:coda="https://coda.pub/schema/bpmn/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="develop-definitions" targetNamespace="https://coda.pub/plugins/composer">
  <process id="develop" name="监督开发" isExecutable="true" coda:title='{{if inputs.title = "" then "监督开发" else "需求：" + inputs.title}}'>
    <extensionElements>
      <coda:join hook="develop" />
      <coda:input name="title" label="需求名" default="" description="也是需求分支进目标分支的 PR 标题；留空时由主 Agent 在第一张任务里写" />
      <coda:input name="devices" label="设备验收" type="boolean" default="false" description="改了客户端、要在 Mac 或 iPhone 上验收时打开" />
      <coda:input name="device" label="验收设备" type="string" default="" description="测试机设备名，如 duo-testbed；验收期间独占它；留空不占设备" />
      <coda:input name="hold" label="验收时占用" type="string" default="" description="安装与设备验收期间另外占着的组（容量 1），如项目的需求分支专用后端；留空不占" />
      <coda:input name="delivery" label="所属需求交付" type="string" default="" description="需求交付（deliver）运行的 ID；留空为独立交付" />
      <coda:input name="executor" label="执行者" type="agent" description="每一块的默认执行者，主 Agent 派块时可在备注里换；提交验收时的解冲突、整体评审的小问题也交它；不填则每块都要在备注里写" />
      <coda:input name="executor2" label="备用执行者" type="agent" description="每一块审查卡上「换备用执行者重做」的默认接手人，主 Agent 派块时可在备注里换；不填则不能换人" />
      <coda:input name="reviewer" label="评审者" type="agent" description="评每一块的交付（主 Agent 派块时可在备注里换），提交验收、检查通过后也评一次整条需求分支；不填不评" />
      <coda:input name="reviewer2" label="第二评审者" type="agent" description="与评审者同时评每一块和整条需求分支；不填不评" />
      <coda:input name="reviewer3" label="第三整体评审者" type="agent" description="只评整条需求分支，与前两位同时；不填不评" />
      <coda:input name="base" label="目标分支" default="" description="留空用仓库默认分支" />
    </extensionElements>
    <startEvent id="start" />
    <sequenceFlow id="start-brief" sourceRef="start" targetRef="brief-choice" />
    <!-- 目标是发起时带的需求文字（run.message）。需求名和它都有时直接建需求分支；否则（如用户在会话里开启）第一张任务交给主 Agent，
         不叫醒它，随会话的下一条输入告诉它，由它把聊定的需求写下来。 -->
    <exclusiveGateway id="brief-choice" name="是否已有目标" default="brief-needed" />
    <sequenceFlow id="brief-needed" sourceRef="brief-choice" targetRef="brief" />
    <sequenceFlow id="brief-given" sourceRef="brief-choice" targetRef="req"><conditionExpression xsi:type="tFormalExpression">=inputs.title != "" and run.message != ""</conditionExpression></sequenceFlow>
    <userTask id="brief" name="写需求" coda:wake="false" coda:noteLabel="第一行需求名，空一行后是目标与完成标准">
      <documentation>用户在这个会话里开启了监督开发：一个需求一条需求分支，你是主 Agent，用块把需求一块块交给执行者做、亲自审查后合进需求分支；需求做完提交验收，需求分支开 PR、跑检查，由用户批准一次合并。
现在把和用户聊定的需求写下来：备注第一行是需求名（也是 PR 标题），空一行后是目标与完成标准。之后会给你一张「需求进行中」，写着怎么派块。
{{if run.message = "" then "" else "发起时带的需求：\n" + run.message + "\n"}}设备验收：{{if inputs.devices then "开启" else "未开启"}}{{if inputs.device = "" then "" else "，验收设备 " + inputs.device}}。
{{if brief-result.feedback = null then "" else brief-result.feedback}}</documentation>
      <extensionElements><coda:choice id="start" name="开始" primary="true" note="required" /></extensionElements>
    </userTask>
    <sequenceFlow id="brief-result-flow" sourceRef="brief" targetRef="brief-result" />
    <scriptTask id="brief-result" name="读取需求" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="BRIEF" value="=brief" /><coda:output name="route" /><coda:output name="feedback" /><coda:output name="title" /><coda:output name="goal" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" brief</script>
    </scriptTask>
    <sequenceFlow id="brief-route" sourceRef="brief-result" targetRef="after-brief" />
    <exclusiveGateway id="after-brief" name="需求是否写全" default="brief-req" />
    <sequenceFlow id="brief-again" sourceRef="after-brief" targetRef="brief"><conditionExpression xsi:type="tFormalExpression">=brief-result.route = "brief"</conditionExpression></sequenceFlow>
    <sequenceFlow id="brief-req" sourceRef="after-brief" targetRef="req" />
    <scriptTask id="req" name="建需求分支" scriptFormat="bash" coda:timeout="5" coda:retry="3">
      <extensionElements>
        <coda:env name="TITLE" value='=if inputs.title != "" and run.message != "" then inputs.title else brief-result.title' />
        <coda:env name="GOAL" value='=if inputs.title != "" and run.message != "" then run.message else brief-result.goal' />
        <coda:env name="BASE" value="=inputs.base" />
        <coda:output name="title" /><coda:output name="goal" /><coda:output name="base" /><coda:output name="branch" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" branch</script>
    </scriptTask>
    <sequenceFlow id="req-resume" sourceRef="req" targetRef="resume" />
    <!-- 每次回到「需求进行中」都经过这里，带上回来的原因（第一次为空）。 -->
    <scriptTask id="resume" name="整理回来的原因" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:output name="reason" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" resume</script>
    </scriptTask>
    <sequenceFlow id="resume-progress" sourceRef="resume" targetRef="progress" />
    <userTask id="progress" name="需求进行中" coda:noteLabel="派一块的标题与任务书、给用户的改动汇报，或暂停的原因">
      <documentation>需求：{{req.title}}
目标与完成标准：
{{req.goal}}
需求分支：{{req.branch}}（从 {{req.base}} 建，最后开 PR 进 {{req.base}}）
{{if resume.reason = "" then "" else "回到进行中的原因：\n" + resume.reason + "\n"}}{{if progress-result.feedback = null then "" else progress-result.feedback}}
你是主 Agent，需求由你推进，这期间不找用户。把需求分成几块，用这张任务的答复一块块派给执行者：
- 「派一块」：备注第一行是这一块的标题（也是它合进需求分支那个提交的标题），其后是自足的任务书（背景、范围、验收要求）。流程调用块（piece），执行者从需求分支 head 开工，项目检查、评审后交你审查（块里的任务交到这个会话），合进需求分支后回到这张任务，写着合入的提交和块的运行；块失败或你在块里选了放弃，也带着原因回到这里。
- 「跟上目标分支」：派一块把 {{req.base}} 最新的提交合并进需求分支、解冲突、顺延撞号的迁移版本，以合并提交快进进需求分支，不 squash。备注可不写，写了附在固定任务后面。
- 一次只派一块：派出后等它结束才回到这里，有依赖的按先后派。
块的人选默认用开工时填的（第三整体评审者只评整条需求分支）：
- 执行者：{{if inputs.executor = null then "没填" else inputs.executor.agent + (if inputs.executor.model = null then "" else "，模型 " + inputs.executor.model) + (if inputs.executor.effort = null then "" else "，强度 " + inputs.executor.effort) + (if inputs.executor.mode = null then "" else "，模式 " + inputs.executor.mode)}}
- 备用执行者：{{if inputs.executor2 = null then "没填" else inputs.executor2.agent + (if inputs.executor2.model = null then "" else "，模型 " + inputs.executor2.model) + (if inputs.executor2.effort = null then "" else "，强度 " + inputs.executor2.effort) + (if inputs.executor2.mode = null then "" else "，模式 " + inputs.executor2.mode)}}
- 评审者：{{if inputs.reviewer = null then "没填" else inputs.reviewer.agent + (if inputs.reviewer.model = null then "" else "，模型 " + inputs.reviewer.model) + (if inputs.reviewer.effort = null then "" else "，强度 " + inputs.reviewer.effort) + (if inputs.reviewer.mode = null then "" else "，模式 " + inputs.reviewer.mode)}}
- 第二评审者：{{if inputs.reviewer2 = null then "没填" else inputs.reviewer2.agent + (if inputs.reviewer2.model = null then "" else "，模型 " + inputs.reviewer2.model) + (if inputs.reviewer2.effort = null then "" else "，强度 " + inputs.reviewer2.effort) + (if inputs.reviewer2.mode = null then "" else "，模式 " + inputs.reviewer2.mode)}}
难的或性质不同的块要换人，就在备注最前面照上面的写法写要换的那几行（有执行者名单就从名单选），没写的照旧：冒号后先写 Agent ID，再按需写「模型 …」「强度 …」「模式 …」，逗号隔开，没写的用 Agent 的默认值；备用执行者和评审者写「无」表示这一块不用。例如：
- 执行者：&lt;Agent ID&gt;，模型 &lt;模型&gt;，强度 &lt;强度&gt;
- 评审者：无
写法看不懂、或开工没填执行者备注里也没写时，不派，带着原因回到这里。
中途想先看效果：可以用需求分支的提交发起 mac-preview-install、ios-preview-install（传 commit），或对需求分支 head 跑一次合并前检查（加入挂点 premerge 的流程）。
需求做完、要合的块都合进需求分支后选「提交验收」：流程先让需求分支跟上 {{req.base}}（能快进就快进，能干净合并就做合并提交，有冲突交开工执行者合并），再开或更新需求分支进 {{req.base}} 的 PR，跑项目检查（同一 head 复用）、合并前检查与 GitHub 检查，{{if inputs.reviewer = null and inputs.reviewer2 = null and inputs.reviewer3 = null then "" else "整体评审一次（只有测试、文档、风格类的小问题时先交开工执行者就地修、原评审者复评），"}}{{if inputs.delivery = "" then (if inputs.devices then "再交用户设备验收，" else "") + "最后由用户批准合并（合并提交）。任何失败和用户的「暂不合并」都带着原因回到这里。" else "之后进入「待交付」，由需求交付运行 " + inputs.delivery + " 统一验收、批准，没有用户的「暂不合并」。任何失败和待交付的「退回修改」都带着原因回到这里。"}}
「提交验收」备注必填，写给用户的改动汇报，会原样放在批准卡和 PR 描述最上面。约 8 行以内，只写用户能感知的变化和动到的端，不放实现细节、测试数量、文件清单，不贴代码：
做了什么
- …（3～5 条）
需要你知道：…（风险、没做的、顺带改的；没有写「无」）
「暂停」备注必填，写为什么停、等什么；这张任务转成用户手上的「需求已暂停」，由用户选继续或放弃。
「放弃」结束这次需求运行，需求分支保留。</documentation>
      <extensionElements>
        <coda:choice id="submit" name="提交验收" primary="true" note="required" />
        <coda:choice id="piece" name="派一块" note="required" />
        <coda:choice id="sync" name="跟上目标分支" />
        <coda:choice id="pause" name="暂停" note="required" />
        <coda:choice id="abandon" name="放弃" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="progress-result-flow" sourceRef="progress" targetRef="progress-result" />
    <scriptTask id="progress-result" name="读取进行中的答复" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="PROGRESS" value="=progress" /><coda:env name="FIXER" value="=inputs.executor != null" />
        <coda:output name="route" /><coda:output name="feedback" /><coda:output name="title" /><coda:output name="task" /><coda:output name="sync" />
        <coda:output name="executor" /><coda:output name="executorModel" /><coda:output name="executorEffort" /><coda:output name="executorMode" /><coda:output name="executor2" /><coda:output name="executor2Model" /><coda:output name="executor2Effort" /><coda:output name="executor2Mode" /><coda:output name="reviewer" /><coda:output name="reviewerModel" /><coda:output name="reviewerEffort" /><coda:output name="reviewerMode" /><coda:output name="reviewer2" /><coda:output name="reviewer2Model" /><coda:output name="reviewer2Effort" /><coda:output name="reviewer2Mode" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" progress</script>
    </scriptTask>
    <sequenceFlow id="progress-route" sourceRef="progress-result" targetRef="after-progress" />
    <exclusiveGateway id="after-progress" name="派块、提交验收、暂停还是放弃" default="progress-submit" />
    <sequenceFlow id="progress-note" sourceRef="after-progress" targetRef="progress"><conditionExpression xsi:type="tFormalExpression">=progress-result.route = "progress"</conditionExpression></sequenceFlow>
    <sequenceFlow id="progress-piece" sourceRef="after-progress" targetRef="piece"><conditionExpression xsi:type="tFormalExpression">=progress-result.route = "piece"</conditionExpression></sequenceFlow>
    <sequenceFlow id="progress-pause" sourceRef="after-progress" targetRef="paused"><conditionExpression xsi:type="tFormalExpression">=progress-result.route = "pause"</conditionExpression></sequenceFlow>
    <sequenceFlow id="progress-abandon" sourceRef="after-progress" targetRef="abandoned"><conditionExpression xsi:type="tFormalExpression">=progress-result.route = "abandon"</conditionExpression></sequenceFlow>
    <!-- 派块：调用块（piece），是本运行的子运行（取消需求运行时一起停，运行页「调用的流程」列出每一块），它的人工任务照旧交给发起需求运行的会话。
         人选默认取开工值，备注里换了的由答复里的标量拼成 agent 对象（参数保留表达式的类型，对象原样传给 agent 参数）。
         一次一块，结束后回到「需求进行中」：合进了带上提交和块的运行，没合进（失败、被取消、主 Agent 在块里放弃）带着原因。 -->
    <callActivity id="piece" name="块" calledElement="piece">
      <extensionElements>
        <coda:param name="branch" value="=req.branch" />
        <coda:param name="base" value="=req.base" />
        <coda:param name="title" value="=progress-result.title" />
        <coda:param name="task" value="=progress-result.task" />
        <coda:param name="sync" value="=progress-result.sync" />
          <coda:param name="executor" value='=if progress-result.executor = "" then inputs.executor else if progress-result.executor = "无" then null else context merge([{agent: progress-result.executor}, if progress-result.executorModel = "" then {} else {model: progress-result.executorModel}, if progress-result.executorEffort = "" then {} else {effort: progress-result.executorEffort}, if progress-result.executorMode = "" then {} else {mode: progress-result.executorMode}])' />
          <coda:param name="executor2" value='=if progress-result.executor2 = "" then inputs.executor2 else if progress-result.executor2 = "无" then null else context merge([{agent: progress-result.executor2}, if progress-result.executor2Model = "" then {} else {model: progress-result.executor2Model}, if progress-result.executor2Effort = "" then {} else {effort: progress-result.executor2Effort}, if progress-result.executor2Mode = "" then {} else {mode: progress-result.executor2Mode}])' />
          <coda:param name="reviewer" value='=if progress-result.reviewer = "" then inputs.reviewer else if progress-result.reviewer = "无" then null else context merge([{agent: progress-result.reviewer}, if progress-result.reviewerModel = "" then {} else {model: progress-result.reviewerModel}, if progress-result.reviewerEffort = "" then {} else {effort: progress-result.reviewerEffort}, if progress-result.reviewerMode = "" then {} else {mode: progress-result.reviewerMode}])' />
          <coda:param name="reviewer2" value='=if progress-result.reviewer2 = "" then inputs.reviewer2 else if progress-result.reviewer2 = "无" then null else context merge([{agent: progress-result.reviewer2}, if progress-result.reviewer2Model = "" then {} else {model: progress-result.reviewer2Model}, if progress-result.reviewer2Effort = "" then {} else {effort: progress-result.reviewer2Effort}, if progress-result.reviewer2Mode = "" then {} else {mode: progress-result.reviewer2Mode}])' />
      </extensionElements>
    </callActivity>
    <boundaryEvent id="piece-failed" attachedToRef="piece"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="piece-failed-flow" sourceRef="piece-failed" targetRef="piece-lost" />
    <scriptTask id="piece-lost" name="交回没合进的块" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="TITLE" value="=progress-result.title" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" piece-failed</script>
    </scriptTask>
    <sequenceFlow id="piece-lost-resume" sourceRef="piece-lost" targetRef="resume" />
    <sequenceFlow id="piece-done" sourceRef="piece" targetRef="piece-landed" />
    <scriptTask id="piece-landed" name="记下合进的块" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="TITLE" value="=progress-result.title" /><coda:env name="COMMIT" value="=piece.commit" /><coda:env name="PIECE_RUN" value="=piece.run" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" piece-landed</script>
    </scriptTask>
    <sequenceFlow id="piece-landed-resume" sourceRef="piece-landed" targetRef="resume" />
    <sequenceFlow id="progress-submit" sourceRef="after-progress" targetRef="sync" />
    <userTask id="paused" name="需求已暂停" coda:assignee="user" coda:noteLabel="附言（可选）">
      <documentation>需求：{{req.title}}
需求分支：{{req.branch}}
主 Agent 暂停了这个需求：
{{progress.note}}
选「继续」交回主 Agent 接着推进，附言随原因一起交给它；选「放弃」结束这次需求运行，需求分支保留。</documentation>
      <extensionElements>
        <coda:choice id="continue" name="继续" primary="true" />
        <coda:choice id="abandon" name="放弃" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="paused-result-flow" sourceRef="paused" targetRef="paused-result" />
    <scriptTask id="paused-result" name="读取暂停的答复" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="PAUSED" value="=paused" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" paused</script>
    </scriptTask>
    <sequenceFlow id="paused-route" sourceRef="paused-result" targetRef="after-paused" />
    <exclusiveGateway id="after-paused" name="继续还是放弃" default="paused-continue" />
    <sequenceFlow id="paused-abandon" sourceRef="after-paused" targetRef="abandoned"><conditionExpression xsi:type="tFormalExpression">=paused-result.route = "abandon"</conditionExpression></sequenceFlow>
    <sequenceFlow id="paused-continue" sourceRef="after-paused" targetRef="resume" />
    <endEvent id="abandoned" name="已放弃" coda:notify="true" />

    <!-- 提交验收先跟上目标分支：需求分支已包含它不动，是它的祖先就快进，分叉能干净合并就做保留双亲的合并提交，都是普通推送（不 force）；
         有冲突交开工执行者从需求分支 head 合并、解冲突（只合并不变基），没填执行者、推送被拒（需求分支被别人推进了）都带着原因回到进行中。
         之后新 head 照常跑全部检查。 -->
    <scriptTask id="sync" name="跟上目标分支" scriptFormat="bash" coda:timeout="5">
      <extensionElements><coda:env name="FIXER" value="=inputs.executor != null" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" sync-base</script>
    </scriptTask>
    <sequenceFlow id="sync-route" sourceRef="sync" targetRef="after-sync" />
    <exclusiveGateway id="after-sync" name="跟上目标分支之后" default="sync-pr" />
    <sequenceFlow id="sync-conflict" sourceRef="after-sync" targetRef="sync-resolve"><conditionExpression xsi:type="tFormalExpression">=sync.route = "resolve"</conditionExpression></sequenceFlow>
    <sequenceFlow id="sync-progress" sourceRef="after-sync" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=sync.route = "progress"</conditionExpression></sequenceFlow>
    <sequenceFlow id="sync-pr" sourceRef="after-sync" targetRef="pr" />
    <scriptTask id="sync-resolve" name="执行者合并目标分支" scriptFormat="bash">
      <extensionElements><coda:env name="EXECUTOR" value="=inputs.executor" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" sync-resolve</script>
    </scriptTask>
    <sequenceFlow id="sync-resolve-route" sourceRef="sync-resolve" targetRef="after-sync-resolve" />
    <exclusiveGateway id="after-sync-resolve" name="执行者合并之后" default="sync-resolve-pr" />
    <sequenceFlow id="sync-resolve-progress" sourceRef="after-sync-resolve" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=sync-resolve.route = "progress"</conditionExpression></sequenceFlow>
    <sequenceFlow id="sync-resolve-pr" sourceRef="after-sync-resolve" targetRef="pr" />

    <scriptTask id="pr" name="开 PR 或更新汇总" scriptFormat="bash" coda:timeout="5" coda:retry="3">
      <extensionElements>
        <coda:output name="checked" /><coda:output name="url" /><coda:output name="head" /><coda:output name="base" /><coda:output name="branch" /><coda:output name="summary" /><coda:output name="task" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" pr</script>
    </scriptTask>
    <sequenceFlow id="pr-fork-flow" sourceRef="pr" targetRef="pr-fork" />
    <!-- 需求分支 head 也是随后验收要装的：独立交付开了设备验收时，在检查的同时调用项目加入挂点 prebuild 的预编流程，不等它，也不管它成败。 -->
    <parallelGateway id="pr-fork" />
    <sequenceFlow id="pr-check" sourceRef="pr-fork" targetRef="reuse-checks" />
    <sequenceFlow id="pr-fork-prebuild" sourceRef="pr-fork" targetRef="prebuild-choice" />
    <exclusiveGateway id="prebuild-choice" name="是否预编验收要装的" default="prebuild-skip" />
    <sequenceFlow id="prebuild-needed" sourceRef="prebuild-choice" targetRef="prebuild"><conditionExpression xsi:type="tFormalExpression">=inputs.devices and inputs.delivery = ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="prebuild-skip" sourceRef="prebuild-choice" targetRef="prebuilt" />
    <serviceTask id="prebuild" name="预编验收要装的" coda:action="run-workflows">
      <extensionElements><coda:param name="hook" value="prebuild" /><coda:param name="commit" value="=pr.head" /><coda:param name="inputs" value='=if inputs.device = "" then {} else { device: inputs.device }' /></extensionElements>
    </serviceTask>
    <boundaryEvent id="prebuild-failed" attachedToRef="prebuild"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="prebuild-failed-done" sourceRef="prebuild-failed" targetRef="prebuilt" />
    <sequenceFlow id="prebuild-done" sourceRef="prebuild" targetRef="prebuilt" />
    <endEvent id="prebuilt" />
    <!-- 项目检查已在各块上跑过；需求分支 head 是这次运行已通过检查的同一提交时复用，否则在它上面跑一次。 -->
    <exclusiveGateway id="reuse-checks" name="复用本次运行已通过的提交" default="reuse-missing" />
    <sequenceFlow id="reuse-passed" sourceRef="reuse-checks" targetRef="premerge"><conditionExpression xsi:type="tFormalExpression">=pr.checked = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="reuse-missing" sourceRef="reuse-checks" targetRef="checks" />
    <serviceTask id="checks" name="项目检查" coda:action="run-workflows">
      <extensionElements><coda:param name="hook" value="check" /><coda:param name="commit" value="=pr.head" /></extensionElements>
    </serviceTask>
    <boundaryEvent id="checks-failed" attachedToRef="checks"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="checks-feedback-flow" sourceRef="checks-failed" targetRef="checks-feedback" />
    <scriptTask id="checks-feedback" name="交回项目检查失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="STEP" value="项目检查" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" check-failed</script>
    </scriptTask>
    <sequenceFlow id="checks-progress" sourceRef="checks-feedback" targetRef="resume" />
    <sequenceFlow id="checks-done" sourceRef="checks" targetRef="checks-passed" />
    <scriptTask id="checks-passed" name="记录通过的检查" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RUNS" value="=checks.runs" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" checks-passed</script>
    </scriptTask>
    <sequenceFlow id="checks-premerge" sourceRef="checks-passed" targetRef="premerge" />
    <serviceTask id="premerge" name="合并前检查" coda:action="run-workflows">
      <extensionElements><coda:param name="hook" value="premerge" /><coda:param name="commit" value="=pr.head" /></extensionElements>
    </serviceTask>
    <boundaryEvent id="premerge-failed" attachedToRef="premerge"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="premerge-feedback-flow" sourceRef="premerge-failed" targetRef="premerge-feedback" />
    <scriptTask id="premerge-feedback" name="交回合并前检查失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="STEP" value="合并前检查" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" check-failed</script>
    </scriptTask>
    <sequenceFlow id="premerge-progress" sourceRef="premerge-feedback" targetRef="resume" />
    <sequenceFlow id="premerge-github" sourceRef="premerge" targetRef="github-checks" />
    <scriptTask id="github-checks" name="GitHub 检查" scriptFormat="bash" coda:timeout="60" coda:retry="3">
      <extensionElements><coda:output name="evidence" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" github-checks</script>
    </scriptTask>
    <boundaryEvent id="github-checks-failed" attachedToRef="github-checks"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="github-checks-feedback" sourceRef="github-checks-failed" targetRef="github-feedback" />
    <scriptTask id="github-feedback" name="交回 GitHub 检查失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="STEP" value="GitHub 检查" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" check-failed</script>
    </scriptTask>
    <sequenceFlow id="github-progress" sourceRef="github-feedback" targetRef="resume" />
    <sequenceFlow id="github-reviews" sourceRef="github-checks" targetRef="reviews-choice" />

    <!-- 整体评审：填了的整体评审者各评一次整条需求分支（目标分支…需求分支 head 的三点 diff），同时进行；评审没完成或调用没成都照常结束。
         之后分流（scripts/triage.mjs 的 triageOverall）：只有 P3 或没有发现直接进验收，P3 写进汇报；只有测试、文档、风格类的 P2 交开工执行者在需求分支上修，
         推送后重跑全部检查、原评审位置增量复评，最多两轮；其余交主 Agent 选「继续验收」或「回到进行中」，卡上附收敛经过。都不填时跳过。 -->
    <exclusiveGateway id="reviews-choice" name="是否整体评审" default="reviews-skip" />
    <sequenceFlow id="reviews-needed" sourceRef="reviews-choice" targetRef="overall-round"><conditionExpression xsi:type="tFormalExpression">=inputs.reviewer != null or inputs.reviewer2 != null or inputs.reviewer3 != null</conditionExpression></sequenceFlow>
    <sequenceFlow id="reviews-skip" sourceRef="reviews-choice" targetRef="acceptance-choice" />
    <!-- 定这一次怎么评：交执行者修过、等复评时增量复评（base 是上次评过的 head，带上次的发现与执行者的回应）；否则对整条需求分支完整评审。 -->
    <scriptTask id="overall-round" name="确定整体评审范围" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="BASE" value="=pr.base" />
        <coda:output name="base" /><coda:output name="previous" /><coda:output name="previous2" /><coda:output name="previous3" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" overall-round</script>
    </scriptTask>
    <sequenceFlow id="overall-round-reviews" sourceRef="overall-round" targetRef="reviews" />
    <subProcess id="reviews" name="整体评审" coda:optional="true">
      <multiInstanceLoopCharacteristics coda:inputCollection='=[{slot: "reviewer", who: inputs.reviewer, previous: overall-round.previous}, {slot: "reviewer2", who: inputs.reviewer2, previous: overall-round.previous2}, {slot: "reviewer3", who: inputs.reviewer3, previous: overall-round.previous3}]' coda:inputElement="slot" />
      <startEvent id="reviews-start" />
      <sequenceFlow id="reviews-enter" sourceRef="reviews-start" targetRef="review-choice" />
      <exclusiveGateway id="review-choice" name="这一位评不评" default="review-skip" />
      <sequenceFlow id="review-needed" sourceRef="review-choice" targetRef="review-call"><conditionExpression xsi:type="tFormalExpression">=slot.who != null</conditionExpression></sequenceFlow>
      <sequenceFlow id="review-skip" sourceRef="review-choice" targetRef="review-skipped" />
      <callActivity id="review-call" name="评审整条需求分支" calledElement="review-commit">
        <extensionElements>
          <coda:param name="base" value="=overall-round.base" />
          <coda:param name="head" value="=pr.head" />
          <coda:param name="task" value="=pr.task" />
          <coda:param name="reviewer" value="=slot.who" />
          <coda:param name="evidence" value="=github-checks.evidence" />
          <coda:param name="previous" value="=slot.previous" />
        </extensionElements>
      </callActivity>
      <boundaryEvent id="review-failed" attachedToRef="review-call"><errorEventDefinition /></boundaryEvent>
      <sequenceFlow id="review-failed-lost" sourceRef="review-failed" targetRef="review-lost" />
      <sequenceFlow id="review-call-done" sourceRef="review-call" targetRef="review-done" />
      <endEvent id="review-skipped"><extensionElements><coda:output name="state" value="skipped" /></extensionElements></endEvent>
      <endEvent id="review-lost"><extensionElements>
        <coda:output name="state" value="lost" /><coda:output name="slot" value="=slot.slot" /><coda:output name="who" value="=slot.who" /><coda:output name="head" value="=pr.head" />
      </extensionElements></endEvent>
      <endEvent id="review-done"><extensionElements>
        <coda:output name="state" value="done" /><coda:output name="slot" value="=slot.slot" /><coda:output name="who" value="=slot.who" /><coda:output name="head" value="=pr.head" />
        <coda:output name="decision" value="=review-call.decision" /><coda:output name="line" value="=review-call.line" /><coda:output name="findings" value="=review-call.findings" /><coda:output name="report" value="=review-call.report" />
        <coda:output name="reviewed" value="=review-call.head" /><coda:output name="resolutions" value="=review-call.resolutions" /><coda:output name="blocking" value="=review-call.blocking" />
      </extensionElements></endEvent>
    </subProcess>
    <sequenceFlow id="reviews-triage" sourceRef="reviews" targetRef="overall-triage" />
    <scriptTask id="overall-triage" name="分流整体评审意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="REVIEWS" value="=reviews" /><coda:env name="SUMMARY" value="=pr.summary" /><coda:env name="FIXER" value="=inputs.executor != null" />
        <coda:output name="route" /><coda:output name="summary" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" overall-triage</script>
    </scriptTask>
    <sequenceFlow id="overall-triage-how" sourceRef="overall-triage" targetRef="overall-triage-route" />
    <exclusiveGateway id="overall-triage-route" name="直接验收、就地修还是交主 Agent" default="overall-triage-review" />
    <sequenceFlow id="overall-triage-accept" sourceRef="overall-triage-route" targetRef="acceptance-choice"><conditionExpression xsi:type="tFormalExpression">=overall-triage.route = "accept"</conditionExpression></sequenceFlow>
    <sequenceFlow id="overall-triage-fix" sourceRef="overall-triage-route" targetRef="overall-fix"><conditionExpression xsi:type="tFormalExpression">=overall-triage.route = "fix"</conditionExpression></sequenceFlow>
    <sequenceFlow id="overall-triage-review" sourceRef="overall-triage-route" targetRef="overall-rounds" />
    <!-- 开工执行者在需求分支上逐条修复或反驳：第一轮从需求分支 head 开会话，之后续同一会话；有新提交就普通推送到需求分支、回到开 PR 重跑全部检查后复评；
         只反驳就直接复评；都没有交主 Agent；推送被拒回到进行中。 -->
    <scriptTask id="overall-fix" name="执行者修整体评审的小问题" scriptFormat="bash">
      <extensionElements><coda:env name="EXECUTOR" value="=inputs.executor" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" overall-fix</script>
    </scriptTask>
    <sequenceFlow id="overall-fix-how" sourceRef="overall-fix" targetRef="overall-fix-route" />
    <exclusiveGateway id="overall-fix-route" name="有没有新提交" default="overall-fix-review" />
    <sequenceFlow id="overall-fix-pr" sourceRef="overall-fix-route" targetRef="pr"><conditionExpression xsi:type="tFormalExpression">=overall-fix.route = "pr"</conditionExpression></sequenceFlow>
    <sequenceFlow id="overall-fix-again" sourceRef="overall-fix-route" targetRef="overall-round"><conditionExpression xsi:type="tFormalExpression">=overall-fix.route = "again"</conditionExpression></sequenceFlow>
    <sequenceFlow id="overall-fix-progress" sourceRef="overall-fix-route" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=overall-fix.route = "progress"</conditionExpression></sequenceFlow>
    <sequenceFlow id="overall-fix-review" sourceRef="overall-fix-route" targetRef="overall-rounds" />
    <scriptTask id="overall-rounds" name="整理整体评审的收敛经过" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:output name="text" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" overall-rounds</script>
    </scriptTask>
    <sequenceFlow id="overall-rounds-reviewed" sourceRef="overall-rounds" targetRef="reviewed" />
    <scriptTask id="reviewed" name="整理整体评审" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="REVIEWS" value="=reviews" /><coda:output name="reviews" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" reviewed</script>
    </scriptTask>
    <sequenceFlow id="reviewed-review" sourceRef="reviewed" targetRef="review" />
    <userTask id="review" name="整体评审结论" coda:noteLabel="回到进行中的说明（可选）">
      <documentation>需求：{{req.title}}
PR：{{pr.url}}
需求分支 head：{{pr.head}}
整体评审者对整条需求分支（{{req.base}}…需求分支 head）的发现：
{{reviewed.reviews}}
{{if overall-rounds.text = "" then "" else "\n收敛经过（小问题先交开工执行者逐条修复或反驳、原评审者复评，编号固定）：\n" + overall-rounds.text + "\n"}}
发现是否成立由你判断。要先修的选「回到进行中」，派一块修好后再提交验收；不必修的选「继续验收」。</documentation>
      <extensionElements>
        <coda:choice id="continue" name="继续验收" primary="true" />
        <coda:choice id="progress" name="回到进行中" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="review-result-flow" sourceRef="review" targetRef="review-result" />
    <scriptTask id="review-result" name="读取整体评审结论" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="REVIEW" value="=review" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" review</script>
    </scriptTask>
    <sequenceFlow id="review-route" sourceRef="review-result" targetRef="after-review" />
    <exclusiveGateway id="after-review" name="整体评审之后" default="review-continue" />
    <sequenceFlow id="review-progress" sourceRef="after-review" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=review-result.route = "progress"</conditionExpression></sequenceFlow>
    <sequenceFlow id="review-continue" sourceRef="after-review" targetRef="acceptance-choice" />

    <exclusiveGateway id="acceptance-choice" name="是否设备验收" default="acceptance-skip" />
    <sequenceFlow id="acceptance-needed" sourceRef="acceptance-choice" targetRef="acceptance"><conditionExpression xsi:type="tFormalExpression">=inputs.devices and inputs.delivery = ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="acceptance-skip" sourceRef="acceptance-choice" targetRef="delivery-choice" />
    <subProcess id="acceptance" name="安装与设备验收" coda:optional="true">
      <startEvent id="acceptance-start" />
      <sequenceFlow id="acceptance-enter" sourceRef="acceptance-start" targetRef="device-lock-choice" />
      <exclusiveGateway id="device-lock-choice" name="是否占用验收设备" default="device-lock-skip" />
      <sequenceFlow id="device-lock-needed" sourceRef="device-lock-choice" targetRef="device-resolve"><conditionExpression xsi:type="tFormalExpression">=inputs.devices and inputs.device != ""</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-lock-skip" sourceRef="device-lock-choice" targetRef="hold-choice" />
      <callActivity id="device-resolve" name="解析验收设备" calledElement="resolve-testbed">
        <extensionElements><coda:param name="device" value="=inputs.device" /></extensionElements>
      </callActivity>
      <sequenceFlow id="device-resolved" sourceRef="device-resolve" targetRef="device-lock" />
      <serviceTask id="device-lock" name="等验收设备" coda:action="hold-group" coda:status="等验收设备 {{inputs.device}}">
        <extensionElements>
          <coda:param name="group" value="=device-resolve.group" />
          <coda:param name="capacity" value="1" />
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="device-lock-acquired" sourceRef="device-lock" targetRef="hold-choice" />
      <!-- 验收时占用（inputs.hold）：先设备后这个组，各处同一顺序，不会互相等住；离开本段就放开。 -->
      <exclusiveGateway id="hold-choice" name="是否另占一个组" default="hold-skip" />
      <sequenceFlow id="hold-needed" sourceRef="hold-choice" targetRef="hold-lock"><conditionExpression xsi:type="tFormalExpression">=inputs.hold != ""</conditionExpression></sequenceFlow>
      <sequenceFlow id="hold-skip" sourceRef="hold-choice" targetRef="preview" />
      <serviceTask id="hold-lock" name="等验收时占用的组" coda:action="hold-group" coda:status="等 {{inputs.hold}}">
        <extensionElements>
          <coda:param name="group" value="=inputs.hold" />
          <coda:param name="capacity" value="1" />
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="hold-acquired" sourceRef="hold-lock" targetRef="preview" />
      <userTask id="preview" name="安装预览版" coda:noteLabel="安装结果或回到进行中的原因">
        <documentation>主 Agent：需求分支 {{pr.branch}} 的最新提交是 {{pr.head}}。
{{if preview-result.feedback = null then "" else preview-result.feedback}}
只装改到的那一端：改了 Mac 用 workflow_run 发起 mac-preview-install，改了 iPhone 发起 ios-preview-install，改了后端且项目允许从需求分支部署后端时按项目的说明发起它的后端部署，都传 commit="{{pr.head}}"。等发起的安装都成功后答复；有失败先处理，不能把发起当作装好。

{{if inputs.device = "" then "" else "发起 ios-preview-install 时还要传 device=\"" + inputs.device + "\"。安装运行会借本段占着的设备，不另排队。"}}
{{if inputs.hold = "" then "" else "本段还占着组 " + inputs.hold + "：你在这张任务里发起、要用这个组的运行借用它，不另排队；别的运行排在本段之后。"}}
需要先修改时选「回到进行中」，备注必填，说明待处理问题；回到「需求进行中」后派一块修好再提交验收。</documentation>
        <extensionElements>
          <coda:choice id="installed" name="已装好" primary="true" />
          <coda:choice id="progress" name="回到进行中" />
        </extensionElements>
      </userTask>
      <sequenceFlow id="preview-result-flow" sourceRef="preview" targetRef="preview-result" />
      <scriptTask id="preview-result" name="读取安装意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
        <extensionElements><coda:env name="PREVIEW" value="=preview" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
        <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" preview</script>
      </scriptTask>
      <sequenceFlow id="preview-route" sourceRef="preview-result" targetRef="after-preview" />
      <exclusiveGateway id="after-preview" name="安装结论" default="preview-device" />
      <sequenceFlow id="preview-note" sourceRef="after-preview" targetRef="preview"><conditionExpression xsi:type="tFormalExpression">=preview-result.route = "preview"</conditionExpression></sequenceFlow>
      <sequenceFlow id="preview-progress" sourceRef="after-preview" targetRef="acceptance-return"><conditionExpression xsi:type="tFormalExpression">=preview-result.route = "progress"</conditionExpression></sequenceFlow>
      <sequenceFlow id="preview-device" sourceRef="after-preview" targetRef="device" />
      <userTask id="device" name="设备验收" coda:assignee="user" coda:noteLabel="验收意见">
        <documentation>需求：{{req.title}}
需求分支：{{pr.branch}}，提交：{{pr.head}}
主 Agent 的安装结果：{{preview.note}}
{{if device-result.feedback = null then "" else device-result.feedback}}
{{if inputs.device = "" then "" else "验收期间设备 " + inputs.device + " 一直被本段占着。"}}
{{if inputs.hold = "" then "" else "验收期间组 " + inputs.hold + " 也一直被本段占着。"}}
请在设备上验收。选「不行」必须写具体意见或附上截图，交回主 Agent，回到需求进行中。</documentation>
        <extensionElements><coda:choice id="yes" name="通过" primary="true" /><coda:choice id="no" name="不行" note="required" /></extensionElements>
      </userTask>
      <sequenceFlow id="device-result-flow" sourceRef="device" targetRef="device-result" />
      <scriptTask id="device-result" name="读取验收意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
        <extensionElements><coda:env name="DEVICE" value="=device" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
        <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" device</script>
      </scriptTask>
      <sequenceFlow id="device-route" sourceRef="device-result" targetRef="after-device" />
      <exclusiveGateway id="after-device" name="验收结论" default="device-passed" />
      <sequenceFlow id="device-note" sourceRef="after-device" targetRef="device"><conditionExpression xsi:type="tFormalExpression">=device-result.route = "device"</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-progress" sourceRef="after-device" targetRef="acceptance-return"><conditionExpression xsi:type="tFormalExpression">=device-result.route = "progress"</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-passed" sourceRef="after-device" targetRef="acceptance-passed" />
      <endEvent id="acceptance-return"><extensionElements><coda:output name="route" value="return" /></extensionElements></endEvent>
      <endEvent id="acceptance-passed"><extensionElements><coda:output name="route" value="passed" /></extensionElements></endEvent>
    </subProcess>
    <sequenceFlow id="acceptance-finished" sourceRef="acceptance" targetRef="acceptance-route" />
    <exclusiveGateway id="acceptance-route" name="验收段结论" default="acceptance-continue" />
    <sequenceFlow id="acceptance-back" sourceRef="acceptance-route" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=acceptance.route = "return"</conditionExpression></sequenceFlow>
    <sequenceFlow id="acceptance-continue" sourceRef="acceptance-route" targetRef="tell-device" />
    <serviceTask id="tell-device" name="告诉主 Agent 验收通过" coda:action="tell-session">
      <extensionElements>
        <coda:param name="key" value='=run.id + ":device:" + pr.head' />
        <coda:param name="text" value='="需求「" + req.title + "」：用户设备验收通过，接下来等用户批准合并。"' />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="told-device" sourceRef="tell-device" targetRef="delivery-choice" />

    <exclusiveGateway id="delivery-choice" name="是否归属需求交付" default="checks-joiners" />
    <sequenceFlow id="checks-delivery" sourceRef="delivery-choice" targetRef="delivery"><conditionExpression xsi:type="tFormalExpression">=inputs.delivery != ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="checks-joiners" sourceRef="delivery-choice" targetRef="joiners" />
    <userTask id="delivery" name="待交付" coda:noteLabel="需求交付验收的修改意见">
      <documentation>所属需求交付：{{inputs.delivery}}
PR：{{pr.url}}
head：{{pr.head}}
需求分支：{{pr.branch}}
项目检查、合并前检查和 GitHub 检查已通过。
{{if delivery-result.feedback = null then "" else delivery-result.feedback}}
主 Agent：请按需求交付运行的安排处理。交付验收不过时选「退回修改」，备注必填，意见带回「需求进行中」；派一块修好后重新提交验收、跑检查并回到待交付。
按需求交付运行的顺序选择「放行合并」，随后以合并提交合并，输出合并提交并结束，不部署。

{{if overall-triage.summary = null then pr.summary else overall-triage.summary}}</documentation>
      <extensionElements>
        <coda:choice id="revise" name="退回修改" />
        <coda:choice id="merge" name="放行合并" primary="true" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="delivery-result-flow" sourceRef="delivery" targetRef="delivery-result" />
    <scriptTask id="delivery-result" name="读取交付意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="DELIVERY_RESULT" value="=delivery" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" delivery</script>
    </scriptTask>
    <sequenceFlow id="delivery-route" sourceRef="delivery-result" targetRef="after-delivery" />
    <exclusiveGateway id="after-delivery" name="交付结论" default="delivery-merge" />
    <sequenceFlow id="delivery-note" sourceRef="after-delivery" targetRef="delivery"><conditionExpression xsi:type="tFormalExpression">=delivery-result.route = "delivery"</conditionExpression></sequenceFlow>
    <sequenceFlow id="delivery-progress" sourceRef="after-delivery" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=delivery-result.route = "progress"</conditionExpression></sequenceFlow>
    <sequenceFlow id="delivery-merge" sourceRef="after-delivery" targetRef="merge" />
    <!-- 合并卡只放做决定用得到的数据和控件：汇总、已通过的检查、PR；勾选项是项目在需求分支 head 上加入挂点 merged 的流程（hook-joiners），默认勾不勾由它们自己声明。 -->
    <serviceTask id="joiners" name="合并后的流程" coda:action="hook-joiners">
      <extensionElements><coda:param name="hook" value="merged" /><coda:param name="commit" value="=pr.head" /></extensionElements>
    </serviceTask>
    <sequenceFlow id="joiners-approve" sourceRef="joiners" targetRef="approve" />
    <userTask id="approve" name="批准合并" coda:noteLabel="备注（可选）" coda:assignee="user">
      <documentation>{{if overall-triage.summary = null then pr.summary else overall-triage.summary}}

{{if inputs.devices then "设备验收、" else ""}}项目检查、合并前检查、GitHub 检查已通过{{if inputs.reviewer = null and inputs.reviewer2 = null and inputs.reviewer3 = null then "" else "，整条需求分支已整体评审"}}。
PR：{{pr.url}}</documentation>
      <extensionElements>
        <coda:choice id="merge" name="合并" primary="true">
          <coda:optionList value="=joiners.list" />
          <coda:option id="notify" name="全部完成后通知 Agent" default="true" />
        </coda:choice>
        <coda:choice id="stop" name="暂不合并" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="approve-route" sourceRef="approve" targetRef="approval-result" />
    <scriptTask id="approval-result" name="读取批准" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="APPROVAL" value="=approve" /><coda:env name="JOINERS" value="=joiners.list" />
        <coda:output name="route" /><coda:output name="only" /><coda:output name="picked" /><coda:output name="inputs" /><coda:output name="missing" /><coda:output name="asks" /><coda:output name="needs" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" approval</script>
    </scriptTask>
    <sequenceFlow id="approval-validated" sourceRef="approval-result" targetRef="after-approval" />
    <exclusiveGateway id="after-approval" name="是否合并" default="approval-merge" />
    <sequenceFlow id="approval-stop" sourceRef="after-approval" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=approval-result.route = "stop"</conditionExpression></sequenceFlow>
    <sequenceFlow id="approval-merge" sourceRef="after-approval" targetRef="merge" />
    <scriptTask id="merge" name="合并" scriptFormat="bash" coda:checkout="false" coda:timeout="10" coda:retry="3">
      <extensionElements><coda:output name="commit" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" merge</script>
    </scriptTask>
    <sequenceFlow id="merge-route" sourceRef="merge" targetRef="after-merge" />
    <exclusiveGateway id="after-merge" name="是否合并冲突" default="merge-merged-choice" />
    <sequenceFlow id="merge-conflict" sourceRef="after-merge" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=merge.route = "conflict"</conditionExpression></sequenceFlow>
    <sequenceFlow id="merge-merged-choice" sourceRef="after-merge" targetRef="merged-choice" />
    <!-- 合并后：成员需求运行不运行合并后的流程；独立交付运行批准卡上勾的（only），它们要的文字卡上没写的先交主 Agent 逐项写。 -->
    <exclusiveGateway id="merged-choice" name="是否运行合并后的流程" default="merged-fill-choice" />
    <sequenceFlow id="merged-only" sourceRef="merged-choice" targetRef="done"><conditionExpression xsi:type="tFormalExpression">=inputs.delivery != "" or approval-result.only = "[]"</conditionExpression></sequenceFlow>
    <sequenceFlow id="merged-fill-choice" sourceRef="merged-choice" targetRef="fill-choice" />
    <exclusiveGateway id="fill-choice" name="是否有没写的文字" default="fill-skip" />
    <sequenceFlow id="fill-needed" sourceRef="fill-choice" targetRef="fill"><conditionExpression xsi:type="tFormalExpression">=approval-result.missing != ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="fill-skip" sourceRef="fill-choice" targetRef="merged-inputs" />
    <userTask id="fill" name="填写合并后流程要的文字" coda:noteLabel="要填的文字">
      <documentation>用户批准合并时勾的流程要一段文字，批准卡上没有写：
{{split(approval-result.asks, "\n")[loopCounter]}}
PR：{{pr.url}}
合并提交：{{merge.commit}}
主 Agent：按这次合并进来的改动写这段面向用户的文字，不用审查意见；备注只放文字本身。
选「这一项这次不跑」（备注可不写）：这段文字不写，要它的流程这次都不跑，其余勾了的照常运行；都不跑了就直接结束。不想发出这段文字、写不出时选它，不要答复 rejected。</documentation>
      <extensionElements><coda:choice id="done" name="已写好" primary="true" note="required" /><coda:choice id="skip" name="这一项这次不跑" /></extensionElements>
      <multiInstanceLoopCharacteristics isSequential="true" coda:inputCollection='=split(approval-result.missing, ",")' coda:inputElement="input" />
    </userTask>
    <sequenceFlow id="fill-inputs" sourceRef="fill" targetRef="merged-inputs" />
    <scriptTask id="merged-inputs" name="整理合并后流程的参数" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="INPUTS" value="=approval-result.inputs" /><coda:env name="MISSING" value="=approval-result.missing" />
        <coda:env name="ASKS" value="=approval-result.asks" /><coda:env name="FILLS" value="=fill" /><coda:env name="NEEDS" value="=approval-result.needs" /><coda:env name="ONLY" value="=approval-result.only" />
        <coda:output name="inputs" /><coda:output name="only" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" inputs</script>
    </scriptTask>
    <sequenceFlow id="merged-inputs-run" sourceRef="merged-inputs" targetRef="left" />
    <exclusiveGateway id="left" name="还有要跑的合并后流程吗" default="left-run" />
    <sequenceFlow id="left-none" sourceRef="left" targetRef="done-none"><conditionExpression xsi:type="tFormalExpression">=merged-inputs.only = "[]"</conditionExpression></sequenceFlow>
    <sequenceFlow id="left-run" sourceRef="left" targetRef="run-merged" />
    <serviceTask id="run-merged" name="合并后的流程" coda:action="run-workflows">
      <extensionElements>
        <coda:param name="hook" value="merged" /><coda:param name="only" value="=merged-inputs.only" />
        <coda:param name="commit" value="=merge.commit" /><coda:param name="inputs" value="=merged-inputs.inputs" />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="run-merged-done" sourceRef="run-merged" targetRef="done" />
    <endEvent id="done-none" name="已完成" coda:status="已完成，没有要跑的合并后流程" coda:notify='=if inputs.delivery != "" then true else approve.options.notify'><extensionElements><coda:output name="pr" value="=pr.url" /><coda:output name="commit" value="=merge.commit" /><coda:output name="notify" value='=if inputs.delivery != "" then true else approve.options.notify' /></extensionElements></endEvent>
    <endEvent id="done" name="已完成" coda:notify='=if inputs.delivery != "" then true else approve.options.notify'><extensionElements><coda:output name="pr" value="=pr.url" /><coda:output name="commit" value="=merge.commit" /><coda:output name="notify" value='=if inputs.delivery != "" then true else approve.options.notify' /></extensionElements></endEvent>
  </process>
</definitions>
