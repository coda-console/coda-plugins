<?xml version="1.0" encoding="UTF-8"?>
<!-- 监督开发（README.md「监督开发」）：一个需求一次运行、一条泳道 lane/<运行 ID>。主 Agent 在「需求进行中」用泳道 PR（lane-pr）往泳道里提改动，
     不找用户；提交验收后泳道开 PR 进目标分支，检查、整体评审、设备验收后由用户批准一次，用合并提交合并，再按勾选部署、发布。
     收尾的任何失败和「暂不合并」都带着原因回到「需求进行中」。BPMN 2.0，由 Coda 执行（docs/workflows.md）。 -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:coda="https://coda.pub/schema/bpmn/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="develop-definitions" targetNamespace="https://coda.pub/plugins/composer">
  <process id="develop" name="监督开发" isExecutable="true" coda:kind="develop" coda:title='{{if inputs.title = "" then "监督开发" else "需求：" + inputs.title}}'>
    <extensionElements>
      <coda:input name="title" label="需求名" default="" description="也是泳道进目标分支的 PR 标题；留空时由主 Agent 在第一张任务里写" />
      <coda:input name="goal" label="目标与完成标准" default="" description="留空时由主 Agent 把和你聊定的需求写成目标与完成标准" />
      <coda:input name="devices" label="设备验收" type="boolean" default="false" description="改了客户端、要在 Mac 或 iPhone 上验收时打开" />
      <coda:input name="device" label="验收设备" type="string" default="" description="测试机设备名，如 duo-testbed；验收期间独占它；留空不占设备" />
      <coda:input name="hold" label="验收时占用" type="string" default="" description="安装与设备验收期间另外占着的组（容量 1），如项目的泳道专用后端；留空不占" />
      <coda:input name="delivery" label="所属需求交付" type="string" default="" description="需求交付（deliver）运行的 ID；留空为独立交付" />
      <coda:input name="reviewer" label="整体评审者" type="agent" description="提交验收、检查通过后评一次整条泳道；不填不评" />
      <coda:input name="reviewer2" label="第二整体评审者" type="agent" description="与整体评审者同时评整条泳道；不填不评" />
      <coda:input name="reviewer3" label="第三整体评审者" type="agent" description="与前两位同时评整条泳道；不填不评" />
      <coda:input name="base" label="目标分支" default="" description="留空用仓库默认分支" />
    </extensionElements>
    <startEvent id="start" />
    <sequenceFlow id="start-brief" sourceRef="start" targetRef="brief-choice" />
    <!-- 用户在会话里开启时没有目标：第一张任务交给主 Agent，不叫醒它，随会话的下一条输入告诉它，由它把聊定的需求写下来。 -->
    <exclusiveGateway id="brief-choice" name="是否已有目标" default="brief-given" />
    <sequenceFlow id="brief-needed" sourceRef="brief-choice" targetRef="brief"><conditionExpression xsi:type="tFormalExpression">=inputs.goal = ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="brief-given" sourceRef="brief-choice" targetRef="lane" />
    <userTask id="brief" name="写需求" coda:wake="false" coda:noteLabel="第一行需求名，空一行后是目标与完成标准">
      <documentation>用户在这个会话里开启了监督开发：一个需求一条泳道，你是主 Agent，用泳道 PR 把需求一块块交给执行者做、亲自审查后合进泳道；需求做完提交验收，泳道开 PR、跑检查，由用户批准一次合并。
现在把和用户聊定的需求写下来：备注第一行是需求名（也是 PR 标题），空一行后是目标与完成标准。之后会给你一张「需求进行中」，写着怎么提泳道 PR。
设备验收：{{if inputs.devices then "开启" else "未开启"}}{{if inputs.device = "" then "" else "，验收设备 " + inputs.device}}。
{{if brief-result.feedback = null then "" else brief-result.feedback}}</documentation>
      <extensionElements><coda:choice id="start" name="开始" primary="true" note="required" /></extensionElements>
    </userTask>
    <sequenceFlow id="brief-result-flow" sourceRef="brief" targetRef="brief-result" />
    <scriptTask id="brief-result" name="读取需求" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="BRIEF" value="=brief" /><coda:output name="route" /><coda:output name="feedback" /><coda:output name="title" /><coda:output name="goal" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" brief</script>
    </scriptTask>
    <sequenceFlow id="brief-route" sourceRef="brief-result" targetRef="after-brief" />
    <exclusiveGateway id="after-brief" name="需求是否写全" default="brief-lane" />
    <sequenceFlow id="brief-again" sourceRef="after-brief" targetRef="brief"><conditionExpression xsi:type="tFormalExpression">=brief-result.route = "brief"</conditionExpression></sequenceFlow>
    <sequenceFlow id="brief-lane" sourceRef="after-brief" targetRef="lane" />
    <scriptTask id="lane" name="建泳道" scriptFormat="bash" coda:timeout="5">
      <extensionElements>
        <coda:env name="TITLE" value='=if inputs.goal = "" then brief-result.title else inputs.title' />
        <coda:env name="GOAL" value='=if inputs.goal = "" then brief-result.goal else inputs.goal' />
        <coda:env name="BASE" value="=inputs.base" />
        <coda:output name="title" /><coda:output name="goal" /><coda:output name="base" /><coda:output name="lane" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" lane</script>
    </scriptTask>
    <sequenceFlow id="lane-resume" sourceRef="lane" targetRef="resume" />
    <!-- 每次回到「需求进行中」都经过这里，带上回来的原因（第一次为空）。 -->
    <scriptTask id="resume" name="整理回来的原因" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:output name="reason" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" resume</script>
    </scriptTask>
    <sequenceFlow id="resume-progress" sourceRef="resume" targetRef="progress" />
    <userTask id="progress" name="需求进行中" coda:noteLabel="给用户的改动汇报，或暂停的原因">
      <documentation>需求：{{lane.title}}
目标与完成标准：
{{lane.goal}}
泳道：{{lane.lane}}（从 {{lane.base}} 建，最后开 PR 进 {{lane.base}}）
{{if resume.reason = "" then "" else "回到进行中的原因：\n" + resume.reason + "\n"}}{{if progress-result.feedback = null then "" else progress-result.feedback}}
你是主 Agent，需求由你推进，这期间不找用户：
- 把需求分成几块，每块用 workflow_run 发起一个泳道 PR（lane-pr）：传 lane="{{run.id}}"、title、task（自足的任务书：背景、范围、验收要求），以及这一块的 executor、executor2、reviewer、reviewer2（由你按这一块的性质逐个定，不传 executor 用你的 Agent）。执行者从泳道 head 开工，项目检查、评审后由你审查，合进泳道后结果回到你的会话。
- 互不依赖的块可以同时发起；有依赖的等前一个合进泳道再发起。并行的泳道 PR 合进泳道前会试合并泳道最新 head，冲突交回执行者。
- 跟上目标分支：发起 sync=true 的泳道 PR，任务写把 origin/{{lane.base}} 合并进来、解冲突、顺延撞号的迁移版本；它快进进泳道，不 squash。
- 中途想先看效果：可以用泳道的提交发起 mac-preview-install、ios-preview-install（传 commit），或对泳道 head 跑一次合并前检查（kind=premerge）。
需求做完、要合的泳道 PR 都合进泳道后选「提交验收」：流程开或更新泳道进 {{lane.base}} 的 PR，跑项目检查（同一 head 复用）、合并前检查与 GitHub 检查，{{if inputs.reviewer = null and inputs.reviewer2 = null and inputs.reviewer3 = null then "" else "整体评审一次，"}}{{if inputs.delivery = "" then (if inputs.devices then "再交用户设备验收，" else "") + "最后由用户批准合并（合并提交）。任何失败和用户的「暂不合并」都带着原因回到这里。" else "之后进入「待交付」，由需求交付运行 " + inputs.delivery + " 统一验收、批准，没有用户的「暂不合并」。任何失败和待交付的「退回修改」都带着原因回到这里。"}}
「提交验收」备注必填，写给用户的改动汇报，会原样放在批准卡和 PR 描述最上面。约 8 行以内，只写用户能感知的变化和动到的端，不放实现细节、测试数量、文件清单，不贴代码：
做了什么
- …（3～5 条）
需要你知道：…（风险、没做的、顺带改的；没有写「无」）
「暂停」备注必填，写为什么停、等什么；这张任务转成用户手上的「需求已暂停」，由用户选继续或放弃。
「放弃」结束这次需求运行，泳道保留。</documentation>
      <extensionElements>
        <coda:choice id="submit" name="提交验收" primary="true" note="required" />
        <coda:choice id="pause" name="暂停" note="required" />
        <coda:choice id="abandon" name="放弃" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="progress-result-flow" sourceRef="progress" targetRef="progress-result" />
    <scriptTask id="progress-result" name="读取进行中的答复" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="PROGRESS" value="=progress" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" progress</script>
    </scriptTask>
    <sequenceFlow id="progress-route" sourceRef="progress-result" targetRef="after-progress" />
    <exclusiveGateway id="after-progress" name="提交验收、暂停还是放弃" default="progress-submit" />
    <sequenceFlow id="progress-note" sourceRef="after-progress" targetRef="progress"><conditionExpression xsi:type="tFormalExpression">=progress-result.route = "progress"</conditionExpression></sequenceFlow>
    <sequenceFlow id="progress-pause" sourceRef="after-progress" targetRef="paused"><conditionExpression xsi:type="tFormalExpression">=progress-result.route = "pause"</conditionExpression></sequenceFlow>
    <sequenceFlow id="progress-abandon" sourceRef="after-progress" targetRef="abandoned"><conditionExpression xsi:type="tFormalExpression">=progress-result.route = "abandon"</conditionExpression></sequenceFlow>
    <sequenceFlow id="progress-submit" sourceRef="after-progress" targetRef="pr" />
    <userTask id="paused" name="需求已暂停" coda:assignee="user" coda:noteLabel="附言（可选）">
      <documentation>需求：{{lane.title}}
泳道：{{lane.lane}}
主 Agent 暂停了这个需求：
{{progress.note}}
选「继续」交回主 Agent 接着推进，附言随原因一起交给它；选「放弃」结束这次需求运行，泳道保留。</documentation>
      <extensionElements>
        <coda:choice id="continue" name="继续" primary="true" />
        <coda:choice id="abandon" name="放弃" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="paused-result-flow" sourceRef="paused" targetRef="paused-result" />
    <scriptTask id="paused-result" name="读取暂停的答复" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="PAUSED" value="=paused" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" paused</script>
    </scriptTask>
    <sequenceFlow id="paused-route" sourceRef="paused-result" targetRef="after-paused" />
    <exclusiveGateway id="after-paused" name="继续还是放弃" default="paused-continue" />
    <sequenceFlow id="paused-abandon" sourceRef="after-paused" targetRef="abandoned"><conditionExpression xsi:type="tFormalExpression">=paused-result.route = "abandon"</conditionExpression></sequenceFlow>
    <sequenceFlow id="paused-continue" sourceRef="after-paused" targetRef="resume" />
    <endEvent id="abandoned" name="已放弃" coda:notify="true" />

    <scriptTask id="pr" name="开 PR 或更新汇总" scriptFormat="bash" coda:timeout="5">
      <extensionElements>
        <coda:output name="checked" /><coda:output name="url" /><coda:output name="head" /><coda:output name="base" /><coda:output name="lane" /><coda:output name="summary" /><coda:output name="task" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" pr</script>
    </scriptTask>
    <sequenceFlow id="pr-fork-flow" sourceRef="pr" targetRef="pr-fork" />
    <!-- 泳道 head 也是随后验收要装的：独立交付开了设备验收时，在检查的同时调用项目的预编流程（coda:kind="prebuild"），不等它，也不管它成败。 -->
    <parallelGateway id="pr-fork" />
    <sequenceFlow id="pr-check" sourceRef="pr-fork" targetRef="reuse-checks" />
    <sequenceFlow id="pr-fork-prebuild" sourceRef="pr-fork" targetRef="prebuild-choice" />
    <exclusiveGateway id="prebuild-choice" name="是否预编验收要装的" default="prebuild-skip" />
    <sequenceFlow id="prebuild-needed" sourceRef="prebuild-choice" targetRef="prebuild"><conditionExpression xsi:type="tFormalExpression">=inputs.devices and inputs.delivery = ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="prebuild-skip" sourceRef="prebuild-choice" targetRef="prebuilt" />
    <serviceTask id="prebuild" name="预编验收要装的" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="prebuild" /><coda:param name="commit" value="=pr.head" /><coda:param name="inputs" value='=if inputs.device = "" then {} else { device: inputs.device }' /></extensionElements>
    </serviceTask>
    <boundaryEvent id="prebuild-failed" attachedToRef="prebuild"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="prebuild-failed-done" sourceRef="prebuild-failed" targetRef="prebuilt" />
    <sequenceFlow id="prebuild-done" sourceRef="prebuild" targetRef="prebuilt" />
    <endEvent id="prebuilt" />
    <!-- 项目检查已在各泳道 PR 上跑过；泳道 head 是这次运行已通过检查的同一提交时复用，否则在它上面跑一次。 -->
    <exclusiveGateway id="reuse-checks" name="复用本次运行已通过的提交" default="reuse-missing" />
    <sequenceFlow id="reuse-passed" sourceRef="reuse-checks" targetRef="premerge"><conditionExpression xsi:type="tFormalExpression">=pr.checked = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="reuse-missing" sourceRef="reuse-checks" targetRef="checks" />
    <serviceTask id="checks" name="项目检查" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="check" /><coda:param name="commit" value="=pr.head" /></extensionElements>
    </serviceTask>
    <boundaryEvent id="checks-failed" attachedToRef="checks"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="checks-feedback-flow" sourceRef="checks-failed" targetRef="checks-feedback" />
    <scriptTask id="checks-feedback" name="交回项目检查失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="STEP" value="项目检查" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" check-failed</script>
    </scriptTask>
    <sequenceFlow id="checks-progress" sourceRef="checks-feedback" targetRef="resume" />
    <sequenceFlow id="checks-done" sourceRef="checks" targetRef="checks-passed" />
    <scriptTask id="checks-passed" name="记录通过的检查" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RUNS" value="=checks.runs" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" checks-passed</script>
    </scriptTask>
    <sequenceFlow id="checks-premerge" sourceRef="checks-passed" targetRef="premerge" />
    <serviceTask id="premerge" name="合并前检查" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="premerge" /><coda:param name="commit" value="=pr.head" /></extensionElements>
    </serviceTask>
    <boundaryEvent id="premerge-failed" attachedToRef="premerge"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="premerge-feedback-flow" sourceRef="premerge-failed" targetRef="premerge-feedback" />
    <scriptTask id="premerge-feedback" name="交回合并前检查失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="STEP" value="合并前检查" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" check-failed</script>
    </scriptTask>
    <sequenceFlow id="premerge-progress" sourceRef="premerge-feedback" targetRef="resume" />
    <sequenceFlow id="premerge-github" sourceRef="premerge" targetRef="github-checks" />
    <scriptTask id="github-checks" name="GitHub 检查" scriptFormat="bash" coda:timeout="60">
      <extensionElements><coda:output name="evidence" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" github-checks</script>
    </scriptTask>
    <boundaryEvent id="github-checks-failed" attachedToRef="github-checks"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="github-checks-feedback" sourceRef="github-checks-failed" targetRef="github-feedback" />
    <scriptTask id="github-feedback" name="交回 GitHub 检查失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="STEP" value="GitHub 检查" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" check-failed</script>
    </scriptTask>
    <sequenceFlow id="github-progress" sourceRef="github-feedback" targetRef="resume" />
    <sequenceFlow id="github-reviews" sourceRef="github-checks" targetRef="reviews-choice" />

    <!-- 整体评审：填了的整体评审者各评一次整条泳道（目标分支…泳道 head 的三点 diff），同时进行；评审没完成或调用没成都照常结束，
         结果交主 Agent 选「继续验收」或「回到进行中」。都不填时跳过。 -->
    <exclusiveGateway id="reviews-choice" name="是否整体评审" default="reviews-skip" />
    <sequenceFlow id="reviews-needed" sourceRef="reviews-choice" targetRef="reviews"><conditionExpression xsi:type="tFormalExpression">=inputs.reviewer != null or inputs.reviewer2 != null or inputs.reviewer3 != null</conditionExpression></sequenceFlow>
    <sequenceFlow id="reviews-skip" sourceRef="reviews-choice" targetRef="acceptance-choice" />
    <subProcess id="reviews" name="整体评审" coda:optional="true">
      <multiInstanceLoopCharacteristics coda:inputCollection='=[{slot: "reviewer", who: inputs.reviewer}, {slot: "reviewer2", who: inputs.reviewer2}, {slot: "reviewer3", who: inputs.reviewer3}]' coda:inputElement="slot" />
      <startEvent id="reviews-start" />
      <sequenceFlow id="reviews-enter" sourceRef="reviews-start" targetRef="review-choice" />
      <exclusiveGateway id="review-choice" name="这一位评不评" default="review-skip" />
      <sequenceFlow id="review-needed" sourceRef="review-choice" targetRef="review-call"><conditionExpression xsi:type="tFormalExpression">=slot.who != null</conditionExpression></sequenceFlow>
      <sequenceFlow id="review-skip" sourceRef="review-choice" targetRef="review-skipped" />
      <callActivity id="review-call" name="评审整条泳道" calledElement="review-commit">
        <extensionElements>
          <coda:param name="base" value="=pr.base" />
          <coda:param name="head" value="=pr.head" />
          <coda:param name="task" value="=pr.task" />
          <coda:param name="reviewer" value="=slot.who" />
          <coda:param name="evidence" value="=github-checks.evidence" />
        </extensionElements>
      </callActivity>
      <boundaryEvent id="review-failed" attachedToRef="review-call"><errorEventDefinition /></boundaryEvent>
      <sequenceFlow id="review-failed-lost" sourceRef="review-failed" targetRef="review-lost" />
      <sequenceFlow id="review-call-done" sourceRef="review-call" targetRef="review-done" />
      <endEvent id="review-skipped"><extensionElements><coda:output name="state" value="skipped" /></extensionElements></endEvent>
      <endEvent id="review-lost"><extensionElements>
        <coda:output name="state" value="lost" /><coda:output name="slot" value="=slot.slot" /><coda:output name="who" value="=slot.who" /><coda:output name="head" value="=pr.head" />
      </extensionElements></endEvent>
      <endEvent id="review-done"><extensionElements>
        <coda:output name="state" value="done" /><coda:output name="slot" value="=slot.slot" /><coda:output name="who" value="=slot.who" /><coda:output name="head" value="=pr.head" />
        <coda:output name="decision" value="=review-call.decision" /><coda:output name="line" value="=review-call.line" /><coda:output name="findings" value="=review-call.findings" /><coda:output name="report" value="=review-call.report" />
      </extensionElements></endEvent>
    </subProcess>
    <sequenceFlow id="reviews-reviewed" sourceRef="reviews" targetRef="reviewed" />
    <scriptTask id="reviewed" name="整理整体评审" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="REVIEWS" value="=reviews" /><coda:output name="reviews" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" reviewed</script>
    </scriptTask>
    <sequenceFlow id="reviewed-review" sourceRef="reviewed" targetRef="review" />
    <userTask id="review" name="整体评审结论" coda:noteLabel="回到进行中的说明（可选）">
      <documentation>需求：{{lane.title}}
PR：{{pr.url}}
泳道 head：{{pr.head}}
整体评审者对整条泳道（{{lane.base}}…泳道 head）的发现：
{{reviewed.reviews}}
发现是否成立由你判断。要先修的选「回到进行中」，提泳道 PR 修好后再提交验收；不必修的选「继续验收」。</documentation>
      <extensionElements>
        <coda:choice id="continue" name="继续验收" primary="true" />
        <coda:choice id="progress" name="回到进行中" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="review-result-flow" sourceRef="review" targetRef="review-result" />
    <scriptTask id="review-result" name="读取整体评审结论" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="REVIEW" value="=review" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" review</script>
    </scriptTask>
    <sequenceFlow id="review-route" sourceRef="review-result" targetRef="after-review" />
    <exclusiveGateway id="after-review" name="整体评审之后" default="review-continue" />
    <sequenceFlow id="review-progress" sourceRef="after-review" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=review-result.route = "progress"</conditionExpression></sequenceFlow>
    <sequenceFlow id="review-continue" sourceRef="after-review" targetRef="acceptance-choice" />

    <exclusiveGateway id="acceptance-choice" name="是否设备验收" default="acceptance-skip" />
    <sequenceFlow id="acceptance-needed" sourceRef="acceptance-choice" targetRef="acceptance"><conditionExpression xsi:type="tFormalExpression">=inputs.devices and inputs.delivery = ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="acceptance-skip" sourceRef="acceptance-choice" targetRef="delivery-choice" />
    <subProcess id="acceptance" name="安装与设备验收" coda:optional="true">
      <startEvent id="acceptance-start" />
      <sequenceFlow id="acceptance-enter" sourceRef="acceptance-start" targetRef="device-lock-choice" />
      <exclusiveGateway id="device-lock-choice" name="是否占用验收设备" default="device-lock-skip" />
      <sequenceFlow id="device-lock-needed" sourceRef="device-lock-choice" targetRef="device-resolve"><conditionExpression xsi:type="tFormalExpression">=inputs.devices and inputs.device != ""</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-lock-skip" sourceRef="device-lock-choice" targetRef="hold-choice" />
      <callActivity id="device-resolve" name="解析验收设备" calledElement="resolve-testbed">
        <extensionElements><coda:param name="device" value="=inputs.device" /></extensionElements>
      </callActivity>
      <sequenceFlow id="device-resolved" sourceRef="device-resolve" targetRef="device-lock" />
      <serviceTask id="device-lock" name="等验收设备" coda:action="hold-group" coda:status="等验收设备 {{inputs.device}}">
        <extensionElements>
          <coda:param name="group" value="=device-resolve.group" />
          <coda:param name="capacity" value="1" />
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="device-lock-acquired" sourceRef="device-lock" targetRef="hold-choice" />
      <!-- 验收时占用（inputs.hold）：先设备后这个组，各处同一顺序，不会互相等住；离开本段就放开。 -->
      <exclusiveGateway id="hold-choice" name="是否另占一个组" default="hold-skip" />
      <sequenceFlow id="hold-needed" sourceRef="hold-choice" targetRef="hold-lock"><conditionExpression xsi:type="tFormalExpression">=inputs.hold != ""</conditionExpression></sequenceFlow>
      <sequenceFlow id="hold-skip" sourceRef="hold-choice" targetRef="preview" />
      <serviceTask id="hold-lock" name="等验收时占用的组" coda:action="hold-group" coda:status="等 {{inputs.hold}}">
        <extensionElements>
          <coda:param name="group" value="=inputs.hold" />
          <coda:param name="capacity" value="1" />
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="hold-acquired" sourceRef="hold-lock" targetRef="preview" />
      <userTask id="preview" name="安装预览版" coda:noteLabel="安装结果或回到进行中的原因">
        <documentation>主 Agent：泳道 {{pr.lane}} 的最新提交是 {{pr.head}}。
{{if preview-result.feedback = null then "" else preview-result.feedback}}
只装改到的那一端：改了 Mac 用 workflow_run 发起 mac-preview-install，改了 iPhone 发起 ios-preview-install，改了后端且项目允许从泳道部署后端时按项目的说明发起它的后端部署，都传 commit="{{pr.head}}"。等发起的安装都成功后答复；有失败先处理，不能把发起当作装好。

{{if inputs.device = "" then "" else "发起 ios-preview-install 时还要传 device=\"" + inputs.device + "\"。安装运行会借本段占着的设备，不另排队。"}}
{{if inputs.hold = "" then "" else "本段还占着组 " + inputs.hold + "：你在这张任务里发起、要用这个组的运行借用它，不另排队；别的运行排在本段之后。"}}
需要先修改时选「回到进行中」，备注必填，说明待处理问题；回到「需求进行中」后提泳道 PR 修好再提交验收。</documentation>
        <extensionElements>
          <coda:choice id="installed" name="已装好" primary="true" />
          <coda:choice id="progress" name="回到进行中" />
        </extensionElements>
      </userTask>
      <sequenceFlow id="preview-result-flow" sourceRef="preview" targetRef="preview-result" />
      <scriptTask id="preview-result" name="读取安装意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
        <extensionElements><coda:env name="PREVIEW" value="=preview" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
        <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" preview</script>
      </scriptTask>
      <sequenceFlow id="preview-route" sourceRef="preview-result" targetRef="after-preview" />
      <exclusiveGateway id="after-preview" name="安装结论" default="preview-device" />
      <sequenceFlow id="preview-note" sourceRef="after-preview" targetRef="preview"><conditionExpression xsi:type="tFormalExpression">=preview-result.route = "preview"</conditionExpression></sequenceFlow>
      <sequenceFlow id="preview-progress" sourceRef="after-preview" targetRef="acceptance-return"><conditionExpression xsi:type="tFormalExpression">=preview-result.route = "progress"</conditionExpression></sequenceFlow>
      <sequenceFlow id="preview-device" sourceRef="after-preview" targetRef="device" />
      <userTask id="device" name="设备验收" coda:assignee="user" coda:noteLabel="验收意见">
        <documentation>需求：{{lane.title}}
泳道：{{pr.lane}}，提交：{{pr.head}}
主 Agent 的安装结果：{{preview.note}}
{{if device-result.feedback = null then "" else device-result.feedback}}
{{if inputs.device = "" then "" else "验收期间设备 " + inputs.device + " 一直被本段占着。"}}
{{if inputs.hold = "" then "" else "验收期间组 " + inputs.hold + " 也一直被本段占着。"}}
请在设备上验收。选「不行」必须写具体意见或附上截图，交回主 Agent，回到需求进行中。</documentation>
        <extensionElements><coda:choice id="yes" name="通过" primary="true" /><coda:choice id="no" name="不行" note="required" /></extensionElements>
      </userTask>
      <sequenceFlow id="device-result-flow" sourceRef="device" targetRef="device-result" />
      <scriptTask id="device-result" name="读取验收意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
        <extensionElements><coda:env name="DEVICE" value="=device" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
        <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" device</script>
      </scriptTask>
      <sequenceFlow id="device-route" sourceRef="device-result" targetRef="after-device" />
      <exclusiveGateway id="after-device" name="验收结论" default="device-passed" />
      <sequenceFlow id="device-note" sourceRef="after-device" targetRef="device"><conditionExpression xsi:type="tFormalExpression">=device-result.route = "device"</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-progress" sourceRef="after-device" targetRef="acceptance-return"><conditionExpression xsi:type="tFormalExpression">=device-result.route = "progress"</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-passed" sourceRef="after-device" targetRef="acceptance-passed" />
      <endEvent id="acceptance-return"><extensionElements><coda:output name="route" value="return" /></extensionElements></endEvent>
      <endEvent id="acceptance-passed"><extensionElements><coda:output name="route" value="passed" /></extensionElements></endEvent>
    </subProcess>
    <sequenceFlow id="acceptance-finished" sourceRef="acceptance" targetRef="acceptance-route" />
    <exclusiveGateway id="acceptance-route" name="验收段结论" default="acceptance-continue" />
    <sequenceFlow id="acceptance-back" sourceRef="acceptance-route" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=acceptance.route = "return"</conditionExpression></sequenceFlow>
    <sequenceFlow id="acceptance-continue" sourceRef="acceptance-route" targetRef="tell-device" />
    <serviceTask id="tell-device" name="告诉主 Agent 验收通过" coda:action="tell-session">
      <extensionElements>
        <coda:param name="key" value='=run.id + ":device:" + pr.head' />
        <coda:param name="text" value='="需求「" + lane.title + "」：用户设备验收通过，接下来等用户批准合并。"' />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="told-device" sourceRef="tell-device" targetRef="delivery-choice" />

    <exclusiveGateway id="delivery-choice" name="是否归属需求交付" default="checks-kinds" />
    <sequenceFlow id="checks-delivery" sourceRef="delivery-choice" targetRef="delivery"><conditionExpression xsi:type="tFormalExpression">=inputs.delivery != ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="checks-kinds" sourceRef="delivery-choice" targetRef="kinds" />
    <userTask id="delivery" name="待交付" coda:noteLabel="需求交付验收的修改意见">
      <documentation>所属需求交付：{{inputs.delivery}}
PR：{{pr.url}}
head：{{pr.head}}
泳道：{{pr.lane}}
项目检查、合并前检查和 GitHub 检查已通过。
{{if delivery-result.feedback = null then "" else delivery-result.feedback}}
主 Agent：请按需求交付运行的安排处理。交付验收不过时选「退回修改」，备注必填，意见带回「需求进行中」；提泳道 PR 修好后重新提交验收、跑检查并回到待交付。
按需求交付运行的顺序选择「放行合并」，随后以合并提交合并，输出合并提交并结束，不部署。

{{pr.summary}}</documentation>
      <extensionElements>
        <coda:choice id="revise" name="退回修改" />
        <coda:choice id="merge" name="放行合并" primary="true" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="delivery-result-flow" sourceRef="delivery" targetRef="delivery-result" />
    <scriptTask id="delivery-result" name="读取交付意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="DELIVERY_RESULT" value="=delivery" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" delivery</script>
    </scriptTask>
    <sequenceFlow id="delivery-route" sourceRef="delivery-result" targetRef="after-delivery" />
    <exclusiveGateway id="after-delivery" name="交付结论" default="delivery-merge" />
    <sequenceFlow id="delivery-note" sourceRef="after-delivery" targetRef="delivery"><conditionExpression xsi:type="tFormalExpression">=delivery-result.route = "delivery"</conditionExpression></sequenceFlow>
    <sequenceFlow id="delivery-progress" sourceRef="after-delivery" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=delivery-result.route = "progress"</conditionExpression></sequenceFlow>
    <sequenceFlow id="delivery-merge" sourceRef="after-delivery" targetRef="merge" />
    <serviceTask id="kinds" name="项目部署与发布选项" coda:action="workflow-kinds">
      <extensionElements><coda:param name="commit" value="=pr.head" /></extensionElements>
    </serviceTask>
    <sequenceFlow id="kinds-approve" sourceRef="kinds" targetRef="approve" />
    <userTask id="approve" name="批准合并" coda:noteLabel="备注（可选）" coda:assignee="user">
      <documentation>{{pr.summary}}

{{if inputs.devices then "设备验收、" else ""}}项目检查、合并前检查、GitHub 检查已通过{{if inputs.reviewer = null and inputs.reviewer2 = null and inputs.reviewer3 = null then "" else "，整条泳道已整体评审"}}。
PR：{{pr.url}}
批准后以合并提交合并（目标分支上这个需求一个提交，泳道里每个泳道 PR 一个提交），随后按勾选依次部署、发布预览版、发布正式版，每类一次；选项只在项目有对应流程时出现，默认不勾。
勾选发布时备注即发布说明，不填由主 Agent 写。「暂不合并」须写明原因，带回需求进行中交给主 Agent 跟进。</documentation>
      <extensionElements>
        <coda:choice id="merge" name="合并" primary="true"><coda:option id="deploy" name="部署" detail="调用项目里的部署流程" coda:shown="=kinds.deploy" />
          <coda:option id="preview" name="发布预览版" detail="调用项目里的预览发布流程" coda:shown="=kinds.preview" />
          <coda:option id="release" name="发布正式版" detail="调用项目里的正式发布流程" coda:shown="=kinds.release" />
          <coda:option id="notify" name="全部完成后通知 Agent" default="true" />
        </coda:choice>
        <coda:choice id="stop" name="暂不合并" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="approve-route" sourceRef="approve" targetRef="approval-result" />
    <scriptTask id="approval-result" name="检查发布说明" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="APPROVAL" value="=approve" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" approval</script>
    </scriptTask>
    <sequenceFlow id="approval-validated" sourceRef="approval-result" targetRef="after-approval" />
    <exclusiveGateway id="after-approval" name="是否合并" default="approval-merge" />
    <sequenceFlow id="approval-missing" sourceRef="after-approval" targetRef="write-notes"><conditionExpression xsi:type="tFormalExpression">=approval-result.route = "notes"</conditionExpression></sequenceFlow>
    <sequenceFlow id="approval-stop" sourceRef="after-approval" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=approval-result.route = "stop"</conditionExpression></sequenceFlow>
    <sequenceFlow id="approval-merge" sourceRef="after-approval" targetRef="merge" />
    <userTask id="write-notes" name="写发布说明" coda:noteLabel="发布说明（必填）">
      <documentation>已勾选发布类别：{{if approve.options.preview then "预览版" else ""}} {{if approve.options.release then "正式版" else ""}}
PR：{{pr.url}}
提交：{{pr.head}}
请主 Agent 按上次公开版本以来合并的改动，写面向用户的发布说明，备注必填。请结合本次批准的改动，不要使用审查意见作为发布说明。
{{if notes-result.feedback = null then "" else notes-result.feedback}}</documentation>
      <extensionElements><coda:choice id="ready" name="说明已写好" primary="true" /></extensionElements>
    </userTask>
    <sequenceFlow id="write-notes-result" sourceRef="write-notes" targetRef="notes-result" />
    <scriptTask id="notes-result" name="记录发布说明" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="NOTES" value="=write-notes" /><coda:output name="route" /><coda:output name="feedback" /><coda:output name="notes" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" notes</script>
    </scriptTask>
    <sequenceFlow id="notes-result-route" sourceRef="notes-result" targetRef="notes-route" />
    <exclusiveGateway id="notes-route" name="发布说明是否填写" default="notes-ready" />
    <sequenceFlow id="notes-missing" sourceRef="notes-route" targetRef="write-notes"><conditionExpression xsi:type="tFormalExpression">=notes-result.route = "notes"</conditionExpression></sequenceFlow>
    <sequenceFlow id="notes-ready" sourceRef="notes-route" targetRef="merge" />
    <scriptTask id="merge" name="合并" scriptFormat="bash" coda:checkout="false" coda:timeout="10">
      <extensionElements><coda:output name="commit" /><coda:output name="route" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/develop.mjs" merge</script>
    </scriptTask>
    <sequenceFlow id="merge-route" sourceRef="merge" targetRef="after-merge" />
    <exclusiveGateway id="after-merge" name="是否合并冲突" default="merge-deploy-choice" />
    <sequenceFlow id="merge-conflict" sourceRef="after-merge" targetRef="resume"><conditionExpression xsi:type="tFormalExpression">=merge.route = "conflict"</conditionExpression></sequenceFlow>
    <sequenceFlow id="merge-deploy-choice" sourceRef="after-merge" targetRef="deploy-choice" />
    <exclusiveGateway id="deploy-choice" name="是否部署" default="merged-preview" />
    <sequenceFlow id="merged-only" sourceRef="deploy-choice" targetRef="done"><conditionExpression xsi:type="tFormalExpression">=inputs.delivery != ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="merged-deploy" sourceRef="deploy-choice" targetRef="deploy"><conditionExpression xsi:type="tFormalExpression">=approve.options.deploy</conditionExpression></sequenceFlow>
    <sequenceFlow id="merged-preview" sourceRef="deploy-choice" targetRef="publish-preview-choice" />
    <serviceTask id="deploy" name="部署" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="deploy" /><coda:param name="commit" value="=merge.commit" /></extensionElements>
    </serviceTask>
    <sequenceFlow id="deployed" sourceRef="deploy" targetRef="publish-preview-choice" />
    <exclusiveGateway id="publish-preview-choice" name="是否发布预览版" default="skip-publish-preview" />
    <sequenceFlow id="to-publish-preview" sourceRef="publish-preview-choice" targetRef="publish-preview"><conditionExpression xsi:type="tFormalExpression">=approve.options.preview</conditionExpression></sequenceFlow>
    <sequenceFlow id="skip-publish-preview" sourceRef="publish-preview-choice" targetRef="publish-release-choice" />
    <serviceTask id="publish-preview" name="发布预览版" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="preview" /><coda:param name="commit" value="=merge.commit" /><coda:param name="inputs" value='={ notes: if approval-result.route = "notes" then notes-result.notes else approve.note }' /></extensionElements>
    </serviceTask>
    <sequenceFlow id="published-preview" sourceRef="publish-preview" targetRef="publish-release-choice" />
    <exclusiveGateway id="publish-release-choice" name="是否发布正式版" default="skip-publish-release" />
    <sequenceFlow id="to-publish-release" sourceRef="publish-release-choice" targetRef="publish-release"><conditionExpression xsi:type="tFormalExpression">=approve.options.release</conditionExpression></sequenceFlow>
    <sequenceFlow id="skip-publish-release" sourceRef="publish-release-choice" targetRef="done" />
    <serviceTask id="publish-release" name="发布正式版" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="release" /><coda:param name="commit" value="=merge.commit" /><coda:param name="inputs" value='={ publish: "true", notes: if approval-result.route = "notes" then notes-result.notes else approve.note }' /></extensionElements>
    </serviceTask>
    <sequenceFlow id="published-release" sourceRef="publish-release" targetRef="done" />
    <endEvent id="done" name="已完成" coda:notify='=if inputs.delivery != "" then true else approve.options.notify'><extensionElements><coda:output name="pr" value="=pr.url" /><coda:output name="commit" value="=merge.commit" /><coda:output name="notify" value='=if inputs.delivery != "" then true else approve.options.notify' /></extensionElements></endEvent>
  </process>
</definitions>
