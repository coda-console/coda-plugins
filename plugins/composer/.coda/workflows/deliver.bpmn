<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:coda="https://coda.pub/schema/bpmn/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="deliver-definitions" targetNamespace="https://coda.pub/plugins/composer">
  <process id="deliver" name="需求交付" isExecutable="true" coda:title='{{if inputs.title = "" then "需求交付" else "交付：" + inputs.title}}'>
    <extensionElements>
      <coda:input name="title" label="需求名" default="" description="留空时由主 Agent 在第一张任务里写" />
      <coda:input name="devices" label="设备验收" type="boolean" default="false" description="改了客户端、要在 Mac 或 iPhone 上统一验收时打开" />
      <coda:input name="device" label="验收设备" type="string" default="" description="测试机设备名，如 duo-testbed；验收期间独占它；留空不占设备" />
    </extensionElements>
    <startEvent id="start" />
    <sequenceFlow id="start-brief" sourceRef="start" targetRef="brief-choice" />
    <!-- 目标是发起时带的需求文字（run.message）。需求名和它都有时直接开始；否则第一张任务交给主 Agent，不叫醒它，随会话的下一条输入告诉它。 -->
    <exclusiveGateway id="brief-choice" name="是否已有目标" default="brief-needed" />
    <sequenceFlow id="brief-needed" sourceRef="brief-choice" targetRef="brief" />
    <sequenceFlow id="brief-given" sourceRef="brief-choice" targetRef="init"><conditionExpression xsi:type="tFormalExpression">=inputs.title != "" and run.message != ""</conditionExpression></sequenceFlow>
    <userTask id="brief" name="写需求" coda:wake="false" coda:noteLabel="第一行需求名，空一行后是目标与完成标准">
      <documentation>用户在这个会话里开启了需求交付：一个需求跨几个仓库，要一起验收、一起批准合并。你是主 Agent，每个仓库开一个需求运行（监督开发），达标后统一交付。
现在把和用户聊定的需求写下来：备注第一行是需求名，空一行后是目标与完成标准。
答复后，为每个要改的仓库在那里用 workflow_run 发起 develop（需求运行）：传 title、message（这个仓库要做的部分与完成标准）、delivery="{{run.id}}"、devices=false，跨仓库用 project；为每个成员选好执行者 executor 和备用执行者 executor2（按各自仓库的工作性质，有执行者名单就从名单选）一并传上。在各需求运行的「需求进行中」里用泳道 PR 把改动合进它的泳道，做完提交验收；成员可以同时进行，各自检查通过后停在「待交付」；全部达标后在本运行的「确认达标」按合并顺序列出成员 PR（各泳道进目标分支的 PR）。
{{if run.message = "" then "" else "发起时带的需求：\n" + run.message + "\n"}}设备验收：{{if inputs.devices then "开启，全部成员集成后统一验收一次" else "未开启"}}{{if inputs.device = "" then "" else "，验收设备 " + inputs.device}}。
{{if brief-result.feedback = null then "" else brief-result.feedback}}</documentation>
      <extensionElements><coda:choice id="start" name="开始拆分" primary="true" note="required" /></extensionElements>
    </userTask>
    <sequenceFlow id="brief-result-flow" sourceRef="brief" targetRef="brief-result" />
    <scriptTask id="brief-result" name="读取需求" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RESPONSE" value="=brief" /><coda:output name="route" /><coda:output name="feedback" /><coda:output name="title" /><coda:output name="goal" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" brief</script>
    </scriptTask>
    <sequenceFlow id="brief-route" sourceRef="brief-result" targetRef="after-brief" />
    <exclusiveGateway id="after-brief" name="需求是否写全" default="brief-init" />
    <sequenceFlow id="brief-again" sourceRef="after-brief" targetRef="brief"><conditionExpression xsi:type="tFormalExpression">=brief-result.route = "brief"</conditionExpression></sequenceFlow>
    <sequenceFlow id="brief-init" sourceRef="after-brief" targetRef="init" />
    <scriptTask id="init" name="准备交付" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="TITLE" value='=if inputs.title != "" and run.message != "" then inputs.title else brief-result.title' />
        <coda:env name="GOAL" value='=if inputs.title != "" and run.message != "" then run.message else brief-result.goal' />
        <coda:output name="title" /><coda:output name="goal" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" init</script>
    </scriptTask>
    <sequenceFlow id="init-context" sourceRef="init" targetRef="context" />
    <scriptTask id="context" name="整理交付反馈" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:output name="feedback" /><coda:output name="members" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" context</script>
    </scriptTask>
    <sequenceFlow id="context-confirm" sourceRef="context" targetRef="confirm" />
    <userTask id="confirm" name="确认达标" coda:noteLabel="成员 PR（每行一个，按合并顺序）">
      <documentation>需求：{{init.title}}
目标与完成标准：{{init.goal}}
主 Agent：本需求运行在交付并部署它的项目中。请确认各仓库的改动达到目标，相关需求运行（develop）均已检查通过并停在「待交付」。
当前成员：
{{context.members}}
待处理反馈：
{{context.feedback}}
如需修改，在相关需求运行的「待交付」上选「退回修改」，备注写具体意见，它回到「需求进行中」；提泳道 PR 修好、重新提交验收并检查通过回到待交付后，再开始交付。
选择「开始交付」时备注必填，每行一个成员 PR URL，按合并顺序排列，被依赖的仓库在前：先合并并发布被钉版本的包，再让钉它的仓库更新版本、通过检查后合并。开启设备验收时重新集成、安装、验收；否则直接写交付汇报。
选择「放弃」结束本次需求运行。各运行由主 Agent 在人工任务里协调。</documentation>
      <extensionElements><coda:choice id="start" name="开始交付" primary="true" /><coda:choice id="stop" name="放弃" /></extensionElements>
    </userTask>
    <sequenceFlow id="confirm-result-flow" sourceRef="confirm" targetRef="confirm-result" />
    <scriptTask id="confirm-result" name="记录成员 PR" scriptFormat="bash" coda:timeout="5" coda:retry="3">
      <extensionElements>
        <coda:env name="RESPONSE" value="=confirm" /><coda:env name="DEVICES" value="=inputs.devices" />
        <coda:output name="route" /><coda:output name="members" /><coda:output name="round" /><coda:output name="commit" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" confirm</script>
    </scriptTask>
    <sequenceFlow id="confirm-route" sourceRef="confirm-result" targetRef="after-confirm" />
    <exclusiveGateway id="after-confirm" name="开始交付还是放弃" default="confirm-integrate" />
    <sequenceFlow id="confirm-note" sourceRef="after-confirm" targetRef="context"><conditionExpression xsi:type="tFormalExpression">=confirm-result.route = "confirm"</conditionExpression></sequenceFlow>
    <sequenceFlow id="confirm-stop" sourceRef="after-confirm" targetRef="stopped"><conditionExpression xsi:type="tFormalExpression">=confirm-result.route = "stop"</conditionExpression></sequenceFlow>
    <sequenceFlow id="confirm-report" sourceRef="after-confirm" targetRef="report"><conditionExpression xsi:type="tFormalExpression">=confirm-result.route = "report"</conditionExpression></sequenceFlow>
    <sequenceFlow id="confirm-integrate" sourceRef="after-confirm" targetRef="integrate" />
    <endEvent id="stopped" name="已放弃" />
    <scriptTask id="integrate" name="集成" scriptFormat="bash" coda:timeout="10">
      <extensionElements><coda:output name="head" /><coda:output name="branch" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" integrate</script>
    </scriptTask>
    <boundaryEvent id="integration-failed" attachedToRef="integrate"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="integration-feedback" sourceRef="integration-failed" targetRef="context" />
    <sequenceFlow id="integrate-preview" sourceRef="integrate" targetRef="acceptance" />
    <subProcess id="acceptance" name="安装与设备验收" coda:optional="true">
      <startEvent id="acceptance-start" />
      <sequenceFlow id="acceptance-enter" sourceRef="acceptance-start" targetRef="device-lock-choice" />
      <exclusiveGateway id="device-lock-choice" name="是否占用验收设备" default="device-lock-skip" />
      <sequenceFlow id="device-lock-needed" sourceRef="device-lock-choice" targetRef="device-resolve"><conditionExpression xsi:type="tFormalExpression">=inputs.devices and inputs.device != ""</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-lock-skip" sourceRef="device-lock-choice" targetRef="preview" />
      <callActivity id="device-resolve" name="解析验收设备" calledElement="resolve-testbed">
        <extensionElements><coda:param name="device" value="=inputs.device" /></extensionElements>
      </callActivity>
      <sequenceFlow id="device-resolved" sourceRef="device-resolve" targetRef="device-lock" />
      <serviceTask id="device-lock" name="等验收设备" coda:action="hold-group" coda:status="等验收设备 {{inputs.device}}">
        <extensionElements>
          <coda:param name="group" value="=device-resolve.group" />
          <coda:param name="capacity" value="1" />
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="device-lock-acquired" sourceRef="device-lock" targetRef="preview" />
      <userTask id="preview" name="安装预览版" coda:noteLabel="安装结果或回到确认的原因">
        <documentation>需求：{{init.title}}
集成分支：{{integrate.branch}}
集成提交：{{integrate.head}}
主 Agent：只装改到的那一端：改了 Mac 用 workflow_run 发起 mac-preview-install，改了 iPhone 发起 ios-preview-install，都传 commit="{{integrate.head}}"。等发起的安装都成功后答「已装好」，不能把发起当作装好。

{{if inputs.device = "" then "" else "发起 ios-preview-install 时还要传 device=\"" + inputs.device + "\"。安装运行会借本段占着的设备，不另排队。"}}
需要处理问题时选「回到确认」，备注必填。
{{if preview-result.feedback = null then "" else preview-result.feedback}}</documentation>
        <extensionElements><coda:choice id="installed" name="已装好" primary="true" /><coda:choice id="confirm" name="回到确认" /></extensionElements>
      </userTask>
      <sequenceFlow id="preview-result-flow" sourceRef="preview" targetRef="preview-result" />
      <scriptTask id="preview-result" name="记录安装意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
        <extensionElements><coda:env name="RESPONSE" value="=preview" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
        <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" preview</script>
      </scriptTask>
      <sequenceFlow id="preview-route" sourceRef="preview-result" targetRef="after-preview" />
      <exclusiveGateway id="after-preview" name="安装结论" default="preview-device" />
      <sequenceFlow id="preview-note" sourceRef="after-preview" targetRef="preview"><conditionExpression xsi:type="tFormalExpression">=preview-result.route = "preview"</conditionExpression></sequenceFlow>
      <sequenceFlow id="preview-confirm" sourceRef="after-preview" targetRef="acceptance-return"><conditionExpression xsi:type="tFormalExpression">=preview-result.route = "confirm"</conditionExpression></sequenceFlow>
      <sequenceFlow id="preview-device" sourceRef="after-preview" targetRef="device" />
      <userTask id="device" name="设备验收" coda:assignee="user" coda:noteLabel="验收意见">
        <documentation>需求：{{init.title}}
目标与完成标准：{{init.goal}}
集成提交：{{integrate.head}}
安装结果：{{preview.note}}
{{if inputs.device = "" then "" else "验收期间设备 " + inputs.device + " 一直被本段占着。"}}
请在设备上验收。选「不行」时写具体意见或附上截图，交回主 Agent 修改，改好后重新安装验收。
{{if device-result.feedback = null then "" else device-result.feedback}}</documentation>
        <extensionElements><coda:choice id="yes" name="通过" primary="true" /><coda:choice id="no" name="不行" note="required" /></extensionElements>
      </userTask>
      <sequenceFlow id="device-result-flow" sourceRef="device" targetRef="device-result" />
      <scriptTask id="device-result" name="记录验收意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
        <extensionElements><coda:env name="RESPONSE" value="=device" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
        <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" device</script>
      </scriptTask>
      <sequenceFlow id="device-route" sourceRef="device-result" targetRef="after-device" />
      <exclusiveGateway id="after-device" name="验收结论" default="device-report" />
      <sequenceFlow id="device-note" sourceRef="after-device" targetRef="device"><conditionExpression xsi:type="tFormalExpression">=device-result.route = "device"</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-confirm" sourceRef="after-device" targetRef="acceptance-return"><conditionExpression xsi:type="tFormalExpression">=device-result.route = "confirm"</conditionExpression></sequenceFlow>
      <sequenceFlow id="device-report" sourceRef="after-device" targetRef="acceptance-passed" />
      <endEvent id="acceptance-return"><extensionElements><coda:output name="route" value="return" /></extensionElements></endEvent>
      <endEvent id="acceptance-passed"><extensionElements><coda:output name="route" value="passed" /></extensionElements></endEvent>
    </subProcess>
    <sequenceFlow id="acceptance-finished" sourceRef="acceptance" targetRef="acceptance-route" />
    <exclusiveGateway id="acceptance-route" name="验收段结论" default="acceptance-continue" />
    <sequenceFlow id="acceptance-back" sourceRef="acceptance-route" targetRef="context"><conditionExpression xsi:type="tFormalExpression">=acceptance.route = "return"</conditionExpression></sequenceFlow>
    <sequenceFlow id="acceptance-continue" sourceRef="acceptance-route" targetRef="report" />
    <userTask id="report" name="写交付汇报" coda:noteLabel="交付汇报正文">
      <documentation>需求：{{init.title}}
目标与完成标准：{{init.goal}}
成员 PR：
{{confirm-result.members}}
设备验收：{{if inputs.devices then "已通过" else "本需求未开启"}}。
主 Agent：备注必填，作为用户批准卡正文。约 15 行以内，使用下面模板；写用户能感知的变化，不放执行者原文、测试数量、文件清单，不贴代码。
交付：&lt;需求名&gt;
交付了什么（用户能感知的变化，3～5 条）
结构变化（模块、协议、数据、流程；没有写「无」；不列文件、不贴代码）
验证（设备验收与检查的结论一行；部署后打算怎样在真实环境验证一行）
需要你知道（风险、没做的、顺带改的、后续；没有就省略）
PR：链接
{{if report-result.feedback = null then "" else report-result.feedback}}</documentation>
      <extensionElements><coda:choice id="ready" name="汇报已写好" primary="true" /></extensionElements>
    </userTask>
    <sequenceFlow id="report-result-flow" sourceRef="report" targetRef="report-result" />
    <scriptTask id="report-result" name="记录交付汇报" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RESPONSE" value="=report" /><coda:output name="route" /><coda:output name="feedback" /><coda:output name="body" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" report</script>
    </scriptTask>
    <sequenceFlow id="report-route" sourceRef="report-result" targetRef="after-report" />
    <exclusiveGateway id="after-report" name="汇报是否填写" default="report-joiners" />
    <sequenceFlow id="report-note" sourceRef="after-report" targetRef="report"><conditionExpression xsi:type="tFormalExpression">=report-result.route = "report"</conditionExpression></sequenceFlow>
    <sequenceFlow id="report-joiners" sourceRef="after-report" targetRef="joiners" />
    <serviceTask id="joiners" name="合并后的流程" coda:action="hook-joiners">
      <extensionElements><coda:param name="hook" value="merged" /><coda:param name="commit" value="=confirm-result.commit" /></extensionElements>
    </serviceTask>
    <sequenceFlow id="joiners-approve" sourceRef="joiners" targetRef="approve" />
    <userTask id="approve" name="批准交付" coda:assignee="user" coda:noteLabel="备注">
      <documentation>{{report-result.body}}

成员 PR：
{{confirm-result.members}}
{{if approval-result.route = "approval" then approval-result.feedback else ""}}</documentation>
      <extensionElements>
        <coda:choice id="merge" name="批准合并" primary="true"><coda:optionList value="=joiners.list" /></coda:choice>
        <coda:choice id="stop" name="暂不合并" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="approve-result-flow" sourceRef="approve" targetRef="approval-result" />
    <scriptTask id="approval-result" name="记录批准意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="RESPONSE" value="=approve" /><coda:env name="JOINERS" value="=joiners.list" />
        <coda:output name="route" /><coda:output name="feedback" />
        <coda:output name="only" /><coda:output name="picked" /><coda:output name="inputs" /><coda:output name="missing" /><coda:output name="asks" /><coda:output name="needs" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" approval</script>
    </scriptTask>
    <sequenceFlow id="approval-note-route" sourceRef="approval-result" targetRef="approval-note" />
    <exclusiveGateway id="approval-note" name="批准备注是否填写" default="approval-route" />
    <sequenceFlow id="approval-missing" sourceRef="approval-note" targetRef="approve"><conditionExpression xsi:type="tFormalExpression">=approval-result.route = "approval"</conditionExpression></sequenceFlow>
    <sequenceFlow id="approval-route" sourceRef="approval-note" targetRef="after-approval" />
    <exclusiveGateway id="after-approval" name="交付选择" default="approval-release" />
    <sequenceFlow id="approval-confirm" sourceRef="after-approval" targetRef="context"><conditionExpression xsi:type="tFormalExpression">=approval-result.route = "confirm"</conditionExpression></sequenceFlow>
    <sequenceFlow id="approval-release" sourceRef="after-approval" targetRef="release" />
    <userTask id="release" name="放行合并" coda:noteLabel="本项目最后一个合并提交">
      <documentation>需求：{{init.title}}
成员 PR（按合并顺序）：
{{confirm-result.members}}
主 Agent：请在成员需求运行（develop）的「待交付」人工任务里协调，按以下顺序完成：
1. 被依赖的仓库在前：先给提供被钉版本的包的成员选「放行合并」，等合并并发布新版本。
2. 再给钉这些包的仓库成员选「退回修改」，回到它的「需求进行中」，提泳道 PR 更新钉定的包版本；重新提交验收、检查通过并回到待交付。
3. 最后放行依赖方成员，等全部合并完成。
无对应仓库成员时跳过该项。成员运行不运行合并后的流程，本需求在全部合并后运行用户勾选的。
全部合并后答复，备注必填，只写本项目最后一个合并提交；没有本仓库成员时写本项目当前目标分支提交。
{{if merged.feedback = null then "" else merged.feedback}}</documentation>
      <extensionElements><coda:choice id="merged" name="全部已合并" primary="true" /></extensionElements>
    </userTask>
    <sequenceFlow id="release-merged" sourceRef="release" targetRef="merged" />
    <scriptTask id="merged" name="记录合并提交" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RESPONSE" value="=release" /><coda:output name="route" /><coda:output name="feedback" /><coda:output name="commit" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" merged</script>
    </scriptTask>
    <sequenceFlow id="merged-route" sourceRef="merged" targetRef="merged-choice" />
    <!-- 合并后：运行批准卡上勾的流程（挂点 merged 的 only），它们要的文字卡上没写的先交主 Agent 逐项写。 -->
    <exclusiveGateway id="merged-choice" name="是否运行合并后的流程" default="merged-fill-choice" />
    <sequenceFlow id="merged-note" sourceRef="merged-choice" targetRef="release"><conditionExpression xsi:type="tFormalExpression">=merged.route = "merged"</conditionExpression></sequenceFlow>
    <sequenceFlow id="merged-fill-choice" sourceRef="merged-choice" targetRef="fill-choice" />
    <exclusiveGateway id="fill-choice" name="是否有没写的文字" default="fill-skip" />
    <sequenceFlow id="fill-needed" sourceRef="fill-choice" targetRef="fill"><conditionExpression xsi:type="tFormalExpression">=approval-result.missing != ""</conditionExpression></sequenceFlow>
    <sequenceFlow id="fill-skip" sourceRef="fill-choice" targetRef="merged-inputs" />
    <userTask id="fill" name="填写合并后流程要的文字" coda:noteLabel="要填的文字">
      <documentation>用户批准交付时勾的流程要一段文字，批准卡上没有写：
{{split(approval-result.asks, "\n")[loopCounter]}}
需求：{{init.title}}
成员 PR：
{{confirm-result.members}}
主 Agent：按这次交付合并进来的改动写这段面向用户的文字，不用审查意见；备注只放文字本身。
选「这一项这次不跑」（备注可不写）：这段文字不写，要它的流程这次都不跑，其余勾了的照常运行；都不跑了就直接结束。不想发出这段文字、写不出时选它，不要答复 rejected。</documentation>
      <extensionElements><coda:choice id="done" name="已写好" primary="true" note="required" /><coda:choice id="skip" name="这一项这次不跑" /></extensionElements>
      <multiInstanceLoopCharacteristics isSequential="true" coda:inputCollection='=split(approval-result.missing, ",")' coda:inputElement="input" />
    </userTask>
    <sequenceFlow id="fill-inputs" sourceRef="fill" targetRef="merged-inputs" />
    <scriptTask id="merged-inputs" name="整理合并后流程的参数" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="INPUTS" value="=approval-result.inputs" /><coda:env name="MISSING" value="=approval-result.missing" />
        <coda:env name="ASKS" value="=approval-result.asks" /><coda:env name="FILLS" value="=fill" /><coda:env name="NEEDS" value="=approval-result.needs" /><coda:env name="ONLY" value="=approval-result.only" /><coda:env name="JOINERS" value="=joiners.list" />
        <coda:output name="inputs" /><coda:output name="only" /><coda:output name="picked" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" inputs</script>
    </scriptTask>
    <sequenceFlow id="merged-inputs-run" sourceRef="merged-inputs" targetRef="left" />
    <exclusiveGateway id="left" name="还有要跑的合并后流程吗" default="left-run" />
    <sequenceFlow id="left-none" sourceRef="left" targetRef="verify"><conditionExpression xsi:type="tFormalExpression">=merged-inputs.only = "[]"</conditionExpression></sequenceFlow>
    <sequenceFlow id="left-run" sourceRef="left" targetRef="run-merged" />
    <serviceTask id="run-merged" name="合并后的流程" coda:action="run-workflows">
      <extensionElements>
        <coda:param name="hook" value="merged" /><coda:param name="only" value="=merged-inputs.only" />
        <coda:param name="commit" value="=merged.commit" /><coda:param name="inputs" value="=merged-inputs.inputs" />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="run-merged-verify" sourceRef="run-merged" targetRef="verify" />
    <userTask id="verify" name="真实环境验证" coda:noteLabel="验证结论（有问题时必填）">
      <documentation>需求：{{init.title}}
目标与完成标准：{{init.goal}}
本项目合并提交：{{merged.commit}}
{{if merged-inputs.only = "[]" then "没有运行合并后的流程（用户没有勾，或勾了的都选了不跑），请主 Agent 在当前真实环境按目标验证，并在备注说明没有部署造成的未验证部分。" else "已运行合并后的流程：" + merged-inputs.picked + "。请主 Agent 按目标在真实环境走一遍。"}}
选「通过」或「有问题」；有问题时备注必填，写实际问题和未达标之处，结论会通知发起会话。
{{if verify-result.feedback = null then "" else verify-result.feedback}}</documentation>
      <extensionElements><coda:choice id="yes" name="通过" primary="true" /><coda:choice id="no" name="有问题" /></extensionElements>
    </userTask>
    <sequenceFlow id="verify-result-flow" sourceRef="verify" targetRef="verify-result" />
    <scriptTask id="verify-result" name="记录真实环境结论" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RESPONSE" value="=verify" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" verify</script>
    </scriptTask>
    <sequenceFlow id="verify-route" sourceRef="verify-result" targetRef="after-verify" />
    <exclusiveGateway id="after-verify" name="验证意见是否填写" default="verify-tell" />
    <sequenceFlow id="verify-note" sourceRef="after-verify" targetRef="verify"><conditionExpression xsi:type="tFormalExpression">=verify-result.route = "verify"</conditionExpression></sequenceFlow>
    <sequenceFlow id="verify-tell" sourceRef="after-verify" targetRef="tell-result" />
    <serviceTask id="tell-result" name="告诉发起会话验证结论" coda:action="tell-session">
      <extensionElements>
        <coda:param name="key" value='=run.id + ":verified:" + merged.commit' />
        <coda:param name="text" value='="需求「" + init.title + "」：" + (if merged-inputs.only = "[]" then "没有运行合并后的流程，" else "已运行" + merged-inputs.picked + "，") + "真实环境验证" + (if verify.chose.yes then "通过。" else "有问题。") + "\n" + verify.note + "\n提交：" + merged.commit' />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="result-done" sourceRef="tell-result" targetRef="done" />
    <endEvent id="done" name="交付结束"><extensionElements><coda:output name="commit" value="=merged.commit" /><coda:output name="verification" value="=verify.choice" /><coda:output name="note" value="=verify.note" /></extensionElements></endEvent>
  </process>
</definitions>
