<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:coda="https://coda.pub/schema/bpmn/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="deliver-definitions" targetNamespace="https://coda.pub/plugins/composer">
  <process id="deliver" name="需求交付" isExecutable="true" coda:title="交付：{{inputs.title}}">
    <extensionElements>
      <coda:input name="title" label="需求名" required="true" />
      <coda:input name="goal" label="目标与完成标准" required="true" />
      <coda:input name="devices" label="设备验收" type="boolean" required="true" />
    </extensionElements>
    <startEvent id="start" />
    <sequenceFlow id="start-init" sourceRef="start" targetRef="init" />
    <scriptTask id="init" name="准备交付" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="TITLE" value="=inputs.title" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" init</script>
    </scriptTask>
    <sequenceFlow id="init-context" sourceRef="init" targetRef="context" />
    <scriptTask id="context" name="整理交付反馈" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:output name="feedback" /><coda:output name="members" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" context</script>
    </scriptTask>
    <sequenceFlow id="context-confirm" sourceRef="context" targetRef="confirm" />
    <userTask id="confirm" name="确认达标" coda:noteLabel="成员 PR（每行一个，按合并顺序）">
      <documentation>需求：{{inputs.title}}
目标与完成标准：{{inputs.goal}}
主 Agent：本需求运行在交付并部署它的项目中。请确认成员功能达到目标，相关 develop 运行均已检查通过并停在「待交付」。
当前成员：
{{context.members}}
待处理反馈：
{{context.feedback}}
如需修改，在相关 develop 的「待交付」上选「退回修改」，备注写具体意见；执行者改完，重新审查和检查并回到待交付后，再开始交付。
选择「开始交付」时备注必填，每行一个成员 PR URL，按合并顺序排列，被依赖的仓库在前：先合并并发布被钉版本的包，再让钉它的仓库更新版本、通过检查后合并。开启设备验收时重新集成、安装、验收；否则直接写交付汇报。
选择「放弃」结束本次需求运行。各运行由主 Agent 在人工任务里协调。</documentation>
      <extensionElements><coda:choice id="start" name="开始交付" primary="true" /><coda:choice id="stop" name="放弃" /></extensionElements>
    </userTask>
    <sequenceFlow id="confirm-result-flow" sourceRef="confirm" targetRef="confirm-result" />
    <scriptTask id="confirm-result" name="记录成员 PR" scriptFormat="bash" coda:timeout="5">
      <extensionElements>
        <coda:env name="RESPONSE" value="=confirm" /><coda:env name="DEVICES" value="=inputs.devices" />
        <coda:output name="route" /><coda:output name="members" /><coda:output name="round" /><coda:output name="commit" />
      </extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" confirm</script>
    </scriptTask>
    <sequenceFlow id="confirm-route" sourceRef="confirm-result" targetRef="after-confirm" />
    <exclusiveGateway id="after-confirm" name="开始交付还是放弃" default="confirm-integrate" />
    <sequenceFlow id="confirm-note" sourceRef="after-confirm" targetRef="context"><conditionExpression xsi:type="tFormalExpression">=confirm-result.route = "confirm"</conditionExpression></sequenceFlow>
    <sequenceFlow id="confirm-stop" sourceRef="after-confirm" targetRef="stopped"><conditionExpression xsi:type="tFormalExpression">=confirm-result.route = "stop"</conditionExpression></sequenceFlow>
    <sequenceFlow id="confirm-report" sourceRef="after-confirm" targetRef="report"><conditionExpression xsi:type="tFormalExpression">=confirm-result.route = "report"</conditionExpression></sequenceFlow>
    <sequenceFlow id="confirm-integrate" sourceRef="after-confirm" targetRef="integrate" />
    <endEvent id="stopped" name="已放弃" />
    <scriptTask id="integrate" name="集成" scriptFormat="bash" coda:timeout="10">
      <extensionElements><coda:output name="head" /><coda:output name="branch" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" integrate</script>
    </scriptTask>
    <boundaryEvent id="integration-failed" attachedToRef="integrate"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="integration-feedback" sourceRef="integration-failed" targetRef="context" />
    <sequenceFlow id="integrate-preview" sourceRef="integrate" targetRef="preview" />
    <userTask id="preview" name="安装预览版" coda:noteLabel="安装结果或回到确认的原因">
      <documentation>需求：{{inputs.title}}
集成分支：{{integrate.branch}}
集成提交：{{integrate.head}}
主 Agent：只装改到的那一端：改了 Mac 用 workflow_run 发起 mac-preview-install，改了 iPhone 发起 ios-preview-install，都传 commit="{{integrate.head}}"。等发起的安装都成功后答「已装好」，不能把发起当作装好。
需要处理问题时选「回到确认」，备注必填。
{{if preview-result.feedback = null then "" else preview-result.feedback}}</documentation>
      <extensionElements><coda:choice id="installed" name="已装好" primary="true" /><coda:choice id="confirm" name="回到确认" /></extensionElements>
    </userTask>
    <sequenceFlow id="preview-result-flow" sourceRef="preview" targetRef="preview-result" />
    <scriptTask id="preview-result" name="记录安装意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RESPONSE" value="=preview" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" preview</script>
    </scriptTask>
    <sequenceFlow id="preview-route" sourceRef="preview-result" targetRef="after-preview" />
    <exclusiveGateway id="after-preview" name="安装结论" default="preview-device" />
    <sequenceFlow id="preview-note" sourceRef="after-preview" targetRef="preview"><conditionExpression xsi:type="tFormalExpression">=preview-result.route = "preview"</conditionExpression></sequenceFlow>
    <sequenceFlow id="preview-confirm" sourceRef="after-preview" targetRef="context"><conditionExpression xsi:type="tFormalExpression">=preview-result.route = "confirm"</conditionExpression></sequenceFlow>
    <sequenceFlow id="preview-device" sourceRef="after-preview" targetRef="device" />
    <userTask id="device" name="设备验收" coda:assignee="user" coda:handback="false" coda:noteLabel="验收意见">
      <documentation>需求：{{inputs.title}}
目标与完成标准：{{inputs.goal}}
集成提交：{{integrate.head}}
安装结果：{{preview.note}}
请在设备上验收。选「不行」时备注必填，具体意见交回主 Agent 修改，改好后重新安装验收。
{{if device-result.feedback = null then "" else device-result.feedback}}</documentation>
      <extensionElements><coda:choice id="yes" name="通过" primary="true" /><coda:choice id="no" name="不行" /></extensionElements>
    </userTask>
    <sequenceFlow id="device-result-flow" sourceRef="device" targetRef="device-result" />
    <scriptTask id="device-result" name="记录验收意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RESPONSE" value="=device" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" device</script>
    </scriptTask>
    <sequenceFlow id="device-route" sourceRef="device-result" targetRef="after-device" />
    <exclusiveGateway id="after-device" name="验收结论" default="device-report" />
    <sequenceFlow id="device-note" sourceRef="after-device" targetRef="device"><conditionExpression xsi:type="tFormalExpression">=device-result.route = "device"</conditionExpression></sequenceFlow>
    <sequenceFlow id="device-confirm" sourceRef="after-device" targetRef="context"><conditionExpression xsi:type="tFormalExpression">=device-result.route = "confirm"</conditionExpression></sequenceFlow>
    <sequenceFlow id="device-report" sourceRef="after-device" targetRef="report" />
    <userTask id="report" name="写交付汇报" coda:noteLabel="交付汇报正文">
      <documentation>需求：{{inputs.title}}
目标与完成标准：{{inputs.goal}}
成员 PR：
{{confirm-result.members}}
设备验收：{{if inputs.devices then "已通过" else "本需求未开启"}}。
主 Agent：备注必填，作为用户批准卡正文。约 15 行以内，使用下面模板；写用户能感知的变化，不放执行者原文、测试数量、文件清单，不贴代码。
交付：&lt;需求名&gt;
交付了什么（用户能感知的变化，3～5 条）
结构变化（模块、协议、数据、流程；没有写「无」；不列文件、不贴代码）
验证（设备验收与检查的结论一行；部署后打算怎样在真实环境验证一行）
需要你知道（风险、没做的、顺带改的、后续；没有就省略）
PR：链接
{{if report-result.feedback = null then "" else report-result.feedback}}</documentation>
      <extensionElements><coda:choice id="ready" name="汇报已写好" primary="true" /></extensionElements>
    </userTask>
    <sequenceFlow id="report-result-flow" sourceRef="report" targetRef="report-result" />
    <scriptTask id="report-result" name="记录交付汇报" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RESPONSE" value="=report" /><coda:output name="route" /><coda:output name="feedback" /><coda:output name="body" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" report</script>
    </scriptTask>
    <sequenceFlow id="report-route" sourceRef="report-result" targetRef="after-report" />
    <exclusiveGateway id="after-report" name="汇报是否填写" default="report-kinds" />
    <sequenceFlow id="report-note" sourceRef="after-report" targetRef="report"><conditionExpression xsi:type="tFormalExpression">=report-result.route = "report"</conditionExpression></sequenceFlow>
    <sequenceFlow id="report-kinds" sourceRef="after-report" targetRef="kinds" />
    <serviceTask id="kinds" name="项目部署选项" coda:action="workflow-kinds">
      <extensionElements><coda:param name="commit" value="=confirm-result.commit" /></extensionElements>
    </serviceTask>
    <sequenceFlow id="kinds-approve" sourceRef="kinds" targetRef="approve" />
    <userTask id="approve" name="批准交付" coda:assignee="user" coda:handback="false" coda:noteLabel="暂不合并的原因（必填）">
      <documentation>{{report-result.body}}

成员 PR：
{{confirm-result.members}}
{{if approval-result.route = "approval" then approval-result.feedback else ""}}</documentation>
      <extensionElements>
        <coda:choice id="merge" name="批准合并" primary="true"><coda:option id="deploy" name="部署" detail="全部成员合并后统一部署一次" coda:shown="=kinds.deploy" /></coda:choice>
        <coda:choice id="stop" name="暂不合并" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="approve-result-flow" sourceRef="approve" targetRef="approval-result" />
    <scriptTask id="approval-result" name="记录批准意见" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RESPONSE" value="=approve" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" approval</script>
    </scriptTask>
    <sequenceFlow id="approval-note-route" sourceRef="approval-result" targetRef="approval-note" />
    <exclusiveGateway id="approval-note" name="批准备注是否填写" default="approval-tell" />
    <sequenceFlow id="approval-missing" sourceRef="approval-note" targetRef="approve"><conditionExpression xsi:type="tFormalExpression">=approval-result.route = "approval"</conditionExpression></sequenceFlow>
    <sequenceFlow id="approval-tell" sourceRef="approval-note" targetRef="tell-approval" />
    <serviceTask id="tell-approval" name="告诉主 Agent 交付选择" coda:action="tell-session">
      <extensionElements>
        <coda:param name="key" value='=run.id + ":approve:" + confirm-result.round + ":" + approve.choice + (if approve.options.deploy then ":deploy" else ":no-deploy")' />
        <coda:param name="text" value='="需求「" + inputs.title + "」：用户" + (if approve.chose.stop then "选择暂不合并：" + approve.note else "批准合并，" + (if approve.options.deploy then "已勾选部署。" else "未勾选部署。"))' />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="approval-route" sourceRef="tell-approval" targetRef="after-approval" />
    <exclusiveGateway id="after-approval" name="交付选择" default="approval-release" />
    <sequenceFlow id="approval-confirm" sourceRef="after-approval" targetRef="context"><conditionExpression xsi:type="tFormalExpression">=approval-result.route = "confirm"</conditionExpression></sequenceFlow>
    <sequenceFlow id="approval-release" sourceRef="after-approval" targetRef="release" />
    <userTask id="release" name="放行合并" coda:noteLabel="本项目最后一个合并提交">
      <documentation>需求：{{inputs.title}}
成员 PR（按合并顺序）：
{{confirm-result.members}}
主 Agent：请在成员 develop 运行的「待交付」人工任务里协调，按以下顺序完成：
1. 被依赖的仓库在前：先给提供被钉版本的包的成员选「放行合并」，等合并并发布新版本。
2. 再给钉这些包的仓库成员选「退回修改」，让执行者更新钉定的包版本；重新审查、检查通过并回到待交付。
3. 最后放行依赖方成员，等全部合并完成。
无对应仓库成员时跳过该项。成员运行不部署，本需求在全部合并后按用户勾选统一部署一次。
全部合并后答复，备注必填，只写本项目最后一个合并提交；没有本仓库成员时写本项目当前目标分支提交。
{{if merged.feedback = null then "" else merged.feedback}}</documentation>
      <extensionElements><coda:choice id="merged" name="全部已合并" primary="true" /></extensionElements>
    </userTask>
    <sequenceFlow id="release-merged" sourceRef="release" targetRef="merged" />
    <scriptTask id="merged" name="记录合并提交" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RESPONSE" value="=release" /><coda:output name="route" /><coda:output name="feedback" /><coda:output name="commit" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" merged</script>
    </scriptTask>
    <sequenceFlow id="merged-route" sourceRef="merged" targetRef="deploy-choice" />
    <exclusiveGateway id="deploy-choice" name="是否部署" default="merged-verify" />
    <sequenceFlow id="merged-note" sourceRef="deploy-choice" targetRef="release"><conditionExpression xsi:type="tFormalExpression">=merged.route = "merged"</conditionExpression></sequenceFlow>
    <sequenceFlow id="merged-deploy" sourceRef="deploy-choice" targetRef="deploy"><conditionExpression xsi:type="tFormalExpression">=approve.options.deploy</conditionExpression></sequenceFlow>
    <sequenceFlow id="merged-verify" sourceRef="deploy-choice" targetRef="verify" />
    <serviceTask id="deploy" name="部署" coda:action="run-workflows">
      <extensionElements><coda:param name="kind" value="deploy" /><coda:param name="commit" value="=merged.commit" /></extensionElements>
    </serviceTask>
    <sequenceFlow id="deploy-verify" sourceRef="deploy" targetRef="verify" />
    <userTask id="verify" name="真实环境验证" coda:noteLabel="验证结论（有问题时必填）">
      <documentation>需求：{{inputs.title}}
目标与完成标准：{{inputs.goal}}
本项目合并提交：{{merged.commit}}
{{if approve.options.deploy then "已完成统一部署，请主 Agent 按目标在部署后的真实环境走一遍。" else "用户未勾部署，请主 Agent 在当前真实环境按目标验证，并在备注说明未部署造成的未验证部分。"}}
选「通过」或「有问题」；有问题时备注必填，写实际问题和未达标之处，结论会通知发起会话。
{{if verify-result.feedback = null then "" else verify-result.feedback}}</documentation>
      <extensionElements><coda:choice id="yes" name="通过" primary="true" /><coda:choice id="no" name="有问题" /></extensionElements>
    </userTask>
    <sequenceFlow id="verify-result-flow" sourceRef="verify" targetRef="verify-result" />
    <scriptTask id="verify-result" name="记录真实环境结论" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements><coda:env name="RESPONSE" value="=verify" /><coda:output name="route" /><coda:output name="feedback" /></extensionElements>
      <script>node "${CODA_PLUGIN_PATH}/scripts/deliver.mjs" verify</script>
    </scriptTask>
    <sequenceFlow id="verify-route" sourceRef="verify-result" targetRef="after-verify" />
    <exclusiveGateway id="after-verify" name="验证意见是否填写" default="verify-tell" />
    <sequenceFlow id="verify-note" sourceRef="after-verify" targetRef="verify"><conditionExpression xsi:type="tFormalExpression">=verify-result.route = "verify"</conditionExpression></sequenceFlow>
    <sequenceFlow id="verify-tell" sourceRef="after-verify" targetRef="tell-result" />
    <serviceTask id="tell-result" name="告诉发起会话验证结论" coda:action="tell-session">
      <extensionElements>
        <coda:param name="key" value='=run.id + ":verified:" + merged.commit' />
        <coda:param name="text" value='="需求「" + inputs.title + "」：" + (if approve.options.deploy then "已部署，" else "未部署，") + "真实环境验证" + (if verify.chose.yes then "通过。" else "有问题。") + "\n" + verify.note + "\n提交：" + merged.commit' />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="result-done" sourceRef="tell-result" targetRef="done" />
    <endEvent id="done" name="交付结束"><extensionElements><coda:output name="commit" value="=merged.commit" /><coda:output name="verification" value="=verify.choice" /><coda:output name="note" value="=verify.note" /></extensionElements></endEvent>
  </process>
</definitions>
