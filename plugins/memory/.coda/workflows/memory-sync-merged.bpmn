<?xml version="1.0" encoding="UTF-8"?>
<!-- 合并后同步研究记忆索引（挂点 merged）：合并到主分支后立即增量更新本机索引，不等定时同步；也可以手动发起。
     没有记忆卡片、也没建过索引的项目只写一行跳过的说明。 -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:coda="https://coda.pub/schema/bpmn/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="memory-sync-merged-definitions" targetNamespace="https://coda.pub/plugins/memory">
  <process id="memory-sync-merged" name="合并后同步研究记忆索引" isExecutable="true" coda:title="合并后同步研究记忆索引">
    <extensionElements>
      <coda:join hook="merged" name="同步研究记忆索引" detail="合并到主分支后增量更新本机研究记忆索引" default="false" order="50" />
    </extensionElements>
    <startEvent id="start" />
    <sequenceFlow id="to-projects" sourceRef="start" targetRef="projects" />
    <serviceTask id="projects" name="获取本机项目" coda:action="list-projects" />
    <sequenceFlow id="to-sync" sourceRef="projects" targetRef="sync" />
    <scriptTask id="sync" name="同步研究记忆" coda:checkout="false" coda:timeout="10" coda:status="{{sync.line}}" scriptFormat="bash">
      <extensionElements>
        <coda:env name="MEMORY_PROJECT_ID" value="=projects.here" />
        <coda:env name="MEMORY_PROJECTS_JSON" value="=projects.projects" />
        <coda:env name="MEMORY_DIR" value="=vars.memory.memoryDir" />
        <coda:env name="MEMORY_MNEMON_PATH" value="=vars.memory.mnemonPath" />
        <coda:env name="MEMORY_EMBEDDING_PROVIDER" value="=vars.memory.embeddingProvider" />
        <coda:env name="MEMORY_EMBEDDING_BASE_URL" value="=vars.memory.embeddingBaseUrl" />
        <coda:env name="MEMORY_EMBEDDING_MODEL" value="=vars.memory.embeddingModel" />
        <coda:env name="MEMORY_EMBEDDING_API_KEY_ENV" value="=vars.memory.embeddingApiKeyEnv" />
        <coda:output name="line" />
      </extensionElements>
      <script>node "$CODA_PLUGIN_PATH/scripts/sync-project.mjs"</script>
    </scriptTask>
    <sequenceFlow id="to-end" sourceRef="sync" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
