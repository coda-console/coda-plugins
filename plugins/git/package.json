{
  "name": "@coda-console/git",
  "id": "git",
  "displayName": "Git 源",
  "description": "登记本机 Git 源，提供只读 smart HTTP",
  "icon": { "symbol": "arrow.triangle.branch", "color": "orange" },
  "version": "0.8.0",
  "coda": { "channels": ["preview"] },
  "categories": ["机器与资源"],
  "type": "module",
  "main": "main.mjs",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "protocols": [
      {
        "name": "git/source@1",
        "title": "Git 源",
        "description": "本机 Git 仓库：登记名与工作副本根目录或裸仓库的绝对路径。",
        "spec": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,100}$" },
            "path": { "type": "string", "minLength": 1 }
          },
          "required": ["name", "path"],
          "additionalProperties": false
        },
        "status": {
          "type": "object",
          "properties": {
            "ready": { "type": "boolean" },
            "url": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          },
          "required": [],
          "additionalProperties": false
        },
        "operations": {}
      }
    ],
    "protocolImplementations": ["git/source@1"],
    "skills": ["skills/git-source"]
  },
  "engines": { "node": ">=24" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/git"
  },
  "publishConfig": { "access": "public" },
  "files": ["main.mjs", "lib", "skills"]
}
