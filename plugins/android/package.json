{
  "name": "@coda-console/android",
  "id": "android",
  "displayName": "安卓手机",
  "description": "由安卓手机自己保管一条并发组记录，借出记录设置，归还复原并熄屏",
  "version": "0.4.1",
  "coda": {
    "channels": [
      "preview"
    ]
  },
  "icon": {
    "symbol": "smartphone",
    "color": "green"
  },
  "categories": [
    "机器与资源"
  ],
  "main": "main.mjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "protocolImplementations": [
      "coda/group@1"
    ],
    "configuration": {
      "title": "安卓手机",
      "properties": {
        "android.name": {
          "title": "设备名",
          "type": "string",
          "default": "",
          "description": "组名是 device:<设备名>，不含空白字符；留空使用 ro.product.device。修改后立即生效。"
        },
        "android.address": {
          "title": "adb 地址",
          "type": "string",
          "default": "",
          "description": "留空使用 wlan0 的 IPv4；端口读取 persist.adb.tcp.port。修改后立即生效。"
        },
        "android.machines": {
          "title": "可使用 adb 链路的机器",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "title": "机器 ID"
              }
            },
            "required": [
              "id"
            ]
          },
          "default": [],
          "description": "填写机器 ID；这些机器可排队借用、可使用 adb 链路，留空则不限、不声明链路。adb 公钥须手工授权。修改后立即生效。"
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/android"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "main.mjs",
    "lib"
  ]
}
