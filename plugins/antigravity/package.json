{
  "name": "@coda-console/antigravity",
  "id": "antigravity",
  "displayName": "Antigravity",
  "description": "用 Antigravity CLI 跑会话",
  "version": "1.4.1",
  "engines": {
    "coda": 6
  },
  "categories": ["Agent"],
  "contributes": {
    "agents": [
      {
        "id": "antigravity",
        "displayName": "Antigravity",
        "icon": {
          "light": "icons/antigravity.pdf",
          "template": true
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "工作模式",
          "unset": "Agent 默认",
          "auto": "auto",
          "full": "full",
          "note": "全部放行由插件代答审批，底层跑 default；Auto 对不可逆操作与 MCP 工具仍会询问。其余权限沿用运行机 ~/.gemini/antigravity-cli/settings.json。"
        },
        "skillsDir": ".agents/skills",
        "configFiles": [
          "~/.gemini/antigravity-cli/settings.json"
        ],
        "setupHint": "请在「资源」里为运行机添加 Antigravity。"
      }
    ],
    "protocolImplementations": [
      {
        "kind": "coda/resource@1",
        "commands": {
          "sign-in": "scripts/sign-in.mjs",
          "install": "scripts/setup.mjs"
        }
      }
    ],
    "records": [
      {
        "kind": "coda/resource@1",
        "command": "scripts/resource.mjs"
      }
    ],
    "setup": {
      "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/setup.mjs\""
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/antigravity"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "scripts",
    "icons"
  ]
}
