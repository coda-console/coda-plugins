{
  "name": "@coda-console/testbed",
  "id": "testbed",
  "displayName": "测试机",
  "description": "排队使用 iPhone、iPad 测试机",
  "icon": { "symbol": "iphone", "color": "gray" },
  "version": "1.6.0",
  "categories": [
    "机器与资源"
  ],
  "extensionDependencies": [
    "host"
  ],
  "contributes": {
    "resources": [
      {
        "id": "devices",
        "title": "测试机",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/resources.mjs\""
      }
    ],
    "capabilities": [
      "use-testbed",
      "run-on-device"
    ],
    "extensions": {
      "host/kinds": {
        "command": "\"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/host-sim.mjs\""
      }
    },
    "instructions": "要在 iPhone/iPad 测试机上操作或验证：调用 workflow_run，workflow 为 use-testbed，inputs 给 device（设备名，如 iphone-testbed）和 instructions；先装 App 就再给 app（.app 的绝对路径）。拿到任务后用 host-sim run --kind <设备名> 操作，做完用 workflow_task 答复。",
    "configuration": {
      "title": "测试机",
      "properties": {
        "testbed.blackscreen": {
          "title": "切黑屏命令",
          "type": "object",
          "order": 1,
          "description": "每台测试机用完、交给下一位之前怎么切黑屏。默认用 devicectl 在设备上打开黑屏 App（com.leavan.blackscreen）；某台要换做法就加一行：左边是设备名（归属实例的测试机插件登记的 id），右边是在发起的 Mac 上执行的命令（sh，设备的 UDID 在 $UDID）。失败时请你处理后再交出设备。",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "skills": [
      "skills/testbed"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/testbed"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".coda",
    "scripts",
    "blackscreen",
    "skills",
    "main.mjs"
  ],
  "main": "main.mjs",
  "activationEvents": [
    "onStartupFinished"
  ]
}
