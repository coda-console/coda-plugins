{
  "name": "@coda-console/testbed",
  "id": "testbed",
  "displayName": "测试机",
  "description": "排队使用 iPhone、iPad 与安卓测试机",
  "icon": { "symbol": "iphone", "color": "gray" },
  "version": "3.0.1",
  "coda": {
    "channels": [
      "preview"
    ]
  },
  "categories": [
    "机器与资源"
  ],
  "extensionDependencies": [
    "host"
  ],
  "contributes": {
    "resources": [
      {
        "id": "devices",
        "title": "测试机",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/resources.mjs\""
      }
    ],
    "capabilities": [
      "use-testbed",
      "run-on-device",
      "resolve-testbed"
    ],
    "extensions": {
      "host/kinds": {
        "command": "\"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/host-sim.mjs\""
      }
    },
    "instructions": "用 iPhone/iPad 或安卓测试机：调用 workflow_run，workflow 为 use-testbed，inputs 给 device（设备名）或 select（如 platform=android）和 instructions；要装 App 再给 app（绝对路径）。拿到任务后用 host-sim run --kind <设备名> 操作，做完用 workflow_task 答复。",
    "configuration": {
      "title": "测试机",
      "properties": {
        "testbed.blackscreen": {
          "title": "切黑屏命令",
          "type": "object",
          "order": 1,
          "description": "iPhone、iPad 用完后切黑屏的命令。左边是设备名，右边是发起机器执行的 sh 命令，UDID 在 $UDID。失败时请你处理后再交出设备。",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "skills": [
      "skills/testbed"
    ],
    "protocolImplementations": [
      "coda/group@1"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/testbed"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".coda",
    "scripts",
    "blackscreen",
    "skills",
    "main.mjs"
  ],
  "main": "main.mjs",
  "activationEvents": [
    "onStartupFinished"
  ]
}
