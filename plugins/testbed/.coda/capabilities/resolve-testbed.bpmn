<?xml version="1.0" encoding="UTF-8"?>
<!-- 供流程按设备名解析排队组、平台、本体和 adb 链路；与 use-testbed 共用解析与排队前连接检查。 -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:coda="https://coda.pub/schema/bpmn/1.0" targetNamespace="https://coda.pub/plugins/testbed" id="resolve-testbed-definitions">
  <process id="resolve-testbed" name="解析测试机" isExecutable="true">
    <extensionElements><coda:input name="device" required="true" /></extensionElements>
    <startEvent id="start" />
    <sequenceFlow id="to-find" sourceRef="start" targetRef="find" />
    <scriptTask id="find" name="找测试机" coda:checkout="false" coda:timeout="2" scriptFormat="bash">
      <extensionElements>
        <coda:env name="DEVICE" value="=inputs.device" />
        <coda:output name="group" />
        <coda:output name="platform" />
        <coda:output name="entity" />
        <coda:output name="adb" />
      </extensionElements>
      <script>node "$CODA_PLUGIN_PATH/scripts/device.mjs"</script>
    </scriptTask>
    <sequenceFlow id="found" sourceRef="find" targetRef="end" />
    <endEvent id="end"><extensionElements>
      <coda:output name="group" value="=find.group" />
      <coda:output name="platform" value="=find.platform" />
      <coda:output name="entity" value="=find.entity" />
      <coda:output name="adb" value="=find.adb" />
    </extensionElements></endEvent>
  </process>
</definitions>
