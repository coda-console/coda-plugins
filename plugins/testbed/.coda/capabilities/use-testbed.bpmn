<?xml version="1.0" encoding="UTF-8"?>
<!-- iOS 的黑屏与人工收尾保留；安卓离开占用段后由核心调用保管方归还。 -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:coda="https://coda.pub/schema/bpmn/1.0" id="use-testbed-definitions" targetNamespace="https://coda.pub/plugins/testbed">
  <message id="cancel" name="workflow.cancel" />
  <process id="use-testbed" name="使用测试机" isExecutable="true" coda:title="{{inputs.device}}：{{inputs.task}}">
    <extensionElements>
      <coda:input name="device" required="true" description="设备名：iOS 登记的 id 或共享表中的安卓别名" />
      <coda:input name="instructions" required="true" description="要会话在测试机上做什么、做完怎么答复（写进交给会话的任务）" />
      <coda:input name="task" default="在测试机上验证" description="交给会话的任务名" />
      <coda:input name="app" description="先装到测试机的 App（.app、.ipa 或安卓的 .apk 的绝对路径）；不填就不装" />
    </extensionElements>
    <startEvent id="start" />
    <sequenceFlow id="to-find" sourceRef="start" targetRef="find" />

    <scriptTask id="find" name="找测试机" coda:checkout="false" coda:timeout="2" coda:status="找测试机 {{inputs.device}}" scriptFormat="bash">
      <extensionElements>
        <coda:env name="DEVICE" value="=inputs.device" />
        <coda:output name="group" />
        <coda:output name="entity" />
        <coda:output name="name" />
        <coda:output name="udid" />
        <coda:output name="note" />
        <coda:output name="personal" />
        <coda:output name="platform" />
        <coda:output name="adb" />
      </extensionElements>
      <script>node "$CODA_PLUGIN_PATH/scripts/device.mjs"</script>
    </scriptTask>
    <sequenceFlow id="to-testbed" sourceRef="find" targetRef="testbed" />


    <subProcess id="testbed" name="占用测试机">
      <startEvent id="testbed-start" />
      <sequenceFlow id="to-hold" sourceRef="testbed-start" targetRef="hold" />
      <serviceTask id="hold" name="等测试机" coda:action="hold-group" coda:status="等测试机 {{find.name}}">
        <extensionElements>
          <coda:param name="group" value="=find.group" />
          <coda:param name="capacity" value="1" />

          <coda:param name="borrow" value="no" />
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="to-connect" sourceRef="hold" targetRef="connect" />

      <scriptTask id="connect" name="连接测试机" coda:checkout="false" coda:timeout="2" coda:status="连接 {{find.name}}" scriptFormat="bash">
        <extensionElements>
          <coda:env name="DEVICE" value="=inputs.device" />
          <coda:env name="PLATFORM" value="=find.platform" />
          <coda:env name="ADB" value="=find.adb" />
        </extensionElements>
        <script>node "$CODA_PLUGIN_PATH/scripts/connect.mjs"</script>
      </scriptTask>
      <sequenceFlow id="to-lend" sourceRef="connect" targetRef="lend" />

      <exclusiveGateway id="lend" name="要问你吗" default="no-lend" />
      <sequenceFlow id="to-borrow" sourceRef="lend" targetRef="borrow">
        <conditionExpression xsi:type="tFormalExpression">=find.personal</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="no-lend" sourceRef="lend" targetRef="has-app" />
      <userTask id="borrow" name="借用 {{find.name}}" coda:assignee="user" coda:status="等你答应借出 {{find.name}}" coda:completeLabel="借给它" coda:rejectLabel="现在不行">
        <documentation>有会话要用你的 {{find.name}}（{{inputs.device}}）做「{{inputs.task}}」{{if inputs.app then "，先装上 " + inputs.app else ""}}。借出期间它会操作这台设备，做完答复后还给你。

要做的事：
{{inputs.instructions}}

方便放下设备就选「借给它」；现在不行就选「现在不行」，可以在备注里写什么时候方便，会话会收到。</documentation>
      </userTask>
      <sequenceFlow id="lent" sourceRef="borrow" targetRef="has-app" />
      <exclusiveGateway id="has-app" default="no-app" />
      <sequenceFlow id="with-app" sourceRef="has-app" targetRef="install">
        <conditionExpression xsi:type="tFormalExpression">=inputs.app</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="no-app" sourceRef="has-app" targetRef="task" />
      <scriptTask id="install" name="装 App" coda:checkout="false" coda:timeout="15" coda:status="把 App 装到 {{find.name}}" scriptFormat="bash">
        <extensionElements>
          <coda:env name="UDID" value="=find.udid" />
          <coda:env name="PLATFORM" value="=find.platform" />
          <coda:env name="ADB" value="=find.adb" />
          <coda:env name="APP" value="=inputs.app" />
        </extensionElements>
        <script>if [ "$PLATFORM" = android ]; then adb -s "$ADB" install -r "$APP"; else xcrun devicectl device install app --device "$UDID" "$APP"; fi</script>
      </scriptTask>
      <sequenceFlow id="installed" sourceRef="install" targetRef="task" />
      <userTask id="task" name="=inputs.task" coda:status="{{find.name}} 交给会话使用">
        <documentation>{{inputs.instructions}}

{{if find.platform = "android" then "安卓测试机 " + find.name + "（设备名 " + inputs.device + "，adb 地址 " + find.adb + "）由这个任务占着，直到答复：本会话（含子 Agent）用 host-sim run --kind " + inputs.device + " -- adb shell …（或别的用 adb 的命令，如 frida、scrcpy）操作它，命令里的 ANDROID_SERIAL 已是这台，命令结束不会交出设备。答复之后还在执行的命令随之停下，由保管方归还复原并熄屏；settings 以外的改动在答复里说明。" else "测试机 " + find.name + "（设备名 " + inputs.device + "，UDID " + find.udid + "）由这个任务占着，直到答复：本会话（含子 Agent）用 host-sim run --kind " + inputs.device + " -- &lt;命令&gt; 操作它，命令结束不会交出设备。答复之后还在执行的命令随之停下，" + (if find.personal then "个人设备直接交给下一位。" else "测试机切黑屏，再交给下一位。")}}

{{find.note}}</documentation>
      </userTask>
      <sequenceFlow id="used" sourceRef="task" targetRef="return-device" />


      <boundaryEvent id="borrow-cancelled" attachedToRef="borrow"><messageEventDefinition messageRef="cancel" /></boundaryEvent>
      <boundaryEvent id="borrow-declined" attachedToRef="borrow"><errorEventDefinition /></boundaryEvent>
      <sequenceFlow id="borrow-cancelled-return" sourceRef="borrow-cancelled" targetRef="return-stopped" />
      <sequenceFlow id="borrow-declined-return" sourceRef="borrow-declined" targetRef="return-stopped" />
      <boundaryEvent id="connect-cancelled" attachedToRef="connect"><messageEventDefinition messageRef="cancel" /></boundaryEvent>
      <boundaryEvent id="connect-failed" attachedToRef="connect"><errorEventDefinition /></boundaryEvent>
      <sequenceFlow id="connect-cancelled-black" sourceRef="connect-cancelled" targetRef="return-stopped" />
      <sequenceFlow id="connect-failed-black" sourceRef="connect-failed" targetRef="return-stopped" />
      <boundaryEvent id="install-cancelled" attachedToRef="install"><messageEventDefinition messageRef="cancel" /></boundaryEvent>
      <boundaryEvent id="install-failed" attachedToRef="install"><errorEventDefinition /></boundaryEvent>
      <boundaryEvent id="task-cancelled" attachedToRef="task"><messageEventDefinition messageRef="cancel" /></boundaryEvent>
      <boundaryEvent id="task-failed" attachedToRef="task"><errorEventDefinition /></boundaryEvent>
      <sequenceFlow id="install-cancelled-black" sourceRef="install-cancelled" targetRef="return-stopped" />
      <sequenceFlow id="install-failed-black" sourceRef="install-failed" targetRef="return-stopped" />
      <sequenceFlow id="task-cancelled-black" sourceRef="task-cancelled" targetRef="return-stopped" />
      <sequenceFlow id="task-failed-black" sourceRef="task-failed" targetRef="return-stopped" />

      <exclusiveGateway id="return-device" default="return-device-resident" />
      <sequenceFlow id="return-device-personal" sourceRef="return-device" targetRef="done">
        <conditionExpression xsi:type="tFormalExpression">=find.personal or find.platform = "android"</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="return-device-resident" sourceRef="return-device" targetRef="black" />

      <scriptTask id="black" name="切黑屏" coda:checkout="false" coda:timeout="2" coda:status="{{find.name}} 切黑屏" scriptFormat="bash">
        <extensionElements>
          <coda:env name="DEVICE" value="=inputs.device" />
          <coda:env name="UDID" value="=find.udid" />
          <coda:env name="PLATFORM" value="=find.platform" />
          <coda:env name="ADB" value="=find.adb" />
          <coda:env name="COMMANDS" value="=vars.testbed.blackscreen" />
        </extensionElements>
        <script>node "$CODA_PLUGIN_PATH/scripts/blackscreen.mjs"</script>
      </scriptTask>
      <sequenceFlow id="blacked" sourceRef="black" targetRef="done" />

      <boundaryEvent id="black-cancelled" attachedToRef="black" cancelActivity="false"><messageEventDefinition messageRef="cancel" /></boundaryEvent>
      <sequenceFlow id="black-noted" sourceRef="black-cancelled" targetRef="noted" />
      <endEvent id="noted" />
      <boundaryEvent id="black-failed" attachedToRef="black"><errorEventDefinition /></boundaryEvent>
      <sequenceFlow id="ask-black" sourceRef="black-failed" targetRef="black-trouble" />
      <userTask id="black-trouble" name="测试机切黑屏失败" coda:assignee="user" coda:status="{{find.name}} 切黑屏失败，等你处理">
        <documentation>测试机 {{find.name}}（{{inputs.device}}）用完后没能切黑屏，原因见运行页「切黑屏」这一步的日志。在你处理之前，它不会交给下一位。

检查设备连接、黑屏 App或插件设置「切黑屏命令」后选「重试」；已经手动处理好了就选「我处理好了，放锁」。</documentation>
        <extensionElements>
          <coda:choice id="retry" name="重试" />
          <coda:choice id="release" name="我处理好了，放锁" />
        </extensionElements>
      </userTask>
      <sequenceFlow id="black-answered" sourceRef="black-trouble" targetRef="black-again" />
      <exclusiveGateway id="black-again" default="black-released" />
      <sequenceFlow id="black-retry" sourceRef="black-again" targetRef="black">
        <conditionExpression xsi:type="tFormalExpression">=black-trouble.chose.retry</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="black-released" sourceRef="black-again" targetRef="done" />
      <endEvent id="done">
        <extensionElements><coda:output name="stopped" value="false" /></extensionElements>
      </endEvent>

      <exclusiveGateway id="return-stopped" default="return-stopped-resident" />
      <sequenceFlow id="return-stopped-personal" sourceRef="return-stopped" targetRef="stopped">
        <conditionExpression xsi:type="tFormalExpression">=find.personal or find.platform = "android"</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="return-stopped-resident" sourceRef="return-stopped" targetRef="black-stop" />

      <scriptTask id="black-stop" name="切黑屏（没有做完）" coda:checkout="false" coda:timeout="2" coda:status="{{find.name}} 切黑屏" scriptFormat="bash">
        <extensionElements>
          <coda:env name="DEVICE" value="=inputs.device" />
          <coda:env name="UDID" value="=find.udid" />
          <coda:env name="PLATFORM" value="=find.platform" />
          <coda:env name="ADB" value="=find.adb" />
          <coda:env name="COMMANDS" value="=vars.testbed.blackscreen" />
        </extensionElements>
        <script>node "$CODA_PLUGIN_PATH/scripts/blackscreen.mjs"</script>
      </scriptTask>
      <sequenceFlow id="stop-blacked" sourceRef="black-stop" targetRef="stopped" />
      <boundaryEvent id="black-stop-cancelled" attachedToRef="black-stop" cancelActivity="false"><messageEventDefinition messageRef="cancel" /></boundaryEvent>
      <sequenceFlow id="black-stop-noted" sourceRef="black-stop-cancelled" targetRef="stop-noted" />
      <endEvent id="stop-noted" />
      <boundaryEvent id="black-stop-failed" attachedToRef="black-stop"><errorEventDefinition /></boundaryEvent>
      <sequenceFlow id="ask-black-stop" sourceRef="black-stop-failed" targetRef="black-stop-trouble" />
      <userTask id="black-stop-trouble" name="测试机切黑屏失败" coda:assignee="user" coda:status="{{find.name}} 切黑屏失败，等你处理">
        <documentation>测试机 {{find.name}}（{{inputs.device}}）没能切黑屏，原因见运行页「切黑屏（没有做完）」这一步的日志。在你处理之前，它不会交给下一位。

检查设备连接、黑屏 App或插件设置「切黑屏命令」后选「重试」；已经手动处理好了就选「我处理好了，放锁」。</documentation>
        <extensionElements>
          <coda:choice id="retry" name="重试" />
          <coda:choice id="release" name="我处理好了，放锁" />
        </extensionElements>
      </userTask>
      <sequenceFlow id="black-stop-answered" sourceRef="black-stop-trouble" targetRef="black-stop-again" />
      <exclusiveGateway id="black-stop-again" default="black-stop-released" />
      <sequenceFlow id="black-stop-retry" sourceRef="black-stop-again" targetRef="black-stop">
        <conditionExpression xsi:type="tFormalExpression">=black-stop-trouble.chose.retry</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="black-stop-released" sourceRef="black-stop-again" targetRef="stopped" />
      <endEvent id="stopped">
        <extensionElements><coda:output name="stopped" value="true" /></extensionElements>
      </endEvent>
    </subProcess>


    <sequenceFlow id="to-how" sourceRef="testbed" targetRef="how" />
    <exclusiveGateway id="how" default="to-end" />
    <sequenceFlow id="to-not-done" sourceRef="how" targetRef="not-done">
      <conditionExpression xsi:type="tFormalExpression">=testbed.stopped</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="to-end" sourceRef="how" targetRef="end" />
    <endEvent id="end">
      <extensionElements>
        <coda:output name="result" value="=task.result" />
        <coda:output name="note" value="=task.note" />
        <coda:output name="choice" value="=task.choice" />
      </extensionElements>
    </endEvent>
    <endEvent id="not-done" name="没有做完"><errorEventDefinition /></endEvent>
  </process>
</definitions>
