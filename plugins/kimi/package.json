{
  "name": "@coda-console/kimi",
  "id": "kimi",
  "displayName": "Kimi Code",
  "description": "用 Kimi Code 跑会话",
  "version": "1.4.4",
  "categories": [
    "Agent"
  ],
  "contributes": {
    "agents": [
      {
        "id": "kimi",
        "displayName": "Kimi Code",
        "icon": {
          "light": "icons/kimi-light.pdf",
          "dark": "icons/kimi-dark.pdf"
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "审批模式",
          "unset": "人工审批",
          "auto": "auto",
          "full": "yolo"
        },
        "skillsDir": ".agents/skills",
        "configFiles": [
          "${KIMI_CODE_HOME:-~/.kimi-code}/config.toml"
        ],
        "setupHint": "请在「资源」里为运行机添加 Kimi。"
      }
    ],
    "resources": [
      {
        "id": "account",
        "title": "Kimi",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/resources.mjs\"",
        "maxAge": "PT5M",
        "signIn": {
          "command": "exec sh \"$CODA_PLUGIN_PATH/scripts/login.sh\"",
          "installed": "test -x \"$HOME/.kimi-code/bin/kimi\" || command -v kimi >/dev/null",
          "install": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/setup.mjs\"",
          "note": "登录保存在这台机器的 Kimi CLI 里，由它自己续期。"
        }
      }
    ],
    "setup": {
      "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/setup.mjs\""
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/kimi"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "scripts",
    "icons"
  ]
}
