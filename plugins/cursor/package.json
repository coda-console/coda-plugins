{
  "name": "@coda-console/cursor",
  "id": "cursor",
  "displayName": "Cursor",
  "description": "用 Cursor Agent 跑会话",
  "version": "1.2.0",
  "categories": ["Agent"],
  "contributes": {
    "agents": [
      {
        "id": "cursor",
        "displayName": "Cursor",
        "icon": {
          "light": "icons/cursor.pdf",
          "template": true
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "工作模式",
          "unset": "Agent 默认",
          "note": "工具权限沿用运行机的 Cursor 配置（~/.cursor/cli-config.json）。"
        },
        "skillsDir": ".agents/skills",
        "configFiles": [
          "${CURSOR_CONFIG_DIR:-~/.cursor}/cli-config.json",
          "${CURSOR_CONFIG_DIR:-~/.cursor}/acp-config.json"
        ],
        "setupHint": "请在运行机安装 Cursor CLI（curl https://cursor.com/install -fsS | bash）并运行 cursor-agent login。"
      }
    ],
    "setup": {
      "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/setup.mjs\""
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/cursor"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "scripts",
    "icons"
  ]
}
