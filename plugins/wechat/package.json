{
  "name": "@coda-console/wechat",
  "id": "wechat",
  "displayName": "微信",
  "description": "把手机上的微信群提供为 Coda 的外部会话",
  "icon": { "symbol": "bubble.left.and.bubble.right", "color": "green" },
  "version": "0.2.1",
  "categories": ["机器与资源"],
  "type": "module",
  "main": "main.mjs",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "protocolImplementations": ["coda/session@1"]
  },
  "engines": { "node": ">=24" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/wechat"
  },
  "publishConfig": { "access": "public" },
  "files": ["main.mjs", "lib"]
}
